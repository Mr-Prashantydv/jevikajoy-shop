{%- comment -%}
  Product accordions — native <details>/<summary>, no JS.

  Usage:
    {% render 'product-accordions',
       description: product.description,
       description_title: section.settings.description_title,
       materials: section.settings.materials,
       materials_title: section.settings.materials_title,
       shipping: section.settings.shipping,
       shipping_title: section.settings.shipping_title %}

  Every parameter is optional. Bodies accept HTML (product.description is rich
  text) and fall back to a written default when blank — which is the live path
  today, since product.description is empty on every product.

  ponytail: the three rows are hardcoded, not block-driven. They are the same
  three on every product; make them blocks when a product needs a fourth.

  There WAS a fourth, Size Guide, with its own hardcoded four-row table. It was
  removed: the size guide now renders from snippets/size-guide.liquid beside the
  size picker, where the question is actually asked. Keeping both put two tables
  with two different conventions on one page — the accordion measured chest
  circumference in cm, the new one flat width in inches — and the hardcoded four
  sizes were simply wrong on giggles-tee, which has eight.
{%- endcomment -%}

{%- liquid
  assign pa_description_title = description_title | default: 'Description'
  assign pa_materials_title = materials_title | default: 'Materials & Care'
  assign pa_shipping_title = shipping_title | default: 'Shipping & Returns'

  assign pa_description_text = description | strip_html | strip
  assign pa_materials_text = materials | strip_html | strip
  assign pa_shipping_text = shipping | strip_html | strip
-%}

{%- style -%}
  {%- comment -%}
    White card on the cream canvas, measured off the reference PDP: 20px
    radius, 0 20px padding, rows 20px 0 split by a 2px light-blue rule.
    Colour roles swapped to JJW — the rule is Sky Blue, the type is Navy.
  {%- endcomment -%}
  .product-accordions {
    background: var(--white);
    border-radius: 2rem;
    padding-inline: 2rem;
  }

  .product-accordions__row + .product-accordions__row {
    border-block-start: 2px solid var(--sky);
  }

  .product-accordions__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.3;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .product-accordions__summary::-webkit-details-marker {
    display: none;
  }

  .product-accordions__sign {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--ink-soft);
  }

  .product-accordions__sign::before,
  .product-accordions__sign::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0;
    height: 2px;
    background: currentColor;
    transform: translateY(-50%);
  }

  /* Vertical bar of the +; it rotates flat on open, leaving a −. */
  .product-accordions__sign::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.25s var(--ease);
  }

  .product-accordions__row[open] .product-accordions__sign::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .product-accordions__panel {
    padding-block-end: 2.4rem;
    font-family: var(--font-body);
    font-size: 1.6rem;
    line-height: 1.8;
    color: var(--ink-soft);
    animation: paReveal 0.3s var(--ease) both;
  }

  .product-accordions__panel > :first-child {
    margin-block-start: 0;
  }

  .product-accordions__panel > :last-child {
    margin-block-end: 0;
  }

  .product-accordions__link {
    color: var(--ink);
    font-weight: 700;
    text-decoration: underline;
    text-underline-offset: 0.3em;
  }







  @keyframes paReveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-accordions__panel {
      animation: none;
    }

    .product-accordions__sign::after {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="product-accordions">
  {%- comment -%}
    name= makes the group exclusive natively (one open at a time), matching the
    reference. Browsers without support simply allow several open — no JS needed.
  {%- endcomment -%}
  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_description_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_description_text != blank -%}
        {{ description }}
      {%- else -%}
        <p>A soft everyday tee from Jevika &amp; Joy&rsquo;s World, printed with our own characters and built for playgrounds, art class and everything after.</p>
      {%- endif -%}
    </div>
  </details>

  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_materials_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_materials_text != blank -%}
        {{ materials }}
      {%- else -%}
        <p>100% organic cotton jersey, printed with OEKO-TEX certified inks. Machine wash cold with like colours, tumble dry low, and iron on the reverse. Do not bleach or dry clean.</p>
      {%- endif -%}
    </div>
  </details>

  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_shipping_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_shipping_text != blank -%}
        {{ shipping }}
      {%- else -%}
        <p>Orders are dispatched within 2 business days and usually arrive in 3&ndash;7 days. Unworn items with tags attached can be returned within 7 days of delivery.</p>
      {%- endif -%}
      {%- comment -%}
        Only once the Returns page exists in admin (handle `returns`, template
        page.returns) — until then this would link to a 404.
      {%- endcomment -%}
      {%- assign pa_returns_page = pages['returns'] -%}
      {%- if pa_returns_page != blank -%}
        <p><a class="product-accordions__link" href="{{ pa_returns_page.url }}">How returns and exchanges work</a></p>
      {%- endif -%}
    </div>
  </details>
</div>
