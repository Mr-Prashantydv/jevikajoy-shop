{%- comment -%}
  Product accordions — native <details>/<summary>, no JS.

  Usage:
    {% render 'product-accordions',
       description: product.description,
       description_title: section.settings.description_title,
       materials: section.settings.materials,
       materials_title: section.settings.materials_title,
       size_guide_title: section.settings.size_guide_title,
       size_guide_note: section.settings.size_guide_note,
       shipping: section.settings.shipping,
       shipping_title: section.settings.shipping_title %}

  Every parameter is optional. Bodies accept HTML (product.description is rich
  text) and fall back to a written default when blank — which is the live path
  today, since product.description is empty on every product.

  ponytail: the four rows are hardcoded, not block-driven. They are the same
  four on every product; make them blocks when a product needs a fifth.
{%- endcomment -%}

{%- liquid
  assign pa_description_title = description_title | default: 'Description'
  assign pa_materials_title = materials_title | default: 'Materials & Care'
  assign pa_size_guide_title = size_guide_title | default: 'Size Guide'
  assign pa_shipping_title = shipping_title | default: 'Shipping & Returns'

  assign pa_size_guide_note = size_guide_note | default: 'Measurements are approximate, taken flat in centimetres. Garments may vary by up to 2 cm.'

  assign pa_description_text = description | strip_html | strip
  assign pa_materials_text = materials | strip_html | strip
  assign pa_shipping_text = shipping | strip_html | strip

  assign pa_sizes = '4-5 Y,6-7 Y,8-9 Y,10-12 Y' | split: ','
  assign pa_chest = '62,67,72,78' | split: ','
  assign pa_length = '40,44,48,53' | split: ','
-%}

{%- style -%}
  {%- comment -%}
    White card on the cream canvas, measured off the reference PDP: 20px
    radius, 0 20px padding, rows 20px 0 split by a 2px light-blue rule.
    Colour roles swapped to JJW — the rule is Sky Blue, the type is Navy.
  {%- endcomment -%}
  .product-accordions {
    background: var(--white);
    border-radius: 2rem;
    padding-inline: 2rem;
  }

  .product-accordions__row + .product-accordions__row {
    border-block-start: 2px solid var(--sky);
  }

  .product-accordions__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding-block: 2rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: clamp(1.8rem, 4vw, 2.4rem);
    line-height: 1.3;
    letter-spacing: 0.025em;
    text-transform: uppercase;
    color: var(--ink);
    cursor: pointer;
    list-style: none;
  }

  .product-accordions__summary::-webkit-details-marker {
    display: none;
  }

  .product-accordions__sign {
    position: relative;
    flex: none;
    width: 2rem;
    height: 2rem;
    color: var(--ink-soft);
  }

  .product-accordions__sign::before,
  .product-accordions__sign::after {
    content: '';
    position: absolute;
    inset-block-start: 50%;
    inset-inline: 0;
    height: 2px;
    background: currentColor;
    transform: translateY(-50%);
  }

  /* Vertical bar of the +; it rotates flat on open, leaving a −. */
  .product-accordions__sign::after {
    transform: translateY(-50%) rotate(90deg);
    transition: transform 0.25s var(--ease);
  }

  .product-accordions__row[open] .product-accordions__sign::after {
    transform: translateY(-50%) rotate(0deg);
  }

  .product-accordions__panel {
    padding-block-end: 2.4rem;
    font-family: var(--font-body);
    font-size: 1.6rem;
    line-height: 1.8;
    color: var(--ink-soft);
    animation: paReveal 0.3s var(--ease) both;
  }

  .product-accordions__panel > :first-child {
    margin-block-start: 0;
  }

  .product-accordions__panel > :last-child {
    margin-block-end: 0;
  }

  .product-accordions__table {
    width: 100%;
    max-width: 42rem;
    border-collapse: collapse;
    font-size: 1.5rem;
  }

  .product-accordions__table th,
  .product-accordions__table td {
    padding: 0.8rem 1.2rem 0.8rem 0;
    text-align: start;
    border-block-end: 1px solid rgba(26, 47, 94, 0.16);
  }

  .product-accordions__table thead th {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
  }

  .product-accordions__table tbody th {
    font-family: var(--font-body);
    font-weight: 700;
    color: var(--ink);
  }

  .product-accordions__table tbody tr:last-child th,
  .product-accordions__table tbody tr:last-child td {
    border-block-end: 0;
  }

  .product-accordions__caption {
    caption-side: bottom;
    padding-block-start: 1.2rem;
    font-size: 1.3rem;
    line-height: 1.6;
    text-align: start;
    color: var(--ink-soft);
  }

  @keyframes paReveal {
    from {
      opacity: 0;
      transform: translateY(-0.4rem);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .product-accordions__panel {
      animation: none;
    }

    .product-accordions__sign::after {
      transition: none;
    }
  }
{%- endstyle -%}

<div class="product-accordions">
  {%- comment -%}
    name= makes the group exclusive natively (one open at a time), matching the
    reference. Browsers without support simply allow several open — no JS needed.
  {%- endcomment -%}
  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_description_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_description_text != blank -%}
        {{ description }}
      {%- else -%}
        <p>A soft everyday tee from Jevika &amp; Joy&rsquo;s World, printed with our own characters and built for playgrounds, art class and everything after.</p>
      {%- endif -%}
    </div>
  </details>

  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_materials_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_materials_text != blank -%}
        {{ materials }}
      {%- else -%}
        <p>100% cotton jersey, pre-shrunk and skin-friendly. Machine wash cold with like colours, tumble dry low, and iron on the reverse. Do not bleach or dry clean.</p>
      {%- endif -%}
    </div>
  </details>

  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_size_guide_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      <table class="product-accordions__table">
        <caption class="product-accordions__caption">{{ pa_size_guide_note }}</caption>
        <thead>
          <tr>
            <th scope="col">Size</th>
            <th scope="col">Chest (cm)</th>
            <th scope="col">Length (cm)</th>
          </tr>
        </thead>
        <tbody>
          {%- for size in pa_sizes -%}
            <tr>
              <th scope="row">{{ size }}</th>
              <td>{{ pa_chest[forloop.index0] }}</td>
              <td>{{ pa_length[forloop.index0] }}</td>
            </tr>
          {%- endfor -%}
        </tbody>
      </table>
    </div>
  </details>

  <details class="product-accordions__row" name="product-accordions-{{ product.id }}">
    <summary class="product-accordions__summary">
      {{ pa_shipping_title }}
      <span class="product-accordions__sign" aria-hidden="true"></span>
    </summary>
    <div class="product-accordions__panel">
      {%- if pa_shipping_text != blank -%}
        {{ shipping }}
      {%- else -%}
        <p>Orders are dispatched within 2 business days and usually arrive in 3&ndash;7 days. Unworn items with tags attached can be returned within 7 days of delivery.</p>
      {%- endif -%}
    </div>
  </details>
</div>
