{%- comment -%}Native disclosures preserve Shopify menu levels without JavaScript.{%- endcomment -%}
<ul class="hdr-nav-list">
  {%- for link in links -%}
    <li>
      {%- if link.links != blank -%}
        <details class="hdr-nav-group"{% if link.child_active %} open{% endif %}>
          <summary>
            <span>{{ link.title | escape }}</span>
            <svg viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="m4 6 4 4 4-4" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
          </summary>
          <div class="hdr-nav-children">
            <a class="hdr-nav-parent" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>{{ view_label | escape }} {{ link.title | escape }}</a>
            {%- render 'header-links', links: link.links, view_label: view_label -%}
          </div>
        </details>
      {%- else -%}
        <a class="hdr-nav-link" href="{{ link.url }}"{% if link.current %} aria-current="page"{% endif %}>
          <span>{{ link.title | escape }}</span>
          <svg viewBox="0 0 20 20" fill="none" aria-hidden="true"><path d="M4 10h12m-5-5 5 5-5 5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </li>
  {%- endfor -%}
</ul>
