{%- comment -%}
  One line-art icon on a 48-unit grid, stroked in currentColor so the caller
  sets the colour (always --ink on a sheet fill). Shared by find-us and
  craft-standard so the two surfaces draw the same marks.

  Usage: {% render 'jjw-icon', name: 'wash' %}
  Names: shield, drop, leaf, star, heart, smile, wash, cloud, needle,
  scissors, sparkle. Anything else draws the smile.
{%- endcomment -%}
<svg class="jjw-icon" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="3.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
  {%- case name -%}
    {%- when 'shield' -%}
      <path d="M24 5 9 10.5v11c0 10 6.4 18 15 21.5 8.6-3.5 15-11.5 15-21.5v-11z"/>
      <path d="m17 24.5 5 5 9.5-10"/>
    {%- when 'drop' -%}
      <path d="M24 5s-12 13.5-12 22.5a12 12 0 0 0 24 0C36 18.5 24 5 24 5z"/>
      <path d="M18.5 29a6 6 0 0 0 5 5"/>
    {%- when 'leaf' -%}
      <path d="M9 39C9 21 19 9 40 8c0 21-12 31-31 31z"/>
      <path d="M9 39 27 21"/>
    {%- when 'star' -%}
      <path d="m24 6 5.3 11.6 12.7 1.4-9.5 8.6 2.7 12.4L24 33.6 12.8 40l2.7-12.4L6 19l12.7-1.4z"/>
    {%- when 'heart' -%}
      <path d="M24 40S7 30 7 18.5A8.5 8.5 0 0 1 24 14a8.5 8.5 0 0 1 17 4.5C41 30 24 40 24 40z"/>
    {%- when 'wash' -%}
      <rect x="8" y="5" width="32" height="38" rx="5"/>
      <path d="M8 13h32M14 9h.01M19 9h.01"/>
      <circle cx="24" cy="28" r="9"/>
      <path d="M16.5 29c2.5-2 5 2 7.5 0s5 2 7.5 0"/>
    {%- when 'cloud' -%}
      <path d="M14 37h21a8.5 8.5 0 0 0 .8-17A11.5 11.5 0 0 0 14 17.5 9.75 9.75 0 0 0 14 37z"/>
    {%- when 'needle' -%}
      <path d="M8 40 36 12"/>
      <path d="m33 11 4 4"/>
      <path d="M38 11c6 7-3 12-10 14s-14 5-11 13"/>
    {%- when 'scissors' -%}
      <circle cx="13" cy="14" r="5.5"/>
      <circle cx="13" cy="34" r="5.5"/>
      <path d="M17.5 17.5 41 36M17.5 30.5 41 12"/>
    {%- when 'sparkle' -%}
      <path d="M22 6c1.6 9.4 4.6 12.4 14 14-9.4 1.6-12.4 4.6-14 14-1.6-9.4-4.6-12.4-14-14 9.4-1.6 12.4-4.6 14-14z"/>
      <path d="M38 30v8M34 34h8"/>
    {%- else -%}
      <circle cx="24" cy="24" r="17"/>
      <path d="M17 28a8.5 8.5 0 0 0 14 0"/>
      <path d="M18.5 19.5v1M29.5 19.5v1"/>
  {%- endcase -%}
</svg>
