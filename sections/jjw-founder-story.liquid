{%- comment -%}
  JJW founder story — mirrors Partake's `split-content` section.
  Rounded colour panel (scheme-3 by default), align-items: flex-end, image block
  with up to 2 badge overlays on one side, hxxl heading + body + button--wrapper
  CTA on the other. Image vs. content side is configurable.
  Reference: docs/clone/DESIGN-SYSTEM.md §9 row "split-content", ASSET-MANIFEST.md slot 7b.
{%- endcomment -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWFounderStory-{{ section.id }} .jjw-split-panel {
    border-radius: 20px;
    padding: clamp(28px, 4vw, 56px);
  }

  #JJWFounderStory-{{ section.id }} .jjw-split {
    display: grid;
    grid-template-columns: 1fr;
    gap: 32px;
    align-items: flex-end;
  }

  @media screen and (min-width: 990px) {
    #JJWFounderStory-{{ section.id }} .jjw-split {
      grid-template-columns: 1fr 1fr;
      gap: clamp(40px, 5vw, 64px);
    }

    {%- if section.settings.image_position == 'right' -%}
      #JJWFounderStory-{{ section.id }} .jjw-split__img { order: 2; }
      #JJWFounderStory-{{ section.id }} .jjw-split__content { order: 1; }
    {%- endif -%}
  }

  #JJWFounderStory-{{ section.id }} .jjw-split__img,
  #JJWFounderStory-{{ section.id }} .jjw-split__content {
    min-width: 0;
  }

  #JJWFounderStory-{{ section.id }} .jjw-split__img {
    position: relative;
  }

  #JJWFounderStory-{{ section.id }} .jjw-split__img-frame img {
    width: 100%;
    height: auto;
    border-radius: 20px;
    display: block;
  }

  #JJWFounderStory-{{ section.id }} .jjw-split-badge {
    position: absolute;
    top: -6%;
    width: 30%;
    max-width: 140px;
    z-index: 2;
    filter: drop-shadow(0 4px 10px rgba(14, 27, 58, 0.28));
  }

  #JJWFounderStory-{{ section.id }} .jjw-split-badge img {
    width: 100%;
    height: auto;
    display: block;
  }

  #JJWFounderStory-{{ section.id }} .jjw-split-badge--1 {
    left: -6%;
    transform: rotate(-8deg);
  }

  #JJWFounderStory-{{ section.id }} .jjw-split-badge--2 {
    right: -6%;
    top: -2%;
    transform: rotate(8deg);
  }

  #JJWFounderStory-{{ section.id }} .hxxl {
    color: rgb(var(--color-foreground));
  }

  #JJWFounderStory-{{ section.id }} .jjw-eyebrow {
    color: rgb(var(--color-foreground));
    opacity: 0.85;
  }

  #JJWFounderStory-{{ section.id }} .jjw-accent {
    font-style: italic;
  }

  #JJWFounderStory-{{ section.id }} .jjw-founder-quote {
    margin: 20px 0 28px;
    padding: 0;
    border: none;
    font-family: var(--jjw-font-sans);
    font-size: 1.0625rem;
    line-height: 1.7;
    color: rgb(var(--color-foreground));
    opacity: 0.92;
    font-style: normal;
  }

  #JJWFounderStory-{{ section.id }} .jjw-founder-quote p {
    margin: 0;
  }

  #JJWFounderStory-{{ section.id }} .jjw-founder-cta {
    margin-top: 24px;
  }

  @media screen and (max-width: 749px) {
    #JJWFounderStory-{{ section.id }} .jjw-split-badge {
      width: 26%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #JJWFounderStory-{{ section.id }} .jjw-split-badge {
      transform: none !important;
    }
  }
{%- endstyle -%}

<section id="JJWFounderStory-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-split-panel color-{{ section.settings.color_scheme }} gradient">
      <div class="jjw-split">
        <div class="jjw-split__img {{ reveal }}">
          <div class="jjw-split__img-frame">
            {%- if section.settings.image != blank -%}
              {{
                section.settings.image
                | image_url: width: 1200
                | image_tag:
                  loading: 'lazy',
                  widths: '375, 550, 750, 1100, 1500',
                  alt: section.settings.image.alt | default: section.settings.heading | escape
              }}
            {%- else -%}
              <img
                src="{{ 'cast-group.jpg' | asset_url }}"
                alt="Jevika &amp; Joy World Founders"
                loading="lazy"
                width="800"
                height="600"
              >
            {%- endif -%}
          </div>

          {%- if section.settings.badge_1_image != blank -%}
            <div class="jjw-split-badge jjw-split-badge--1">
              {{
                section.settings.badge_1_image
                | image_url: width: 300
                | image_tag: loading: 'lazy', alt: section.settings.badge_1_image.alt | default: ''
              }}
            </div>
          {%- endif -%}

          {%- if section.settings.badge_2_image != blank -%}
            <div class="jjw-split-badge jjw-split-badge--2">
              {{
                section.settings.badge_2_image
                | image_url: width: 300
                | image_tag: loading: 'lazy', alt: section.settings.badge_2_image.alt | default: ''
              }}
            </div>
          {%- endif -%}
        </div>

        <div class="jjw-split__content {{ reveal }}">
          {%- if section.settings.eyebrow != blank -%}
            <div class="jjw-eyebrow">{{ section.settings.eyebrow }}</div>
          {%- endif -%}

          <h2 class="hxxl">
            {{ section.settings.heading }}
            {%- if section.settings.heading_accent != blank -%}
              <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
            {%- endif -%}
            {{ section.settings.heading_suffix }}
          </h2>

          {%- if section.settings.quote != blank -%}
            <div class="jjw-founder-quote">
              <p>{{ section.settings.quote }}</p>
            </div>
          {%- endif -%}

          {%- if section.settings.cta_text != blank -%}
            <div class="jjw-founder-cta">
              <div class="button--wrapper">
                <div class="button--bg"></div>
                <a
                  href="{{ section.settings.cta_link | default: routes.root_url }}"
                  class="button button--{{ section.settings.cta_style }}"
                >{{ section.settings.cta_text }}</a>
              </div>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Founder Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Story Image"
    },
    {
      "type": "header",
      "content": "Badge overlays"
    },
    {
      "type": "image_picker",
      "id": "badge_1_image",
      "label": "Badge 1 (top-left)",
      "info": "Square, transparent PNG. Sits at ~30% scale near the top of the story image."
    },
    {
      "type": "image_picker",
      "id": "badge_2_image",
      "label": "Badge 2 (top-right)",
      "info": "Square, transparent PNG. Sits at ~30% scale near the top of the story image."
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "OUR STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made with"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Word",
      "default": "Love,"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix",
      "default": "Backed by Purpose."
    },
    {
      "type": "textarea",
      "id": "quote",
      "label": "Body text",
      "default": "We founded Jevika & Joy's World with a simple dream: to give Indian kids their own original heroes — not borrowed ones — on tees they're proud to wear every day."
    },
    {
      "type": "header",
      "content": "Button"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button Label",
      "default": "Read Our Story"
    },
    {
      "type": "url",
      "id": "cta_link",
      "label": "Button Link"
    },
    {
      "type": "select",
      "id": "cta_style",
      "label": "Button style",
      "options": [
        { "value": "primary", "label": "Primary (pink)" },
        { "value": "secondary", "label": "Secondary (navy)" }
      ],
      "default": "secondary"
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "image_position",
      "label": "Image position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "Panel colour scheme",
      "default": "scheme-3"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Founder Story"
    }
  ]
}
{% endschema %}
