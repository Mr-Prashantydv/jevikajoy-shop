{%- comment -%}
  Find us — modelled on partakefoods.com's "11,000+ Retailers" band.
  Cream page, Mint Green rounded card, big --ink heading with a Star Yellow
  marker on one phrase, a marquee of trust stickers, Star Yellow blob button.
  Marquee mechanics, button and scroll reveal all come from theme.css.

  Measured on the reference (1440 / 375 wide): card radius 40 / 20px,
  marquee row 180 / 100px with marks 140 / 60px tall, 40 / 20px apart, 24s loop.

  Each block is a sticker in the house build: sheet fill, --ink type, die-cut
  white edge, night-navy offset shadow, alternating tilt. Text is always --ink,
  never tinted with its own fill (CLAUDE.md contrast note); the lowest pair,
  ink on Candy Pink, is 4.60:1. Mint is not offered as a fill because the card
  already is mint.

  When an official mark is uploaded the sticker shows it as issued on a white
  face, never recoloured: certification marks (BIS, OEKO-TEX) must appear as
  the certifier supplies them.
{%- endcomment -%}

{%- style -%}
  #FindUs-{{ section.id }} {
    background: var(--cream);
  }

  #FindUs-{{ section.id }} .find-us__card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    overflow: hidden;
    border-radius: 4rem;
    background: var(--mint);
    padding-block: calc(var(--section-space) + 2.8rem) var(--section-space);
    text-align: center;
  }

  #FindUs-{{ section.id }} .find-us__heading {
    margin-top: 0;
    margin-bottom: 0;
    max-width: 110rem;
    padding-inline: 1.5rem;
    color: var(--ink);
  }

  /* Highlighter stroke behind one phrase. clone repeats it on every line
     the phrase wraps onto instead of drawing one strip across the break. */
  #FindUs-{{ section.id }} .find-us__mark {
    padding-inline: 0.12em;
    white-space: nowrap;
    background: linear-gradient(
      transparent 56%,
      var(--yellow) 56%,
      var(--yellow) 90%,
      transparent 90%
    );
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  #FindUs-{{ section.id }} .find-us__nb {
    white-space: nowrap;
  }

  #FindUs-{{ section.id }} .find-us__sub {
    margin-top: 1.8rem;
    max-width: 62rem;
    padding-inline: 2rem;
    font-family: var(--font-body);
    font-size: 2rem;
    font-weight: 500;
    line-height: 1.45;
    color: var(--ink);
  }

  #FindUs-{{ section.id }} .find-us__sub :where(p) {
    margin: 0;
  }

  /* Spark marks either side of the heading, the same three-stroke burst the
     stickers elsewhere carry. Decorative only. */
  #FindUs-{{ section.id }} .find-us__burst {
    position: absolute;
    top: calc(var(--section-space) + 1rem);
    width: 7rem;
    height: 7rem;
    color: var(--ink);
    pointer-events: none;
  }

  #FindUs-{{ section.id }} .find-us__burst--l {
    left: 5%;
    transform: rotate(-12deg);
  }

  #FindUs-{{ section.id }} .find-us__burst--r {
    right: 5%;
    transform: scaleX(-1) rotate(-12deg);
  }

  /* Faded edges so stickers slide in and out of the card rather than being
     cut off flat at its padding. */
  #FindUs-{{ section.id }} .find-us__marquee {
    margin-top: 2.4rem;
    width: 100%;
    overflow: hidden;
    -webkit-mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
    mask-image: linear-gradient(90deg, transparent, #000 7%, #000 93%, transparent);
  }

  #FindUs-{{ section.id }} .marquee__group {
    gap: 4.8rem;
    padding-right: 4.8rem;
  }

  /* Vertical room for the tilt, the die-cut edge and the offset shadow. */
  #FindUs-{{ section.id }} .find-us__item {
    flex-shrink: 0;
    padding: 3rem 1.2rem 3.4rem 0.6rem;
  }

  #FindUs-{{ section.id }} .find-us__sticker {
    display: flex;
    align-items: center;
    gap: 1.8rem;
    box-sizing: border-box;
    height: 12rem;
    padding: 1.6rem 3.2rem 1.6rem 1.6rem;
    border-radius: 2.4rem;
    background: var(--fill, var(--white));
    color: var(--ink);
    text-align: left;
    box-shadow:
      0 0 0 0.5rem var(--white),
      0.9rem 0.9rem 0 0.5rem var(--ink-deep);
    transform: rotate(var(--tilt, -3deg));
    transition: transform 0.25s var(--ease-out-slow, ease);
  }

  #FindUs-{{ section.id }} .find-us__item:nth-child(even) .find-us__sticker {
    --tilt: 2.5deg;
  }

  #FindUs-{{ section.id }} .find-us__item:hover .find-us__sticker {
    transform: rotate(0deg) scale(1.05);
  }

  #FindUs-{{ section.id }} .find-us__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    width: 8.8rem;
    height: 8.8rem;
    border-radius: 50%;
    background: var(--white);
  }

  #FindUs-{{ section.id }} .find-us__sticker--white .find-us__icon {
    background: var(--cream);
  }

  #FindUs-{{ section.id }} .find-us__icon svg {
    width: 5rem;
    height: 5rem;
  }

  #FindUs-{{ section.id }} .find-us__words {
    display: flex;
    flex-direction: column;
    white-space: nowrap;
  }

  #FindUs-{{ section.id }} .find-us__big {
    font-family: var(--font-heading);
    font-size: 4.8rem;
    font-weight: 800;
    line-height: 1;
  }

  #FindUs-{{ section.id }} .find-us__small {
    margin-top: 0.4rem;
    font-family: var(--font-accent);
    font-size: 1.8rem;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  /* An official mark replaces the icon and words, on a white face. */
  #FindUs-{{ section.id }} .find-us__sticker--mark {
    --fill: var(--white);
    padding: 1.4rem 2.4rem;
  }

  #FindUs-{{ section.id }} .find-us__sticker--mark img {
    display: block;
    height: 100%;
    width: auto;
    max-width: 26rem;
    object-fit: contain;
  }

  #FindUs-{{ section.id }} .find-us__button {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.6rem 3.2rem;
    margin-top: 2.4rem;
  }

  #FindUs-{{ section.id }} .find-us__button .btn--primary {
    --btn-bg: var(--gold);
    --btn-fg: var(--ink-deep);
  }

  #FindUs-{{ section.id }} .find-us__story {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    min-height: 4.4rem;
    font-family: var(--font-accent);
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    text-decoration-thickness: 0.25rem;
    text-underline-offset: 0.5rem;
  }

  #FindUs-{{ section.id }} .find-us__story:hover {
    text-decoration-color: var(--yellow);
  }

  @media screen and (max-width: 989px) {
    #FindUs-{{ section.id }} .find-us__burst {
      width: 4.8rem;
      height: 4.8rem;
      top: 2rem;
    }

    #FindUs-{{ section.id }} .find-us__burst--l {
      left: 3%;
    }

    #FindUs-{{ section.id }} .find-us__burst--r {
      right: 3%;
    }
  }

  @media screen and (max-width: 749px) {
    #FindUs-{{ section.id }} .find-us__card {
      border-radius: 2rem;
      padding-block: 6.4rem 4rem;
    }

    #FindUs-{{ section.id }} .find-us__burst {
      width: 4rem;
      height: 4rem;
      top: 1.4rem;
    }

    #FindUs-{{ section.id }} .find-us__sub {
      margin-top: 1.4rem;
      font-size: 1.6rem;
    }

    #FindUs-{{ section.id }} .find-us__marquee {
      margin-top: 1.2rem;
    }

    #FindUs-{{ section.id }} .marquee__group {
      gap: 2.6rem;
      padding-right: 2.6rem;
    }

    #FindUs-{{ section.id }} .find-us__item {
      padding: 2rem 0.8rem 2.4rem 0.4rem;
    }

    #FindUs-{{ section.id }} .find-us__sticker {
      gap: 1rem;
      height: 7.2rem;
      padding: 1rem 1.8rem 1rem 1rem;
      border-radius: 1.6rem;
      box-shadow:
        0 0 0 0.35rem var(--white),
        0.6rem 0.6rem 0 0.35rem var(--ink-deep);
    }

    #FindUs-{{ section.id }} .find-us__icon {
      width: 5.2rem;
      height: 5.2rem;
    }

    #FindUs-{{ section.id }} .find-us__icon svg {
      width: 3rem;
      height: 3rem;
    }

    #FindUs-{{ section.id }} .find-us__big {
      font-size: 2.8rem;
    }

    #FindUs-{{ section.id }} .find-us__small {
      font-size: 1.2rem;
      letter-spacing: 0.06em;
    }

    #FindUs-{{ section.id }} .find-us__sticker--mark {
      padding: 0.8rem 1.4rem;
    }

    #FindUs-{{ section.id }} .find-us__sticker--mark img {
      max-width: 16rem;
    }

    #FindUs-{{ section.id }} .find-us__button {
      margin-top: 1.6rem;
    }
  }
{%- endstyle -%}

{%- liquid
  assign heading = section.settings.heading | escape
  assign highlight = section.settings.heading_highlight | escape

  comment
    Keep hyphenated words whole: browsers break after a hard hyphen, which
    split Pre-Shrunk across two lines at 1440px. Done before the highlight
    so the marker markup is never split on its spaces.
  endcomment
  assign words = heading | split: ' '
  assign heading = ''
  for word in words
    assign piece = word
    if word contains '-'
      assign piece = '<span class="find-us__nb">' | append: word | append: '</span>'
    endif
    unless forloop.first
      assign heading = heading | append: ' '
    endunless
    assign heading = heading | append: piece
  endfor

  if highlight != blank and heading contains highlight
    assign marked = '<span class="find-us__mark">' | append: highlight | append: '</span>'
    assign heading = heading | replace_first: highlight, marked
  endif
-%}

<section id="FindUs-{{ section.id }}">
  <div class="page-width">
    <div class="find-us__card">
      {%- if section.settings.show_bursts -%}
        {%- capture burst -%}
          <svg viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="4.5" stroke-linecap="round" aria-hidden="true" focusable="false">
            <path d="M24 6v10M8 16l7.5 6.5M40 16l-7.5 6.5"/>
          </svg>
        {%- endcapture -%}
        <span class="find-us__burst find-us__burst--l">{{ burst }}</span>
        <span class="find-us__burst find-us__burst--r">{{ burst }}</span>
      {%- endif -%}

      {%- if heading != blank -%}
        <h2 class="hxxl find-us__heading scroll-trigger animate--slide-in">
          {{ heading }}
        </h2>
      {%- endif -%}

      {%- if section.settings.subheading != blank -%}
        <div class="find-us__sub scroll-trigger animate--slide-in" style="--animation-order: 1;">
          {{ section.settings.subheading }}
        </div>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="find-us__marquee">
          <div class="marquee">
            <div class="marquee__track">
              {%- comment -%}
                Six copies: the shared -50% keyframe needs an even number of
                groups, and half the track must outrun a wide card even with
                only three stickers. Copies after the first are hidden from
                assistive tech so each claim is announced once.
              {%- endcomment -%}
              {%- for copy in (1..6) -%}
                <div
                  class="marquee__group"
                  {% unless forloop.first %}
                    aria-hidden="true"
                  {% endunless %}
                >
                  {%- for block in section.blocks -%}
                    {%- liquid
                      case block.settings.fill
                        when 'yellow'
                          assign fill = 'var(--yellow)'
                        when 'sky'
                          assign fill = 'var(--sky)'
                        when 'candy'
                          assign fill = 'var(--candy)'
                        when 'lavender'
                          assign fill = 'var(--lavender)'
                        else
                          assign fill = 'var(--white)'
                      endcase
                      assign alt = block.settings.label | append: ' ' | append: block.settings.caption | strip
                    -%}
                    <div class="find-us__item" {{ block.shopify_attributes }}>
                      {%- if block.settings.logo != blank -%}
                        <div class="find-us__sticker find-us__sticker--mark">
                          {{
                            block.settings.logo
                            | image_url: width: 600
                            | image_tag:
                              loading: 'lazy',
                              widths: '150, 300, 450, 600',
                              sizes: '(max-width: 749px) 160px, 260px',
                              alt: alt
                          }}
                        </div>
                      {%- else -%}
                        <div
                          class="find-us__sticker{% if block.settings.fill == 'white' %} find-us__sticker--white{% endif %}"
                          style="--fill: {{ fill }};"
                        >
                          {%- if block.settings.icon != 'none' -%}
                            <span class="find-us__icon" aria-hidden="true">
                              {%- render 'jjw-icon', name: block.settings.icon -%}
                            </span>
                          {%- endif -%}
                          <span class="find-us__words">
                            {%- if block.settings.label != blank -%}
                              <span class="find-us__big">{{ block.settings.label }}</span>
                            {%- endif -%}
                            {%- if block.settings.caption != blank -%}
                              <span class="find-us__small">{{ block.settings.caption }}</span>
                            {%- endif -%}
                          </span>
                        </div>
                      {%- endif -%}
                    </div>
                  {%- endfor -%}
                </div>
              {%- endfor -%}
            </div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%}
        The story link appears only once a page with that handle exists, so
        the band never links to a 404 while the page is still being set up.
      {%- endcomment -%}
      {%- liquid
        assign story_page = blank
        if section.settings.story_handle != blank and section.settings.story_label != blank
          assign story_page = pages[section.settings.story_handle]
        endif
      -%}
      {%- if section.settings.button_label != blank or story_page.id != blank -%}
        <div class="find-us__button scroll-trigger animate--slide-in" style="--animation-order: 2;">
          {%- if section.settings.button_label != blank -%}
            <div class="btn-wrap">
              <span class="btn-shadow" aria-hidden="true"></span>
              <a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
                {{ section.settings.button_label }}
              </a>
            </div>
          {%- endif -%}
          {%- if story_page.id != blank -%}
            <a class="find-us__story" href="{{ story_page.url }}">{{ section.settings.story_label }}</a>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Find us",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to a Standard You Can Check"
    },
    {
      "type": "text",
      "id": "heading_highlight",
      "label": "Highlighted phrase",
      "info": "Part of the heading to underline in yellow. Must match the heading exactly.",
      "default": "You Can Check"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting line"
    },
    {
      "type": "checkbox",
      "id": "show_bursts",
      "label": "Show spark marks beside the heading",
      "default": true
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Tees"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to all products."
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Story link label",
      "default": "See how it's made"
    },
    {
      "type": "text",
      "id": "story_handle",
      "label": "Story page handle",
      "info": "The link shows only once a page with this handle exists in Online Store > Pages.",
      "default": "how-its-made"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Trust sticker",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Big text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Small text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "drop", "label": "Drop" },
            { "value": "leaf", "label": "Leaf" },
            { "value": "star", "label": "Star" },
            { "value": "heart", "label": "Heart" },
            { "value": "smile", "label": "Smile" },
            { "value": "wash", "label": "Washing machine" },
            { "value": "cloud", "label": "Cloud (soft)" },
            { "value": "needle", "label": "Needle and thread" },
            { "value": "scissors", "label": "Scissors" },
            { "value": "sparkle", "label": "Sparkle" },
            { "value": "none", "label": "None" }
          ]
        },
        {
          "type": "select",
          "id": "fill",
          "label": "Sticker colour",
          "default": "white",
          "options": [
            { "value": "white", "label": "Pure White" },
            { "value": "yellow", "label": "Star Yellow" },
            { "value": "sky", "label": "Sky Blue" },
            { "value": "candy", "label": "Candy Pink" },
            { "value": "lavender", "label": "Lavender" }
          ]
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Official mark",
          "info": "Optional. Upload the mark exactly as issued by the certifier; it replaces the icon and text on a white sticker."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Find us",
      "blocks": [
        { "type": "logo", "settings": { "label": "BIS", "caption": "Certified", "icon": "shield", "fill": "yellow" } },
        { "type": "logo", "settings": { "label": "OEKO-TEX", "caption": "Certified inks", "icon": "drop", "fill": "sky" } },
        { "type": "logo", "settings": { "label": "100%", "caption": "Organic cotton", "icon": "leaf", "fill": "white" } },
        { "type": "logo", "settings": { "label": "Ages 4-12", "caption": "Sized by age", "icon": "smile", "fill": "lavender" } }
      ]
    }
  ]
}
{% endschema %}
