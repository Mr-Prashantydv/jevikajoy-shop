{%- comment -%}
  A still fabric story with the existing JJW weave and collar photographs.
  The first four merchant blocks are the main details; remaining blocks form
  a compact supporting row. Each claim is rendered once, without a marquee.
  Colours are sheet anchors; --blue-deep is Adventure Blue shaded by 20%.
{%- endcomment -%}

{%- style -%}
  #FindUs-{{ section.id }} {
    background: var(--cream);
    padding: clamp(4rem, 6vw, 8rem) 0;
    scroll-margin-top: 11rem;
  }
  #FindUs-{{ section.id }} .page-width { padding-inline: clamp(2rem, 4vw, 6.4rem); }
  #FindUs-{{ section.id }} .find-us__card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(3.2rem, 6vw, 8rem);
    align-items: center;
  }
  #FindUs-{{ section.id }} .find-us__visual { min-width: 0; margin: 0; }
  #FindUs-{{ section.id }} .find-us__photos { position: relative; padding-right: 2.4rem; padding-bottom: 2.4rem; }
  #FindUs-{{ section.id }} .find-us__photo {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 1.2rem;
  }
  #FindUs-{{ section.id }} .find-us__detail-photo {
    position: absolute;
    width: 40%;
    height: auto;
    aspect-ratio: 1 / 1;
    right: 0;
    bottom: 0;
    object-fit: cover;
    border: 0.8rem solid var(--cream);
    border-radius: 1.2rem;
  }
  #FindUs-{{ section.id }} .find-us__caption {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 0.8rem;
    color: var(--body-ink);
    font: 500 1.4rem/1.5 var(--font-body);
  }
  #FindUs-{{ section.id }} .find-us__caption::before { content: ''; width: 2.4rem; height: 2px; background: var(--gold); }
  #FindUs-{{ section.id }} .find-us__eyebrow {
    margin: 0 0 1.4rem;
    color: var(--body-ink);
    font: 700 1.2rem/1.4 var(--font-body);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  #FindUs-{{ section.id }} .find-us__heading {
    max-width: 17ch;
    margin: 0;
    color: var(--blue-deep);
    font: 600 clamp(3.4rem, 4.2vw, 5.6rem)/1.08 var(--font-heading);
    letter-spacing: -0.025em;
    text-wrap: balance;
  }
  #FindUs-{{ section.id }} .find-us__sub {
    max-width: 46ch;
    margin-top: 1.8rem;
    color: var(--body-ink);
    font: 500 var(--text-base)/1.65 var(--font-body);
  }
  #FindUs-{{ section.id }} .find-us__sub p { margin: 0; }
  #FindUs-{{ section.id }} .find-us__details {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.4rem 2rem;
    margin: 2.8rem 0;
    padding: 2.8rem 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  #FindUs-{{ section.id }} .find-us__item { display: flex; align-items: flex-start; gap: 1.2rem; min-width: 0; }
  #FindUs-{{ section.id }} .find-us__icon {
    display: grid;
    place-items: center;
    flex: none;
    width: 3.8rem;
    height: 3.8rem;
    color: var(--blue-deep);
    background: var(--white);
    border-radius: 50%;
    border-bottom: 3px solid var(--fill, var(--gold));
  }
  #FindUs-{{ section.id }} .find-us__icon svg { width: 2.2rem; height: 2.2rem; }
  #FindUs-{{ section.id }} .find-us__words { display: grid; gap: 0.4rem; min-width: 0; }
  #FindUs-{{ section.id }} .find-us__big { color: var(--body-ink); font: 700 1.6rem/1.3 var(--font-body); }
  #FindUs-{{ section.id }} .find-us__small { color: var(--body-ink); font: 500 1.3rem/1.5 var(--font-body); }
  #FindUs-{{ section.id }} .find-us__mark { display: block; width: auto; max-width: 100%; height: 5.6rem; object-fit: contain; background: var(--white); }
  #FindUs-{{ section.id }} .find-us__button { display: flex; flex-wrap: wrap; align-items: center; gap: 2rem; margin-top: 2.8rem; }
  #FindUs-{{ section.id }} .find-us__story { display: inline-flex; align-items: center; min-height: 4.4rem; color: var(--blue-deep); font: 700 1.5rem/1.4 var(--font-body); text-decoration: underline; text-underline-offset: 0.5rem; }
  #FindUs-{{ section.id }} .find-us__standards {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3.2rem;
    margin: 4rem 0 0;
    padding: 2.4rem 0 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }
  #FindUs-{{ section.id }} .find-us__standards .find-us__item { align-items: center; }
  #FindUs-{{ section.id }} .find-us__standards .find-us__icon { background: transparent; border: 0; width: 2.4rem; }
  #FindUs-{{ section.id }} .find-us__standards .find-us__big { font-size: 1.4rem; }
  #FindUs-{{ section.id }} .find-us__standards .find-us__small { font-size: 1.2rem; }
  @media screen and (max-width: 989px) {
    #FindUs-{{ section.id }} .find-us__card { gap: 3.2rem; }
    #FindUs-{{ section.id }} .find-us__details { gap: 1.8rem 1.2rem; }
    #FindUs-{{ section.id }} .find-us__item { gap: 0.8rem; }
  }
  @media screen and (max-width: 749px) {
    #FindUs-{{ section.id }} .find-us__card { grid-template-columns: minmax(0, 1fr); gap: 2.8rem; }
    #FindUs-{{ section.id }} .find-us__photos { padding-right: 1.6rem; padding-bottom: 1.6rem; }
    #FindUs-{{ section.id }} .find-us__photo { aspect-ratio: 1.35 / 1; }
    #FindUs-{{ section.id }} .find-us__detail-photo { width: 35%; border-width: 0.6rem; }
    #FindUs-{{ section.id }} .find-us__heading { max-width: 18ch; }
    #FindUs-{{ section.id }} .find-us__details { margin-block: 2.4rem; padding-top: 2.4rem; }
    #FindUs-{{ section.id }} .find-us__standards { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 1.8rem 1.2rem; margin-top: 3.2rem; }
  }
  @media screen and (max-width: 359px) {
    #FindUs-{{ section.id }} .find-us__details .find-us__item { flex-direction: column; }
  }
{%- endstyle -%}

{%- capture detail_items -%}
  {%- for block in section.blocks limit: 4 -%}
    {%- render 'fabric-detail', block: block -%}
  {%- endfor -%}
{%- endcapture -%}
<section id="FindUs-{{ section.id }}">
  <div class="page-width">
    <div class="find-us__card">
      <figure class="find-us__visual scroll-trigger animate--slide-in">
        <div class="find-us__photos">
          {%- if section.settings.image != blank -%}
            {{ section.settings.image | image_url: width: 1200 | image_tag: class: 'find-us__photo', widths: '400, 600, 800, 1200', sizes: '(max-width: 749px) 90vw, 45vw', loading: 'lazy', alt: section.settings.image_alt }}
          {%- else -%}
            <img class="find-us__photo" src="{{ 'jjw-fabric-weave.jpg' | asset_url }}" width="1000" height="1000" loading="lazy" alt="{{ section.settings.image_alt | escape }}">
          {%- endif -%}
          {%- if section.settings.detail_image != blank -%}
            {{ section.settings.detail_image | image_url: width: 500 | image_tag: class: 'find-us__detail-photo', widths: '200, 350, 500', sizes: '(max-width: 749px) 32vw, 18vw', loading: 'lazy', alt: section.settings.detail_alt }}
          {%- else -%}
            <img class="find-us__detail-photo" src="{{ 'jjw-fabric-collar.jpg' | asset_url }}" width="1000" height="1000" loading="lazy" alt="{{ section.settings.detail_alt | escape }}">
          {%- endif -%}
        </div>
        {%- if section.settings.image_caption != blank -%}<figcaption class="find-us__caption">{{ section.settings.image_caption | escape }}</figcaption>{%- endif -%}
      </figure>
      <div class="find-us__copy scroll-trigger animate--slide-in">
        {%- if section.settings.eyebrow != blank -%}<p class="find-us__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        {%- if section.settings.heading != blank -%}<h2 class="find-us__heading">{{ section.settings.heading | escape }}</h2>{%- endif -%}
        {%- if section.settings.subheading != blank -%}<div class="find-us__sub">{{ section.settings.subheading }}</div>{%- endif -%}
        {%- if section.blocks.size > 0 -%}<ul class="find-us__details">{{ detail_items }}</ul>{%- endif -%}
        {%- liquid
          assign story_page = blank
          if section.settings.story_handle != blank and section.settings.story_label != blank
            assign story_page = pages[section.settings.story_handle]
          endif
        -%}
        {%- if section.settings.button_label != blank or story_page.id != blank -%}
          <div class="find-us__button">
            {%- if section.settings.button_label != blank -%}
              <span class="btn-wrap"><span class="btn-shadow" aria-hidden="true"></span><a class="btn btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label | escape }}</a></span>
            {%- endif -%}
            {%- if story_page.id != blank -%}<a class="find-us__story" href="{{ story_page.url }}">{{ section.settings.story_label | escape }}</a>{%- endif -%}
          </div>
        {%- endif -%}
      </div>
    </div>
    {%- if section.blocks.size > 4 -%}
      <ul class="find-us__standards">
        {%- for block in section.blocks offset: 4 -%}{%- render 'fabric-detail', block: block -%}{%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Fabric story panel",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Made for everyday adventures"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Fabric photograph"
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Fabric image description",
      "default": "Close-up of soft cotton jersey"
    },
    {
      "type": "image_picker",
      "id": "detail_image",
      "label": "Construction detail photograph"
    },
    {
      "type": "text",
      "id": "detail_alt",
      "label": "Detail image description",
      "default": "Close-up of the ribbed cotton collar"
    },
    {
      "type": "text",
      "id": "image_caption",
      "label": "Photo caption",
      "default": "Softness, up close."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made to a Standard You Can Check"
    },
    {
      "type": "richtext",
      "id": "subheading",
      "label": "Supporting line"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Tees"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link",
      "info": "Leave empty to link to all products."
    },
    {
      "type": "text",
      "id": "story_label",
      "label": "Story link label",
      "default": "See how it's made"
    },
    {
      "type": "text",
      "id": "story_handle",
      "label": "Story page handle",
      "info": "The link shows only once a page with this handle exists in Online Store > Pages.",
      "default": "how-its-made"
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Fabric detail",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Big text"
        },
        {
          "type": "text",
          "id": "caption",
          "label": "Small text"
        },
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            {
              "value": "shield",
              "label": "Shield"
            },
            {
              "value": "drop",
              "label": "Drop"
            },
            {
              "value": "leaf",
              "label": "Leaf"
            },
            {
              "value": "star",
              "label": "Star"
            },
            {
              "value": "heart",
              "label": "Heart"
            },
            {
              "value": "smile",
              "label": "Smile"
            },
            {
              "value": "wash",
              "label": "Washing machine"
            },
            {
              "value": "cloud",
              "label": "Cloud (soft)"
            },
            {
              "value": "needle",
              "label": "Needle and thread"
            },
            {
              "value": "scissors",
              "label": "Scissors"
            },
            {
              "value": "sparkle",
              "label": "Sparkle"
            },
            {
              "value": "none",
              "label": "None"
            }
          ]
        },
        {
          "type": "select",
          "id": "fill",
          "label": "Icon accent colour",
          "default": "white",
          "options": [
            {
              "value": "white",
              "label": "Pure White"
            },
            {
              "value": "yellow",
              "label": "Star Yellow"
            },
            {
              "value": "sky",
              "label": "Sky Blue"
            },
            {
              "value": "candy",
              "label": "Candy Pink"
            },
            {
              "value": "lavender",
              "label": "Lavender"
            }
          ]
        },
        {
          "type": "image_picker",
          "id": "logo",
          "label": "Official mark",
          "info": "Optional. Upload a mark exactly as issued; it replaces the icon and text on a white surface."
        }
      ]
    }
  ],
  "max_blocks": 16,
  "presets": [
    {
      "name": "Find us",
      "blocks": [
        {
          "type": "logo",
          "settings": {
            "label": "BIS",
            "caption": "Certified",
            "icon": "shield",
            "fill": "yellow"
          }
        },
        {
          "type": "logo",
          "settings": {
            "label": "OEKO-TEX",
            "caption": "Certified inks",
            "icon": "drop",
            "fill": "sky"
          }
        },
        {
          "type": "logo",
          "settings": {
            "label": "100%",
            "caption": "Organic cotton",
            "icon": "leaf",
            "fill": "white"
          }
        },
        {
          "type": "logo",
          "settings": {
            "label": "Ages 4-12",
            "caption": "Sized by age",
            "icon": "smile",
            "fill": "lavender"
          }
        }
      ]
    }
  ]
}
{% endschema %}
