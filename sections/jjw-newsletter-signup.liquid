{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWNewsletter-{{ section.id }} .jjw-newsletter__heading {
    font-size: clamp(26px, 3.5vw, 38px);
    margin: 0 0 12px;
    color: var(--jjw-ink) !important;
  }

  #JJWNewsletter-{{ section.id }} .jjw-newsletter__subtitle {
    font-size: clamp(15px, 1.3vw, 18px);
    color: var(--jjw-ink);
    opacity: 0.9;
    max-width: 560px;
    margin: 0 auto;
    line-height: 1.5;
  }

  #JJWNewsletter-{{ section.id }} .jjw-newsletter__microcopy {
    font-size: 0.8125rem;
    color: var(--jjw-ink);
    opacity: 0.75;
    margin-top: 14px;
    margin-bottom: 0;
  }

  #JJWNewsletter-{{ section.id }} .jjw-newsletter__message--success {
    margin-top: 18px;
    font-weight: 700;
    color: var(--jjw-ink);
    font-size: 1.1rem;
  }

  #JJWNewsletter-{{ section.id }} .jjw-newsletter__message--error {
    margin-top: 18px;
    font-weight: 600;
    color: #D32F2F;
    font-size: 0.9375rem;
  }
{%- endstyle -%}

<section id="JJWNewsletter-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-newsletter {{ reveal }}">
      {%- if section.settings.heading != blank -%}
        <h2 class="jjw-newsletter__heading">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}

      {%- if section.settings.subtitle != blank -%}
        <p class="jjw-newsletter__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}

      {% form 'customer', class: 'jjw-newsletter__form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">

        <input
          id="NewsletterEmail-{{ section.id }}"
          type="email"
          name="contact[email]"
          class="jjw-newsletter__input"
          value="{{ form.email }}"
          aria-required="true"
          autocorrect="off"
          autocapitalize="off"
          autocomplete="email"
          placeholder="Enter your email address"
          required
        >

        <button type="submit" class="jjw-btn jjw-btn-primary" name="commit">
          {{ section.settings.button_text | default: 'Join Now' | escape }}
        </button>
      {% endform %}

      {%- if form.posted_successfully? -%}
        <div class="jjw-newsletter__message--success" role="status">
          {{ 'newsletter.success' | t | default: 'Thanks for subscribing!' }}
        </div>
      {%- elsif form.errors -%}
        <div class="jjw-newsletter__message--error" role="alert">
          {{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}
        </div>
      {%- endif -%}

      <p class="jjw-newsletter__microcopy">
        You can unsubscribe at any time.
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Newsletter",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Get 10% Off Your First Order"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Join our list for exclusive drops, new character launches, and special discounts."
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "Join Now"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Newsletter"
    }
  ]
}
{% endschema %}
