{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWFooter-{{ section.id }} .jjw-footer__brand-logo {
    height: 40px;
    width: auto;
    display: block;
    margin-bottom: 18px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__mission {
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 255, 255, 0.75);
    margin: 0 0 16px;
    max-width: 320px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__bottom-links a {
    color: rgba(255, 255, 255, 0.7);
    text-decoration: none;
    transition: color 0.2s ease;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__bottom-links a:hover {
    color: var(--jjw-white);
  }
{%- endstyle -%}

<footer id="JJWFooter-{{ section.id }}" class="jjw-footer section-{{ section.id }}-padding">
  <div class="jjw-footer__grid">
    <!-- Column 1: Brand -->
    <div class="jjw-footer__col jjw-footer__col--brand">
      <img
        src="{{ 'jjw-logo.png' | asset_url }}"
        alt="Jevika &amp; Joy World"
        class="jjw-footer__brand-logo"
        width="160"
        height="40"
        loading="lazy"
      >
      <p class="jjw-footer__mission">
        {{ section.settings.mission_text | default: "Joyful, allergy-friendly stories, organic plushies, and certified safe essentials crafted to spark wonder and screen-free play for kids aged 4–9." | escape }}
      </p>

      {%- if section.settings.show_social -%}
        <div class="jjw-footer__social">
          <a href="{{ settings.social_instagram_link | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
          </a>
          <a href="{{ settings.social_youtube_link | default: 'https://youtube.com' }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
          </a>
          <a href="{{ settings.social_facebook_link | default: 'https://facebook.com' }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
          </a>
        </div>
      {%- endif -%}
    </div>

    <!-- Column 2: Shop -->
    <div class="jjw-footer__col">
      <h3 class="jjw-footer__col-title">Shop</h3>
      <a href="{{ routes.collections_url }}/plushies" class="jjw-footer__link">Plushies</a>
      <a href="{{ routes.collections_url }}/storybooks" class="jjw-footer__link">Storybooks</a>
      <a href="{{ routes.collections_url }}/apparel" class="jjw-footer__link">Apparel</a>
      <a href="{{ routes.collections_url }}/activity-kits" class="jjw-footer__link">Activity Kits</a>
      <a href="{{ routes.collections_url }}/bundles" class="jjw-footer__link">Bundles</a>
      <a href="{{ routes.collections_url }}/gift-cards" class="jjw-footer__link">Gift Cards</a>
    </div>

    <!-- Column 3: About -->
    <div class="jjw-footer__col">
      <h3 class="jjw-footer__col-title">About</h3>
      <a href="/pages/our-story" class="jjw-footer__link">Our Story</a>
      <a href="/pages/the-show" class="jjw-footer__link">The Show</a>
      <a href="/pages/safety" class="jjw-footer__link">Safety Standards</a>
      <a href="/pages/press" class="jjw-footer__link">Press</a>
      <a href="/pages/careers" class="jjw-footer__link">Careers</a>
    </div>

    <!-- Column 4: Help -->
    <div class="jjw-footer__col">
      <h3 class="jjw-footer__col-title">Help</h3>
      <a href="/pages/faq" class="jjw-footer__link">FAQ</a>
      <a href="/pages/shipping-returns" class="jjw-footer__link">Shipping &amp; Returns</a>
      <a href="/pages/contact" class="jjw-footer__link">Contact Us</a>
      <a href="/pages/wholesale" class="jjw-footer__link">Wholesale</a>
    </div>
  </div>

  <!-- Bottom Bar -->
  <div class="jjw-footer__bottom">
    <div class="jjw-footer__copyright">
      &copy; 2026 Jevika &amp; Joy&#39;s World. All rights reserved.
    </div>
    <div class="jjw-footer__bottom-links">
      <a href="/policies/privacy-policy">Privacy Policy</a>
      <span aria-hidden="true">&bull;</span>
      <a href="/policies/terms-of-service">Terms of Service</a>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "JJW Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Statement",
      "default": "Joyful, allergy-friendly stories, organic plushies, and certified safe essentials crafted to spark wonder and screen-free play for kids aged 4–9."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Links",
      "default": true
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Footer"
    }
  ]
}
{% endschema %}
