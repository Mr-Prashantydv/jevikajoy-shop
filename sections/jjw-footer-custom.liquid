{%- comment -%}
  JJW power-footer — mirrors Partake's H529 navy footer row.
  12-col grid of condensed-caps link columns (Dawn's own link_list block/menu
  pattern from sections/footer.liquid, so columns stay merchant-editable via
  Shopify navigation menus) + newsletter signup + small social row + credits.
  Reference: docs/clone/DESIGN-SYSTEM.md §9 row 13.
{%- endcomment -%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWFooter-{{ section.id }} {
    background-color: var(--jjw-ink);
    color: var(--jjw-cream);
  }

  #JJWFooter-{{ section.id }} a {
    color: var(--jjw-cream);
    transition: color 0.2s var(--jjw-ease);
  }

  #JJWFooter-{{ section.id }} a:hover {
    color: var(--jjw-blue-bg);
  }

  /* --- 12-col grid ------------------------------------------------------ */

  #JJWFooter-{{ section.id }} .jjw-footer__grid {
    display: grid;
    grid-template-columns: repeat(12, 1fr);
    gap: 25.6px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__col--brand {
    grid-column: span 12;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__col--links {
    grid-column: span 6;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__col--newsletter {
    grid-column: span 12;
  }

  @media screen and (min-width: 750px) {
    #JJWFooter-{{ section.id }} .jjw-footer__col--brand {
      grid-column: span 4;
    }

    #JJWFooter-{{ section.id }} .jjw-footer__col--links {
      grid-column: span 2;
    }

    #JJWFooter-{{ section.id }} .jjw-footer__col--newsletter {
      grid-column: span 4;
    }
  }

  /* --- Brand column ------------------------------------------------------ */

  #JJWFooter-{{ section.id }} .jjw-footer__brand-logo {
    height: 40px;
    width: auto;
    display: block;
    margin-bottom: 18px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__mission {
    font-family: var(--jjw-font-sans);
    font-size: 0.875rem;
    line-height: 1.6;
    color: rgba(255, 246, 235, 0.75);
    margin: 0;
    max-width: 320px;
  }

  /* --- Link columns ------------------------------------------------------
     Anchor condensed-caps styling already comes free from the sitewide
     `a { font-family: var(--jjw-font-cond); text-transform: uppercase; }`
     rule in jjw-partake.css — only layout + colour live here. */

  #JJWFooter-{{ section.id }} .jjw-footer__col-title {
    font-family: var(--jjw-font-cond);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 0.8125rem;
    color: rgba(255, 246, 235, 0.55);
    margin: 0 0 14px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__link-list {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin: 0;
    padding: 0;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__link {
    font-size: 0.9375rem;
    opacity: 0.9;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__link:hover {
    opacity: 1;
  }

  /* --- Newsletter ---------------------------------------------------------
     Input uses the --jjw-blue focus ring measured off the header search
     pill (docs/clone/DESIGN-SYSTEM.md §6); submit is a small circular
     arrow button in the same blue. */

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-heading {
    font-family: var(--jjw-font-display);
    font-weight: 800;
    font-size: clamp(1.375rem, 2.2vw, 1.75rem);
    line-height: 1.1;
    margin: 0 0 14px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-field {
    position: relative;
    display: block;
    max-width: 340px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-input {
    width: 100%;
    background-color: var(--jjw-cream);
    color: var(--jjw-ink);
    font-family: var(--jjw-font-sans);
    font-size: 0.9375rem;
    border: 2px solid transparent;
    border-radius: 999px;
    padding: 14px 56px 14px 20px;
    transition: border-color 0.2s var(--jjw-ease), box-shadow 0.2s var(--jjw-ease);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-input:focus-visible {
    outline: none;
    border-color: var(--jjw-blue);
    box-shadow: 0 0 0 3px var(--jjw-blue-bg);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-submit {
    position: absolute;
    top: 50%;
    right: 5px;
    transform: translateY(-50%);
    width: 38px;
    height: 38px;
    border: none;
    border-radius: 50%;
    background-color: var(--jjw-blue);
    color: var(--jjw-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s var(--jjw-ease), transform 0.2s var(--jjw-ease);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-submit:hover {
    background-color: var(--jjw-pink);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-submit svg {
    width: 16px;
    height: 16px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__newsletter-message {
    font-family: var(--jjw-font-sans);
    font-size: 0.8125rem;
    margin: 10px 0 0;
    color: rgba(255, 246, 235, 0.75);
  }

  /* --- Social row --------------------------------------------------------- */

  #JJWFooter-{{ section.id }} .jjw-footer__social {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 40px;
    padding-top: 32px;
    border-top: 1px solid rgba(255, 246, 235, 0.15);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__social a {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background-color: rgba(255, 246, 235, 0.1);
    transition: background-color 0.2s var(--jjw-ease), color 0.2s var(--jjw-ease);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__social a:hover {
    background-color: var(--jjw-blue);
    color: var(--jjw-ink);
  }

  /* --- Credits row --------------------------------------------------------- */

  #JJWFooter-{{ section.id }} .jjw-footer__bottom {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    margin-top: 32px;
    padding-top: 24px;
    border-top: 1px solid rgba(255, 246, 235, 0.15);
    font-family: var(--jjw-font-sans);
    font-size: 0.8125rem;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__copyright {
    color: rgba(255, 246, 235, 0.65);
  }

  #JJWFooter-{{ section.id }} .jjw-footer__bottom-links {
    display: flex;
    align-items: center;
    gap: 12px;
  }

  #JJWFooter-{{ section.id }} .jjw-footer__bottom-links a {
    font-family: var(--jjw-font-sans);
    text-transform: none;
    letter-spacing: 0;
    font-size: 0.8125rem;
    color: rgba(255, 246, 235, 0.65);
  }
{%- endstyle -%}

<footer id="JJWFooter-{{ section.id }}" class="jjw-footer section-{{ section.id }}-padding">
  <div class="jjw-footer__top page-width">
    <div class="jjw-footer__grid">
      <!-- Brand column -->
      <div class="jjw-footer__col jjw-footer__col--brand">
        <img
          src="{{ 'jjw-logo.png' | asset_url }}"
          alt="Jevika &amp; Joy World"
          class="jjw-footer__brand-logo"
          width="160"
          height="40"
          loading="lazy"
        >
        <p class="jjw-footer__mission">
          {{ section.settings.mission_text | default: "Original hero tees for kids, ages 4–12. Certified safe, organic cotton, five characters to choose from." | escape }}
        </p>
      </div>

      <!-- Link columns (merchant-editable via blocks) -->
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_list' -%}
          <div class="jjw-footer__col jjw-footer__col--links" {{ block.shopify_attributes }}>
            {%- if block.settings.heading != blank -%}
              <h3 class="jjw-footer__col-title">{{ block.settings.heading | escape }}</h3>
            {%- endif -%}
            {%- if block.settings.menu != blank -%}
              <ul class="jjw-footer__link-list list-unstyled">
                {%- for link in block.settings.menu.links -%}
                  <li>
                    <a href="{{ link.url }}" class="jjw-footer__link">{{ link.title | escape }}</a>
                  </li>
                {%- endfor -%}
              </ul>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}

      <!-- Newsletter -->
      {%- if section.settings.newsletter_enable -%}
        <div class="jjw-footer__col jjw-footer__col--newsletter">
          <h3 class="jjw-footer__newsletter-heading">{{ section.settings.newsletter_heading | escape }}</h3>
          {%- form 'customer', id: 'JJWNewsletterFooter-' | append: section.id, class: 'jjw-footer__newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="jjw-footer__newsletter-field">
              <label class="visually-hidden" for="JJWNewsletterEmail-{{ section.id }}">{{ 'newsletter.label' | t }}</label>
              <input
                id="JJWNewsletterEmail-{{ section.id }}"
                type="email"
                name="contact[email]"
                class="jjw-footer__newsletter-input"
                value="{{ form.email }}"
                aria-required="true"
                autocorrect="off"
                autocapitalize="off"
                autocomplete="email"
                placeholder="{{ 'newsletter.label' | t }}"
                required
              >
              <button
                type="submit"
                class="jjw-footer__newsletter-submit"
                name="commit"
                aria-label="{{ 'newsletter.button_label' | t }}"
              >
                {{- 'icon-arrow.svg' | inline_asset_content -}}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="jjw-footer__newsletter-message">
                {{- form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email -}}
              </p>
            {%- elsif form.posted_successfully? -%}
              <p class="jjw-footer__newsletter-message">{{ 'newsletter.success' | t }}</p>
            {%- endif -%}
          {%- endform -%}
        </div>
      {%- endif -%}
    </div>

    <!-- Social icons -->
    {%- if section.settings.show_social -%}
      <div class="jjw-footer__social">
        <a href="{{ settings.social_instagram_link | default: 'https://instagram.com' }}" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
        </a>
        <a href="{{ settings.social_youtube_link | default: 'https://youtube.com' }}" target="_blank" rel="noopener noreferrer" aria-label="YouTube">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/></svg>
        </a>
        <a href="{{ settings.social_facebook_link | default: 'https://facebook.com' }}" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
        </a>
      </div>
    {%- endif -%}

    <!-- Bottom Bar -->
    <div class="jjw-footer__bottom">
      <div class="jjw-footer__copyright">
        &copy; {{ 'now' | date: '%Y' }} Jevika &amp; Joy&#39;s World. All rights reserved.
      </div>
      <div class="jjw-footer__bottom-links">
        <a href="/policies/privacy-policy">Privacy Policy</a>
        <span aria-hidden="true">&bull;</span>
        <a href="/policies/terms-of-service">Terms of Service</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "JJW Footer",
  "tag": "footer",
  "class": "section-footer",
  "settings": [
    {
      "type": "textarea",
      "id": "mission_text",
      "label": "Mission Statement",
      "default": "Original hero tees for kids, ages 4–12. Certified safe, organic cotton, five characters to choose from."
    },
    {
      "type": "checkbox",
      "id": "show_social",
      "label": "Show Social Links",
      "default": true
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show newsletter signup",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter heading",
      "default": "Join the Crew"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "link_list",
      "name": "Link column",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JJW Footer",
      "blocks": [
        { "type": "link_list", "settings": { "heading": "Shop", "menu": "main-menu" } },
        { "type": "link_list", "settings": { "heading": "About" } },
        { "type": "link_list", "settings": { "heading": "Help" } }
      ]
    }
  ]
}
{% endschema %}
