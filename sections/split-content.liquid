{%- comment -%}
  Split content — image side + copy side on a rounded colour panel.
  Ported from the React component src/components/site/split-content.tsx.

  Notes on the port:
  - The React copy column absolutely positions its content over a zero-height
    box (the row is bottom-aligned), so the copy spills outside the panel.
    Here the wrapper stays in flow (same margin rhythm:
    141/183/386px) so the panel grows with the copy instead of overflowing.
  - The badge "bursting" loop is gated by the theme's existing .scroll-trigger
    observer (theme.js) rather than a second local IntersectionObserver.
{%- endcomment -%}

{%- style -%}
  #SplitContent-{{ section.id }} {
    padding-block: var(--section-space);
  }

  #SplitContent-{{ section.id }} .sc__panel {
    display: flex;
    flex-direction: row;
    align-items: flex-end;
    gap: 4rem;
    border-radius: 2rem;
    background: var(--pink);
    color: var(--ink-deep);
  }

  #SplitContent-{{ section.id }} .sc__media {
    position: relative;
    flex: 0 0 45%;
    min-width: 0;
    align-self: flex-end;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    border-radius: 0 0 0 2rem;
  }

  /* Let the artwork size itself from its own ratio instead of being contained
     inside a viewport-height box, which letterboxed it and left dead space. */
  #SplitContent-{{ section.id }} .sc__img {
    position: static;
    width: 100%;
    height: auto;
    object-fit: contain;
    display: block;
  }

  #SplitContent-{{ section.id }} .sc__badge {
    position: absolute;
    width: 25%;
    height: auto;
    transform: scale(0.3) rotate(-5deg);
  }

  /* Two overlapping tags per label, each tilted differently, with free-floating
     spark triangles around them. Tonal orange-on-amber, as in the reference. */
  #SplitContent-{{ section.id }} .sc__tag {
    position: absolute;
    z-index: 3;
    left: var(--tag-x, 50%);
    top: var(--tag-y, 10%);
    transform: rotate(var(--rot, -6deg));
    transform-origin: center;
    animation: jjw-tag-bounce 7s ease-in-out infinite;
    animation-delay: var(--tag-delay, 0s);
    pointer-events: none;
  }

  #SplitContent-{{ section.id }} .sc__tag-card {
    display: block;
    width: max-content;
    background: var(--yellow);
    color: #C2410C;
    border-radius: 0.6rem;
    box-shadow: 3px 3px 0 0 var(--gold);
    white-space: nowrap;
  }

  #SplitContent-{{ section.id }} .sc__tag-card--name {
    padding: 0.7rem 1.6rem 0.6rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1.05;
    transform: rotate(-3deg);
  }

  /* The role sits on its own tag, nudged down-right and counter-rotated so the
     two read as separate labels stuck on top of each other. */
  #SplitContent-{{ section.id }} .sc__tag-card--role {
    margin: -0.5rem 0 0 1.8rem;
    padding: 0.45rem 1.3rem 0.4rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.4rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    line-height: 1;
    transform: rotate(4deg);
  }

  #SplitContent-{{ section.id }} .sc__spark {
    position: absolute;
    width: 1.6rem;
    height: 1.6rem;
    background: var(--gold);
    clip-path: polygon(0% 0%, 100% 42%, 32% 100%);
    pointer-events: none;
  }

  #SplitContent-{{ section.id }} .sc__spark--a {
    top: -2.2rem;
    left: 6%;
    transform: rotate(-35deg);
  }

  #SplitContent-{{ section.id }} .sc__spark--b {
    bottom: -2rem;
    right: 4%;
    transform: rotate(145deg);
  }

  /* Bounces in over the first ~1.5s, settles, then repeats on the 7s cycle. */
  @keyframes jjw-tag-bounce {
    0%   { transform: rotate(var(--rot, -6deg)) translateY(-14px) scale(0.9); }
    5%   { transform: rotate(var(--rot, -6deg)) translateY(0) scale(1.06); }
    9%   { transform: rotate(var(--rot, -6deg)) translateY(-8px) scale(1); }
    13%  { transform: rotate(var(--rot, -6deg)) translateY(0) scale(1.02); }
    17%  { transform: rotate(var(--rot, -6deg)) translateY(-4px) scale(1); }
    21%  { transform: rotate(var(--rot, -6deg)) translateY(0) scale(1); }
    100% { transform: rotate(var(--rot, -6deg)) translateY(0) scale(1); }
  }

  @media screen and (max-width: 749px) {
    #SplitContent-{{ section.id }} .sc__tag-card--name { font-size: 1.8rem; padding: 0.5rem 1.1rem 0.45rem; }
    /* 1.2rem is the floor for any label on this site: 1.05rem was 10.5px. */
    #SplitContent-{{ section.id }} .sc__tag-card--role { font-size: 1.2rem; padding: 0.35rem 0.9rem 0.3rem; margin-left: 1.2rem; }
    #SplitContent-{{ section.id }} .sc__spark { width: 1.1rem; height: 1.1rem; }
    #SplitContent-{{ section.id }} .sc__spark--a { top: -1.5rem; }
    #SplitContent-{{ section.id }} .sc__spark--b { bottom: -1.4rem; }
  }

  #SplitContent-{{ section.id }} .sc__badge--one {
    left: 51%;
    bottom: 60%;
    animation-delay: 0.15s;
  }

  #SplitContent-{{ section.id }} .sc__badge--two {
    left: 42%;
    bottom: 5%;
  }

  @media screen and (max-width: 749px) {
    #SplitContent-{{ section.id }} .sc__tag {
      padding: 0.6rem 1.1rem 0.5rem;
      box-shadow: 3px 3px 0 0 var(--gold);
      /* The tags are max-content wide and placed by a percentage tuned for
         desktop. On a phone a tag anchored past mid-width ran 70-105px off the
         right edge. Capping the anchor at 50% keeps the whole card on screen;
         a 45vw tag from 50% ends at 95vw. */
      left: clamp(1rem, var(--tag-x, 50%), 50%);
    }

    #SplitContent-{{ section.id }} .sc__tag-name { font-size: 1.7rem; }
    #SplitContent-{{ section.id }} .sc__tag-role { font-size: 1rem; }

    #SplitContent-{{ section.id }} .sc__tag::before,
    #SplitContent-{{ section.id }} .sc__tag::after {
      width: 1rem;
      height: 1rem;
    }

    #SplitContent-{{ section.id }} .sc__tag::before { top: -0.8rem; }
    #SplitContent-{{ section.id }} .sc__tag::after { bottom: -0.8rem; }
  }

  #SplitContent-{{ section.id }} .sc__badge:not(.scroll-trigger--offscreen) {
    animation-name: jjw-sc-bursting;
    animation-duration: 6s;
    animation-timing-function: cubic-bezier(0.68, -0.55, 0.265, 1.55);
    animation-iteration-count: infinite;
  }

  @keyframes jjw-sc-bursting {
    0% {
      opacity: 0;
      transform: scale(0.3) rotate(-5deg);
    }
    15% {
      opacity: 1;
      transform: scale(1.05) rotate(2deg);
    }
    33.33%,
    100% {
      opacity: 1;
      transform: scale(1) rotate(0deg);
    }
  }

  /* The conversion turned absolute Y-offsets from the React layout into stacked
     top margins (14.1 + 18.3 + 38.6rem = 710px), which inflated this column and
     stranded the artwork at the bottom of the panel. Real vertical rhythm here. */
  #SplitContent-{{ section.id }} .sc__copy {
    position: relative;
    display: flex;
    flex: 1 1 0%;
    min-width: 0;
    align-items: center;
    justify-content: flex-start;
    padding: 6rem 4rem 6rem 2rem;
  }

  #SplitContent-{{ section.id }} .sc__copy-inner {
    width: 100%;
  }

  #SplitContent-{{ section.id }} .sc__title {
    margin-top: 0;
    color: var(--ink-deep);
  }

  #SplitContent-{{ section.id }} .sc__text {
    margin-top: 3rem;
    max-width: 62rem;
    font-size: var(--text-xl);
    line-height: 1.5;
    color: var(--ink-deep);
  }

  #SplitContent-{{ section.id }} .sc__text > * {
    margin: 0;
  }

  #SplitContent-{{ section.id }} .sc__btn {
    margin-top: 4rem;
    --btn-bg: var(--yellow);
    --btn-fg: var(--ink-deep);
    --btn-shadow-color: var(--gold);
  }

  @media screen and (max-width: 749px) {
    #SplitContent-{{ section.id }} {
      padding-block: var(--section-space);
    }

    #SplitContent-{{ section.id }} .sc__panel {
      flex-direction: column-reverse;
      /* Desktop's align-items: flex-end carried into the column layout, where
         it means "hug the right edge, do not stretch". The media box then
         shrank to its content, its width: 100% image resolved against a
         0-wide parent, and the artwork and every tag inside it vanished off the
         right edge of the phone. Stretch restores the full-width column. */
      align-items: stretch;
    }

    #SplitContent-{{ section.id }} .sc__media {
      flex: 0 0 auto;
      align-self: auto;
      width: 100%;
      border-radius: 0 0 2rem 2rem;
    }

    #SplitContent-{{ section.id }} .sc__copy {
      justify-content: center;
      padding: 4rem 2rem;
    }

    /* The desktop margin rhythm is far taller than a phone viewport. */
    #SplitContent-{{ section.id }} .sc__title {
      margin-top: 0;
    }

    #SplitContent-{{ section.id }} .sc__text {
      margin-top: 2.4rem;
    }

    #SplitContent-{{ section.id }} .sc__btn {
      margin-top: 3.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SplitContent-{{ section.id }} .sc__badge {
      opacity: 1;
      transform: none;
      animation: none;
    }
  }
{%- endstyle -%}

<section id="SplitContent-{{ section.id }}" class="split-content">
  <div class="page-width">
    <div class="sc__panel">
      <div class="sc__media">
        {%- if section.settings.image != blank -%}
          {{
            section.settings.image
            | image_url: width: 1400
            | image_tag: class: 'sc__img', loading: 'lazy', widths: '400, 600, 900, 1200, 1400', alt: section.settings.image.alt
          }}
        {%- else -%}
          <img
            src="{{ 'jjw-about.png' | asset_url }}"
            alt=""
            class="sc__img"
            width="1536"
            height="1024"
            loading="lazy"
          >
        {%- endif -%}

        {%- if section.settings.badge_one != blank -%}
          {{
            section.settings.badge_one
            | image_url: width: 600
            | image_tag: class: 'sc__badge sc__badge--one scroll-trigger', loading: 'lazy', widths: '200, 400, 600', alt: ''
          }}
        {%- endif -%}

        {%- if section.settings.badge_two != blank -%}
          {{
            section.settings.badge_two
            | image_url: width: 600
            | image_tag: class: 'sc__badge sc__badge--two scroll-trigger', loading: 'lazy', widths: '200, 400, 600', alt: ''
          }}
        {%- endif -%}

        {%- for i in (1..2) -%}
          {%- if i == 1 -%}
            {%- assign tag_name = section.settings.tag_one_name -%}
            {%- assign tag_role = section.settings.tag_one_role -%}
            {%- assign tag_x = section.settings.tag_one_x -%}
            {%- assign tag_y = section.settings.tag_one_y -%}
            {%- assign tag_rot = section.settings.tag_one_rotate -%}
            {%- assign tag_delay = '0s' -%}
          {%- else -%}
            {%- assign tag_name = section.settings.tag_two_name -%}
            {%- assign tag_role = section.settings.tag_two_role -%}
            {%- assign tag_x = section.settings.tag_two_x -%}
            {%- assign tag_y = section.settings.tag_two_y -%}
            {%- assign tag_rot = section.settings.tag_two_rotate -%}
            {%- assign tag_delay = '0.4s' -%}
          {%- endif -%}
          {%- if tag_name != blank -%}
            <span
              class="sc__tag"
              style="--tag-x:{{ tag_x }}%;--tag-y:{{ tag_y }}%;--rot:{{ tag_rot }}deg;--tag-delay:{{ tag_delay }};"
            >
              <span class="sc__tag-card sc__tag-card--name">{{ tag_name | escape }}</span>
              {%- if tag_role != blank -%}
                <span class="sc__tag-card sc__tag-card--role">{{ tag_role | escape }}</span>
              {%- endif -%}
              <i class="sc__spark sc__spark--a" aria-hidden="true"></i>
              <i class="sc__spark sc__spark--b" aria-hidden="true"></i>
            </span>
          {%- endif -%}
        {%- endfor -%}
      </div>

      <div class="sc__copy">
        <div class="sc__copy-inner">
          {%- if section.settings.heading != blank -%}
            <h2 class="sc__title hxxl scroll-trigger animate--slide-in">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.body != blank -%}
            <div class="sc__text">{{ section.settings.body }}</div>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="sc__btn btn-wrap">
              <span class="btn-shadow" aria-hidden="true"></span>
              <a href="{{ section.settings.button_link | default: '#' }}" class="btn">
                {{- section.settings.button_label | escape -}}
              </a>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Split content",
  "tag": "section",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Main image",
      "info": "Defaults to jjw-about.png when empty."
    },
    {
      "type": "image_picker",
      "id": "badge_one",
      "label": "Badge image 1",
      "info": "Optional overlay. Pops in near the top of the image."
    },
    {
      "type": "image_picker",
      "id": "badge_two",
      "label": "Badge image 2",
      "info": "Optional overlay. Pops in near the bottom of the image."
    },
    { "type": "header", "content": "Photo labels" },
    {
      "type": "paragraph",
      "content": "Tilted tags pinned over the photo. Leave a name blank to hide that tag. Positions are a percentage of the photo, measured from its top-left."
    },
    { "type": "text", "id": "tag_one_name", "label": "Tag 1 name", "default": "Founder" },
    { "type": "text", "id": "tag_one_role", "label": "Tag 1 role", "default": "Chief Dreamer" },
    { "type": "range", "id": "tag_one_x", "label": "Tag 1 across", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 52 },
    { "type": "range", "id": "tag_one_y", "label": "Tag 1 down", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 9 },
    { "type": "range", "id": "tag_one_rotate", "label": "Tag 1 tilt", "min": -15, "max": 15, "step": 1, "unit": "deg", "default": -6 },
    { "type": "text", "id": "tag_two_name", "label": "Tag 2 name", "default": "Brutus" },
    { "type": "text", "id": "tag_two_role", "label": "Tag 2 role", "default": "Chief Good Boy" },
    { "type": "range", "id": "tag_two_x", "label": "Tag 2 across", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 70 },
    { "type": "range", "id": "tag_two_y", "label": "Tag 2 down", "min": 0, "max": 90, "step": 1, "unit": "%", "default": 47 },
    { "type": "range", "id": "tag_two_rotate", "label": "Tag 2 tilt", "min": -15, "max": 15, "step": 1, "unit": "deg", "default": 5 },

    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Heroes Made for Every Kid"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Body",
      "default": "<p>We couldn't find premium tees that gave kids their own original heroes instead of borrowed ones, so we made them. Five friends, five values, and no compromise on safety, craft or story.</p>"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Split content"
    }
  ]
}
{% endschema %}
