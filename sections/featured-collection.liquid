{%- comment -%}
  Featured collection — converted from the React FeaturedCollection component
  (src/components/site/featured-collection.tsx). Horizontal snap carousel of
  product cards, each on its own colour pair, with a page counter and arrows.

  Card colours: product.metafields.custom.card_color may hold one of
  pink | blue | gold | green | purple. When it is blank the pairs cycle by
  loop index, which is what the React data file hardcodes per product.
{%- endcomment -%}

{%- assign collection = section.settings.collection -%}
{%- assign palette = 'pink,blue,gold,green,purple' | split: ',' -%}

{%- style -%}
  #FeaturedCollection-{{ section.id }} {
    background: var(--cream);
  }

  #FeaturedCollection-{{ section.id }} .fc__inner {
    padding-block: 2.86rem 5.5rem;
  }

  #FeaturedCollection-{{ section.id }} .fc__heading {
    margin-bottom: 2.5rem;
    text-align: center;
    color: var(--ink);
  }

  #FeaturedCollection-{{ section.id }} .fc__spacer {
    height: 7.2rem;
  }

  #FeaturedCollection-{{ section.id }} .fc__viewport {
    position: relative;
  }

  #FeaturedCollection-{{ section.id }} .fc__track {
    display: flex;
    gap: 4rem;
    margin: 0;
    padding: 1.6rem 2rem 1rem;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    -webkit-overflow-scrolling: touch;
  }

  #FeaturedCollection-{{ section.id }} .fc__item {
    flex: none;
    width: 36rem;
    scroll-snap-align: start;
  }

  #FeaturedCollection-{{ section.id }} .fc__card {
    display: block;
  }

  #FeaturedCollection-{{ section.id }} .fc__media {
    position: relative;
    overflow: hidden;
    border-radius: 2rem;
    aspect-ratio: 4 / 5;
    background: var(--card-bg, var(--pink-bg));
  }

  #FeaturedCollection-{{ section.id }} .fc__img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    transition: opacity 0.3s var(--ease);
  }

  #FeaturedCollection-{{ section.id }} .fc__img--front {
    object-fit: contain;
  }

  #FeaturedCollection-{{ section.id }} .fc__img--back {
    object-fit: cover;
    opacity: 0;
  }

  #FeaturedCollection-{{ section.id }} .fc__card:hover .fc__img--back {
    opacity: 1;
  }

  #FeaturedCollection-{{ section.id }} .fc__card:hover .fc__img--front:not(:only-child) {
    opacity: 0;
  }

  #FeaturedCollection-{{ section.id }} .fc__label {
    display: grid;
    place-items: center;
    height: 21.9rem;
    padding: 1rem 2rem;
  }

  #FeaturedCollection-{{ section.id }} .fc__title {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 4rem;
    line-height: 1;
    letter-spacing: -0.02rem;
    text-align: center;
    text-wrap: balance;
    color: var(--card-fg, var(--pink));
  }

  #FeaturedCollection-{{ section.id }} [data-pair='pink'] {
    --card-bg: var(--pink-bg);
    --card-fg: var(--pink);
  }
  #FeaturedCollection-{{ section.id }} [data-pair='blue'] {
    --card-bg: var(--blue-bg);
    --card-fg: var(--blue);
  }
  #FeaturedCollection-{{ section.id }} [data-pair='gold'] {
    --card-bg: var(--gold-bg);
    --card-fg: var(--gold);
  }
  #FeaturedCollection-{{ section.id }} [data-pair='green'] {
    --card-bg: var(--green-bg);
    --card-fg: var(--green);
  }
  #FeaturedCollection-{{ section.id }} [data-pair='purple'] {
    --card-bg: var(--purple-bg);
    --card-fg: var(--purple);
  }

  #FeaturedCollection-{{ section.id }} .fc__controls {
    position: absolute;
    inset-inline: 0;
    top: calc(50% + 0.8rem);
    transform: translateY(-50%);
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-inline: 2rem;
    pointer-events: none;
  }

  #FeaturedCollection-{{ section.id }} .fc__arrow {
    pointer-events: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 5rem;
    height: 5rem;
    padding: 0;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    transition: opacity 0.2s var(--ease);
  }

  #FeaturedCollection-{{ section.id }} .fc__arrow:hover {
    opacity: 0.85;
  }

  #FeaturedCollection-{{ section.id }} .fc__arrow--prev svg {
    transform: rotate(180deg);
  }

  #FeaturedCollection-{{ section.id }} .fc__count {
    font-size: 1.6rem;
    color: var(--ink-soft);
  }

  #FeaturedCollection-{{ section.id }} .fc__cta {
    display: flex;
    justify-content: center;
    margin-top: 1rem;
  }

  #FeaturedCollection-{{ section.id }} .fc__cta .btn {
    font-size: clamp(1.6rem, 4.2vw, 2.2rem);
  }

  @media screen and (max-width: 989px) {
    #FeaturedCollection-{{ section.id }} .fc__item {
      width: 30rem;
    }

    #FeaturedCollection-{{ section.id }} .fc__title {
      font-size: clamp(3.2rem, 4.5vw, 4rem);
    }
  }

  @media screen and (max-width: 749px) {
    #FeaturedCollection-{{ section.id }} .fc__inner {
      padding-block: 2.4rem 4rem;
    }

    #FeaturedCollection-{{ section.id }} .fc__track {
      gap: 1.2rem;
    }

    #FeaturedCollection-{{ section.id }} .fc__item {
      width: calc((100vw - 3.5rem) / 2);
    }

    #FeaturedCollection-{{ section.id }} .fc__label {
      height: auto;
    }
  }
{%- endstyle -%}

<section id="FeaturedCollection-{{ section.id }}">
  <div class="fc__inner">
    <div class="page-width">
      {%- if section.settings.heading != blank -%}
        <h2 class="hxxl fc__heading scroll-trigger animate--slide-in">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      <div class="fc__spacer" aria-hidden="true"></div>
    </div>

    {%- if collection != blank and collection.products.size > 0 -%}
      <div class="fc__viewport scroll-trigger animate--slide-in">
        <ul class="fc__track no-scrollbar" data-fc-track>
          {%- for product in collection.products limit: section.settings.products_to_show -%}
            {%- assign pair_index = forloop.index0 | modulo: 5 -%}
            {%- assign pair = palette[pair_index] -%}
            {%- assign pair_override = product.metafields.custom.card_color.value | downcase -%}
            {%- if pair_override != blank -%}
              {%- assign pair = pair_override -%}
            {%- endif -%}

            <li
              class="fc__item scroll-trigger animate--slide-in"
              data-pair="{{ pair | escape }}"
              style="--animation-order: {{ forloop.index0 }};"
            >
              <a class="fc__card" href="{{ product.url }}">
                <div class="fc__media">
                  {%- if product.images[1] != blank -%}
                    {{
                      product.images[1]
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        alt: '',
                        class: 'fc__img fc__img--back',
                        widths: '300, 400, 600, 800, 1000',
                        sizes: '(max-width: 749px) 45vw, 36rem'
                    }}
                  {%- endif -%}
                  {%- if product.featured_image != blank -%}
                    {{
                      product.featured_image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'lazy',
                        alt: product.title,
                        class: 'fc__img fc__img--front',
                        widths: '300, 400, 600, 800, 1000',
                        sizes: '(max-width: 749px) 45vw, 36rem'
                    }}
                  {%- endif -%}
                </div>
                <div class="fc__label">
                  <h3 class="fc__title">{{ product.title }}</h3>
                </div>
              </a>
            </li>
          {%- endfor -%}
        </ul>

        <div class="fc__controls">
          <button
            type="button"
            class="fc__arrow fc__arrow--prev"
            data-fc-prev
            aria-label="{{ section.settings.previous_label | escape }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M4 12h14m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2.4"/>
            </svg>
          </button>
          <span class="accent-caps fc__count" data-fc-count aria-live="polite">
            1 {{ section.settings.count_separator | escape }} 1
          </span>
          <button
            type="button"
            class="fc__arrow fc__arrow--next"
            data-fc-next
            aria-label="{{ section.settings.next_label | escape }}"
          >
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
              <path d="M4 12h14m0 0-5-5m5 5-5 5" stroke="currentColor" stroke-width="2.4"/>
            </svg>
          </button>
        </div>
      </div>
    {%- endif -%}

    {%- if section.settings.button_label != blank -%}
      <div class="page-width fc__cta scroll-trigger animate--slide-in">
        <span class="btn-wrap">
          <span class="btn-shadow" aria-hidden="true"></span>
          <a class="btn btn--secondary" href="{{ section.settings.button_link | default: collection.url }}">
            {{- section.settings.button_label | escape -}}
          </a>
        </span>
      </div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('FeaturedCollection-{{ section.id }}');
    if (!root || root.dataset.fcInit) return;
    root.dataset.fcInit = '1';

    var track = root.querySelector('[data-fc-track]');
    if (!track) return;
    var count = root.querySelector('[data-fc-count]');
    var sep = {{ section.settings.count_separator | default: 'of' | json }};
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // Card width + the real gap, so the mobile 12px gap steps correctly too.
    function step() {
      var card = track.querySelector('li');
      if (!card) return track.clientWidth;
      var gap = parseFloat(getComputedStyle(track).columnGap);
      return card.getBoundingClientRect().width + (isNaN(gap) ? 0 : gap);
    }

    function update() {
      if (!count) return;
      var s = step() || track.clientWidth || 1;
      var total = Math.max(1, Math.ceil((track.scrollWidth - track.clientWidth) / s) + 1);
      var page = Math.max(1, Math.min(total, Math.round(track.scrollLeft / s) + 1));
      count.textContent = page + ' ' + sep + ' ' + total;
    }

    function scrollByPage(dir) {
      track.scrollBy({ left: dir * (step() || track.clientWidth), behavior: reduced ? 'auto' : 'smooth' });
    }

    track.addEventListener('scroll', update, { passive: true });
    window.addEventListener('resize', update);
    var prev = root.querySelector('[data-fc-prev]');
    var next = root.querySelector('[data-fc-next]');
    if (prev) prev.addEventListener('click', function () { scrollByPage(-1); });
    if (next) next.addEventListener('click', function () { scrollByPage(1); });
    update();
  })();
</script>

{% schema %}
{
  "name": "Featured collection",
  "settings": [
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Every Hero Has a Tee"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 24,
      "step": 1,
      "default": 12
    },
    {
      "type": "text",
      "id": "count_separator",
      "label": "Counter separator",
      "info": "Shown between the current page and the total, e.g. 1 of 6.",
      "default": "of"
    },
    {
      "type": "text",
      "id": "previous_label",
      "label": "Previous button label",
      "info": "Read by screen readers.",
      "default": "Previous"
    },
    {
      "type": "text",
      "id": "next_label",
      "label": "Next button label",
      "info": "Read by screen readers.",
      "default": "Next"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop Your Daily Snack Rotation"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    }
  ],
  "presets": [
    {
      "name": "Featured collection"
    }
  ]
}
{% endschema %}
