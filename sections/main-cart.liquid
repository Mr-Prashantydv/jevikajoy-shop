{%- comment -%}
  Cart — line items, quantities, totals and checkout, plus an empty state.
  Character-accented item cards and a compact order summary use the shared
  storefront tokens and button geometry. Recommendations remain a separate section.

  Commerce notes:
  - The whole thing is one <form action="{{ routes.cart_url }}" method="post">
    so quantity edits submit via `updates[]` and checkout via name="checkout".
    That means it works with JS disabled; the JS below only removes the need to
    press "Update".
  - Products without images fall back to their character colour and title.
{%- endcomment -%}

{%- style -%}
  #MainCart-{{ section.id }} {
    background: var(--warm-white);
  }

  #MainCart-{{ section.id }} .cart__inner {
    padding-block: {{ section.settings.padding_top }}px {{ section.settings.padding_bottom }}px;
  }

  #MainCart-{{ section.id }} .cart__heading {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: var(--page-heading-size);
    line-height: 1.08;
    letter-spacing: 0.06rem;
    color: var(--heading);
    margin: 0;
  }

  /* ---------- Empty state ---------- */

  #MainCart-{{ section.id }} .cart__empty {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 2rem;
    padding: 3.2rem 2rem;
    background: var(--cream);
    border-radius: var(--card-radius);
  }

  #MainCart-{{ section.id }} .cart__empty-text {
    font-size: var(--text-lead);
    line-height: 1.4;
    color: var(--ink-soft);
    max-width: 46rem;
    margin: 0;
  }

  /* ---------- Line items ---------- */

  #MainCart-{{ section.id }} .cart__items {
    width: 100%;
    display: grid;
    gap: 1.6rem;
    min-width: 0;
  }

  #MainCart-{{ section.id }} .cart__row {
    display: grid;
    grid-template-columns: 12rem minmax(0, 1fr) auto;
    gap: 2rem;
    align-items: center;
    padding: 2rem;
    background: var(--white);
    border: 1px solid var(--line);
    border-inline-start: 6px solid var(--item-bg, var(--sky));
    border-radius: var(--card-radius);
  }

  #MainCart-{{ section.id }} .cart__media {
    width: 12rem;
    height: 12rem;
    border-radius: 1.6rem;
    overflow: hidden;
    background: var(--item-bg, var(--blue-bg));
    display: grid;
    place-items: center;
  }

  #MainCart-{{ section.id }} .cart__media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #MainCart-{{ section.id }} .cart__media-fallback {
    font-family: var(--font-accent);
    font-weight: 900;
    font-size: 1.6rem;
    line-height: 1.1;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink);
    padding: 0.8rem;
  }

  #MainCart-{{ section.id }} .cart__name {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1.3;
    color: var(--ink);
    text-decoration: none;
    display: block;
  }

  #MainCart-{{ section.id }} .cart__variant {
    margin: 0.6rem 0 0;
    font-size: 1.5rem;
    color: var(--ink-soft);
  }

  #MainCart-{{ section.id }} .cart__unit {
    margin: 0.4rem 0 0;
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 1.7rem;
    letter-spacing: 0;
    color: var(--ink);
  }

  #MainCart-{{ section.id }} .cart__right {
    display: flex;
    flex-direction: column;
    align-items: flex-end;
    gap: 1.2rem;
  }

  #MainCart-{{ section.id }} .cart__qty {
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--ink-soft);
    border-radius: 0.8rem;
    overflow: hidden;
    background: var(--white);
  }

  #MainCart-{{ section.id }} .cart__qty button {
    width: var(--touch-target);
    height: var(--touch-target);
    font-size: 2rem;
    line-height: 1;
    color: var(--ink);
    background: transparent;
  }

  #MainCart-{{ section.id }} .cart__qty button:hover {
    background: var(--blue-bg);
  }

  #MainCart-{{ section.id }} .cart__qty input {
    width: 4.4rem;
    height: var(--touch-target);
    border: 0;
    text-align: center;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.8rem;
    color: var(--ink);
    background: transparent;
    -moz-appearance: textfield;
  }

  #MainCart-{{ section.id }} .cart__qty input::-webkit-outer-spin-button,
  #MainCart-{{ section.id }} .cart__qty input::-webkit-inner-spin-button {
    -webkit-appearance: none;
    margin: 0;
  }

  #MainCart-{{ section.id }} .cart__line-total {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 2rem;
    color: var(--ink);
    letter-spacing: 0;
  }

  #MainCart-{{ section.id }} .cart__line-was {
    margin-inline-end: 0.8rem;
    font-weight: 700;
    font-size: 1.5rem;
    color: var(--ink-soft);
  }

  #MainCart-{{ section.id }} .cart__remove {
    display: inline-flex;
    align-items: center;
    min-height: var(--touch-target);
    font-family: var(--font-body);
    font-weight: 700;
    font-size: var(--text-sm);
    letter-spacing: 0.06em;
    text-transform: none;
    color: var(--ink-soft);
    text-decoration: underline;
  }

  #MainCart-{{ section.id }} .cart__remove:hover {
    color: var(--ink);
  }

  /* ---------- Footer / totals ---------- */

  #MainCart-{{ section.id }} .cart__footer {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: 1.6rem;
    padding: 2.8rem;
    background: var(--cream);
    border: 1px solid var(--ink);
    border-radius: var(--card-radius);
    box-shadow: 5px 5px 0 var(--ink-deep);
    min-width: 0;
  }

  {%- comment -%}
    One grid for every totals row, so the amounts share a right-aligned column
    and read as a sum: full price, minus the saving, equals the total. Rows are
    display: contents so their two spans become the grid's cells.
  {%- endcomment -%}
  #MainCart-{{ section.id }} .cart__sums {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: baseline;
    row-gap: 0.8rem;
  }

  #MainCart-{{ section.id }} .cart__sums > div {
    display: contents;
  }

  /* Padding, not column-gap, so the rule above the total runs unbroken. */
  #MainCart-{{ section.id }} .cart__sums > div > span:first-child {
    padding-inline-end: 2.4rem;
  }

  #MainCart-{{ section.id }} .cart__sums > div > span:last-child {
    text-align: end;
  }

  #MainCart-{{ section.id }} .cart__subline {
    font-size: 1.6rem;
    color: var(--ink-soft);
  }

  {%- comment -%}
    Navy, as in the drawer: a coloured saving would sit under 4.5:1 on cream.
  {%- endcomment -%}
  #MainCart-{{ section.id }} .cart__saved {
    font-size: 1.6rem;
    color: var(--ink);
  }

  #MainCart-{{ section.id }} .cart__subtotal {
    font-family: var(--font-body);
    font-weight: 700;
    font-size: 3rem;
    color: var(--ink);
    letter-spacing: 0;
  }

  #MainCart-{{ section.id }} .cart__saved + .cart__subtotal > span {
    padding-block-start: 0.8rem;
    border-block-start: 2px solid var(--sky);
  }

  #MainCart-{{ section.id }} .cart__subtotal-label {
    font-size: 1.8rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  #MainCart-{{ section.id }} .cart__note {
    margin: 0;
    font-size: 1.5rem;
    color: var(--ink-soft);
    line-height: 1.5;
    text-align: left;
  }

  #MainCart-{{ section.id }} .cart__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 1.2rem;
    margin-top: 0.8rem;
  }

  #MainCart-{{ section.id }} .cart__actions .btn {
    min-height: 5.6rem;
    font-size: var(--button-text-size);
    padding-inline: 3.2rem;
  }

  #MainCart-{{ section.id }} .cart__update {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.5rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--ink);
    text-decoration: underline;
    background: none;
  }

  #MainCart-{{ section.id }} .cart__header {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    margin-bottom: 3.2rem;
  }

  #MainCart-{{ section.id }} .cart__eyebrow {
    margin: 0 0 0.8rem;
    color: var(--ink);
  }

  #MainCart-{{ section.id }} .cart__intro {
    margin: 1rem 0 0;
    font-size: var(--text-base);
    color: var(--body-ink);
    line-height: 1.5;
  }

  #MainCart-{{ section.id }} .cart__continue {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: var(--touch-target);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--ink);
    text-underline-offset: 0.4rem;
  }

  #MainCart-{{ section.id }} .cart__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(30rem, 36rem);
    gap: 3.2rem;
    align-items: start;
    padding-inline-end: 0.6rem;
  }

  #MainCart-{{ section.id }} .cart__summary-heading {
    margin: 0;
    font-family: var(--font-heading);
    font-size: 2.8rem;
    line-height: 1.15;
    font-weight: 800;
    color: var(--ink);
  }

  #MainCart-{{ section.id }} .cart__summary-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 1.6rem;
    border-bottom: 2px solid var(--sky);
  }

  #MainCart-{{ section.id }} .cart__count {
    display: grid;
    place-items: center;
    min-width: 3.6rem;
    height: 3.6rem;
    padding-inline: 0.8rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
    font-weight: 700;
  }

  #MainCart-{{ section.id }} .cart__actions .btn-wrap,
  #MainCart-{{ section.id }} .cart__actions .btn { width: 100%; }
  #MainCart-{{ section.id }} .cart__actions .btn { gap: 1rem; }
  #MainCart-{{ section.id }} .cart__summary-foot {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--body-ink);
  }
  #MainCart-{{ section.id }} .cart__empty-icon {
    width: 7.2rem;
    height: 7.2rem;
    padding: 1.6rem;
    border-radius: 50%;
    background: var(--yellow);
    color: var(--ink);
  }
  #MainCart-{{ section.id }} .cart__details { min-width: 0; overflow-wrap: anywhere; }

  @media screen and (max-width: 989px) {
    #MainCart-{{ section.id }} .cart__layout { grid-template-columns: minmax(0, 1fr); }
    #MainCart-{{ section.id }} .cart__footer { max-width: none; }
  }

  @media screen and (max-width: 749px) {
    #MainCart-{{ section.id }} .cart__header { align-items: flex-start; flex-direction: column; gap: 0.8rem; margin-bottom: 2rem; }
    #MainCart-{{ section.id }} .cart__inner { padding-block: 2.8rem 4rem; }
    #MainCart-{{ section.id }} .cart__layout { gap: 2rem; }
    #MainCart-{{ section.id }} .cart__footer { padding: 2rem; }
    #MainCart-{{ section.id }} .cart__summary-heading { font-size: 2.4rem; }
    #MainCart-{{ section.id }} .cart__subtotal { font-size: clamp(2.2rem, 6vw, 2.6rem); }
    #MainCart-{{ section.id }} .cart__subtotal-label { font-size: 1.5rem; }
    #MainCart-{{ section.id }} .cart__sums > div > span:first-child { padding-inline-end: 1.2rem; }
    #MainCart-{{ section.id }} .cart__sums > div > span:last-child { white-space: nowrap; }
    #MainCart-{{ section.id }} .cart__row {
      grid-template-columns: 8rem minmax(0, 1fr);
      gap: 1.6rem;
      padding: 1.6rem;
    }

    #MainCart-{{ section.id }} .cart__media {
      width: 8rem;
      height: 8rem;
    }

    #MainCart-{{ section.id }} .cart__right {
      grid-column: 1 / -1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      flex-wrap: wrap;
      gap: 0.8rem 1.2rem;
    }

    #MainCart-{{ section.id }} .cart__name {
      font-size: 1.8rem;
    }

    #MainCart-{{ section.id }} .cart__footer {
      align-items: stretch;
    }

    #MainCart-{{ section.id }} .cart__sums {
      grid-template-columns: 1fr auto;
    }

    #MainCart-{{ section.id }} .cart__actions {
      justify-content: stretch;
    }

    #MainCart-{{ section.id }} .cart__actions .btn-wrap {
      flex: 1 1 100%;
    }
  }
{%- endstyle -%}

<section id="MainCart-{{ section.id }}">
  <div class="page-width cart__inner">
    <div class="cart__header">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="accent-caps cart__eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h1 class="cart__heading">{{ section.settings.heading | escape }}</h1>
        {%- if cart.item_count > 0 and section.settings.intro != blank -%}<p class="cart__intro">{{ section.settings.intro | escape }}</p>{%- endif -%}
      </div>
      {%- if cart.item_count > 0 -%}
        <a class="cart__continue" href="{{ routes.all_products_collection_url }}"><span aria-hidden="true">&larr;</span>{{ section.settings.continue_label | escape }}</a>
      {%- endif -%}
    </div>

    {%- if cart.item_count == 0 -%}
      <div class="cart__empty">
        <svg class="cart__empty-icon" viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M7 10h18l2 18H5L7 10Z"/><path d="M11 12V8a5 5 0 0 1 10 0v4" stroke-linecap="round"/></svg>
        <p class="cart__empty-text">{{ section.settings.empty_text | escape }}</p>
        <div class="btn-wrap">
          <span class="btn-shadow" aria-hidden="true"></span>
          <a class="btn btn--primary" href="{{ routes.all_products_collection_url }}">
            {{ section.settings.empty_cta | escape }}
          </a>
        </div>
      </div>
    {%- else -%}
      <form class="cart__layout" action="{{ routes.cart_url }}" method="post" novalidate data-cart-form>
        <div class="cart__items">
          {%- for line in cart.items -%}
            {%- capture pair -%}{%- render 'character-pair', product: line.product -%}{%- endcapture -%}
            {%- assign pair = pair | strip -%}
            <div class="cart__row" style="--item-bg: var(--{{ pair }}-bg);">
              <div class="cart__media">
                {%- if line.image != blank -%}
                  {{
                    line.image
                    | image_url: width: 300
                    | image_tag: loading: 'lazy', alt: line.title, widths: '120, 240, 300'
                  }}
                {%- else -%}
                  <span class="cart__media-fallback">{{ line.product.title | truncatewords: 3, '' | escape }}</span>
                {%- endif -%}
              </div>

              <div class="cart__details">
                <a class="cart__name" href="{{ line.url }}">{{ line.product.title | escape }}</a>
                {%- unless line.product.has_only_default_variant -%}
                  <p class="cart__variant">{{ line.variant.title | escape }}</p>
                {%- endunless -%}
                <p class="cart__unit">{{ line.original_price | money }}</p>
              </div>

              <div class="cart__right">
                <div class="cart__qty">
                  <button
                    type="button"
                    data-qty-down
                    aria-label="{{ 'Decrease quantity for ' | append: line.product.title | escape }}"
                  >&minus;</button>
                  <input
                    type="number"
                    name="updates[]"
                    value="{{ line.quantity }}"
                    min="0"
                    inputmode="numeric"
                    aria-label="{{ 'Quantity for ' | append: line.product.title | escape }}"
                    data-qty-input
                  >
                  <button
                    type="button"
                    data-qty-up
                    aria-label="{{ 'Increase quantity for ' | append: line.product.title | escape }}"
                  >+</button>
                </div>
                {%- comment -%}
                  A product discount is already inside final_line_price. Show the
                  full price beside it, or the lines add up to less than the
                  subtotal printed under them.
                {%- endcomment -%}
                <span class="cart__line-total">
                  {%- if line.original_line_price > line.final_line_price -%}
                    <span class="visually-hidden">{{ 'sections.cart.original_price' | t }}</span>
                    <s class="cart__line-was">{{ line.original_line_price | money }}</s>
                    <span class="visually-hidden">{{ 'sections.cart.discounted_price' | t }}</span>
                  {%- endif -%}
                  {{- line.final_line_price | money -}}
                </span>
                <a class="cart__remove" href="{{ line.url_to_remove }}">{{ section.settings.remove_label | escape }}</a>
              </div>
            </div>
          {%- endfor -%}
        </div>

        <div class="cart__footer" role="region" aria-labelledby="CartSummary-{{ section.id }}">
          <div class="cart__summary-top">
            <h2 id="CartSummary-{{ section.id }}" class="cart__summary-heading">{{ section.settings.summary_heading | escape }}</h2>
            <span class="cart__count" aria-label="{{ section.settings.count_label | escape }}">{{ cart.item_count }}</span>
          </div>
          {%- comment -%}
            Same three rows as the cart drawer. cart.total_price is already net of
            discounts, so it is never labelled Subtotal above a discount row: full
            price, then each discount, then the total checkout will charge.
            discount_applications covers product and order discounts alike, and
            their amounts sum to cart.total_discount.
          {%- endcomment -%}
          <div class="cart__sums">
            {%- if cart.total_discount > 0 -%}
              <div class="cart__subline">
                <span>{{ section.settings.subtotal_label | escape }}</span>
                <span>{{ cart.original_total_price | money }}</span>
              </div>
              {%- for application in cart.discount_applications -%}
                {%- if application.total_allocated_amount > 0 -%}
                  <div class="cart__saved">
                    <span>{{ application.title | default: section.settings.discount_label | escape }}</span>
                    <span>&minus;{{ application.total_allocated_amount | money }}</span>
                  </div>
                {%- endif -%}
              {%- endfor -%}
              <div class="cart__subtotal">
                <span class="cart__subtotal-label">{{ section.settings.total_label | escape }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
            {%- else -%}
              <div class="cart__subtotal">
                <span class="cart__subtotal-label">{{ section.settings.subtotal_label | escape }}</span>
                <span>{{ cart.total_price | money }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.footer_note != blank -%}
            <p class="cart__note">{{ section.settings.footer_note | escape }}</p>
          {%- endif -%}

          <div class="cart__actions">
            {%- comment -%} Visible only without JS; the script auto-submits instead. {%- endcomment -%}
            <noscript>
              <button type="submit" name="update" class="cart__update">
                {{ section.settings.update_label | escape }}
              </button>
            </noscript>

            <div class="btn-wrap">
              <span class="btn-shadow" aria-hidden="true"></span>
              <button type="submit" name="checkout" class="btn btn--primary">
                {{ section.settings.checkout_label | escape }}
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6"/></svg>
              </button>
            </div>
          </div>
          {%- if section.settings.summary_note != blank -%}<p class="cart__summary-foot">{{ section.settings.summary_note | escape }}</p>{%- endif -%}
        </div>
      </form>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('MainCart-{{ section.id }}');
    if (!root || root.dataset.cartInit) return;
    root.dataset.cartInit = '1';

    var form = root.querySelector('[data-cart-form]');
    if (!form) return;

    // Stepper buttons edit the number input, then submit so Shopify recalculates.
    root.addEventListener('click', function (e) {
      var down = e.target.closest('[data-qty-down]');
      var up = e.target.closest('[data-qty-up]');
      if (!down && !up) return;
      var wrap = (down || up).closest('.cart__qty');
      var input = wrap && wrap.querySelector('[data-qty-input]');
      if (!input) return;
      var v = parseInt(input.value, 10);
      if (isNaN(v)) v = 0;
      v = up ? v + 1 : Math.max(0, v - 1);
      input.value = v;
      form.submit();
    });

    // Typing a quantity submits on change, so "Update" is not needed with JS on.
    root.addEventListener('change', function (e) {
      if (e.target.matches('[data-qty-input]')) form.submit();
    });
  })();
</script>

{% schema %}
{
  "name": "Cart",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Your Cart" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "A little joy, ready to go" },
    { "type": "text", "id": "intro", "label": "Introduction", "default": "Their favourite characters. Their next everyday adventure." },
    { "type": "text", "id": "continue_label", "label": "Continue shopping link", "default": "Keep exploring" },
    { "type": "text", "id": "summary_heading", "label": "Summary heading", "default": "Order summary" },
    { "type": "text", "id": "count_label", "label": "Item count accessible label", "default": "Items in your cart" },
    { "type": "text", "id": "summary_note", "label": "Summary note", "default": "Choose delivery and payment in the next step." },
    { "type": "text", "id": "subtotal_label", "label": "Subtotal label", "default": "Subtotal" },
    { "type": "text", "id": "total_label", "label": "Total label", "info": "Shown under the discount line when one applies.", "default": "Total" },
    { "type": "text", "id": "discount_label", "label": "Discount label", "info": "Used only when a discount has no title of its own.", "default": "Discount" },
    { "type": "text", "id": "checkout_label", "label": "Checkout button", "default": "Checkout" },
    { "type": "text", "id": "update_label", "label": "Update button (no-JS)", "default": "Update cart" },
    { "type": "text", "id": "remove_label", "label": "Remove link", "default": "Remove" },
    { "type": "text", "id": "footer_note", "label": "Note under subtotal", "default": "Taxes and shipping calculated at checkout." },
    { "type": "header", "content": "Empty state" },
    { "type": "text", "id": "empty_text", "label": "Empty message", "default": "A little adventure starts with a favourite tee. Find theirs and add it here." },
    { "type": "text", "id": "empty_cta", "label": "Empty button", "default": "Shop All Tees" },
