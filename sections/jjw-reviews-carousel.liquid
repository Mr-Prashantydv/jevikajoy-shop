{%- comment -%}
  JJW reviews carousel — mirrors Partake's `focus-carousel` section (measured
  docs/clone/raw/home.html ~L4262-4995): 3 stacked cards, centre slide full
  size, prev/next peeking at ~70% scale, per-slide saturated background +
  hard 8px 8px 0 offset shadow. Dots use JJW's 5 character face images
  instead of Partake's raw 200px photo dots.
  Reference: docs/clone/DESIGN-SYSTEM.md §9 row "focus-carousel" (H1019).
{%- endcomment -%}

{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
  assign blocks_size = section.blocks.size
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWReviews-{{ section.id }} .jjw-carousel {
    position: relative;
    margin-top: 40px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__stage {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 460px;
    overflow: hidden;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__slide {
    position: absolute;
    width: min(600px, 84vw);
    min-height: 320px;
    border-radius: 40px;
    padding: 44px 40px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    background: var(--slide-bg);
    color: var(--jjw-cream);
    box-shadow: 8px 8px 0 var(--slide-shadow);
    opacity: 0;
    transform: scale(0.7);
    transition: transform 0.4s cubic-bezier(0.25, 0.8, 0.25, 1), opacity 0.4s ease;
    z-index: 1;
    pointer-events: none;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__slide.is-active {
    opacity: 1;
    transform: scale(1) translateX(0);
    z-index: 3;
    pointer-events: auto;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__slide.is-prev {
    opacity: 1;
    transform: scale(0.72) translateX(-62%);
    z-index: 2;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__slide.is-next {
    opacity: 1;
    transform: scale(0.72) translateX(62%);
    z-index: 2;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__stars {
    font-size: 22px;
    letter-spacing: 4px;
    color: var(--jjw-yellow);
    margin-bottom: 16px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__quote {
    font-family: var(--jjw-font-sans);
    font-size: clamp(16px, 2.2vw, 20px);
    line-height: 1.5;
    margin: 0 0 20px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__author {
    font-family: var(--jjw-font-cond);
    font-style: normal;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-size: 18px;
    margin: 0;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__tag {
    margin-top: 10px;
    display: inline-block;
    padding: 6px 14px;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.22);
    font-family: var(--jjw-font-cond);
    font-size: 12px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__arrows {
    display: flex;
    justify-content: center;
    gap: 16px;
    margin-top: 28px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__arrow {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: none;
    background: var(--jjw-ink);
    color: var(--jjw-cream);
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    transition: background-color 0.2s var(--jjw-ease), transform 0.2s var(--jjw-ease);
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__arrow:hover {
    background: var(--jjw-pink);
    transform: translateY(-2px);
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__arrow svg {
    width: 18px;
    height: 18px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__arrow--next svg {
    transform: rotate(180deg);
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__dots {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 14px;
    margin-top: 24px;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__dot {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    padding: 0;
    border: 3px solid transparent;
    background: var(--jjw-cream);
    overflow: hidden;
    cursor: pointer;
    opacity: 0.55;
    transform: scale(0.85);
    transition: transform 0.2s var(--jjw-ease), opacity 0.2s var(--jjw-ease), border-color 0.2s var(--jjw-ease);
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__dot img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__dot:hover {
    opacity: 0.85;
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__dot.is-active {
    opacity: 1;
    transform: scale(1);
    border-color: var(--jjw-pink);
  }

  #JJWReviews-{{ section.id }} .jjw-carousel__empty {
    text-align: center;
    font-family: var(--jjw-font-sans);
    color: var(--jjw-ink);
    padding: 40px 0;
  }

  @media screen and (max-width: 749px) {
    #JJWReviews-{{ section.id }} .jjw-carousel__stage {
      min-height: 380px;
    }

    #JJWReviews-{{ section.id }} .jjw-carousel__slide {
      width: 82vw;
      min-height: 280px;
      padding: 32px 24px;
      border-radius: 28px;
    }

    #JJWReviews-{{ section.id }} .jjw-carousel__dot {
      width: 34px;
      height: 34px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #JJWReviews-{{ section.id }} .jjw-carousel__slide,
    #JJWReviews-{{ section.id }} .jjw-carousel__arrow,
    #JJWReviews-{{ section.id }} .jjw-carousel__dot {
      transition: none;
    }
  }
{%- endstyle -%}

<section id="JJWReviews-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-section__header {{ reveal }}">
      <h2 class="jjw-section__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {{ section.settings.heading_suffix }}
      </h2>
    </div>

    {%- if blocks_size > 0 -%}
      <div
        class="jjw-carousel {{ reveal }}"
        data-jjw-carousel
        role="region"
        aria-roledescription="carousel"
        aria-label="{{ section.settings.heading | strip_html | escape }}"
      >
        <div class="jjw-carousel__stage">
          {%- for block in section.blocks -%}
            {%- liquid
              assign state = ''
              if forloop.first
                assign state = 'is-active'
              elsif forloop.last and blocks_size > 1
                assign state = 'is-prev'
              elsif forloop.index0 == 1
                assign state = 'is-next'
              endif
              assign star_count = block.settings.stars | default: 5
            -%}
            <div
              class="jjw-carousel__slide {{ state }}"
              data-jjw-slide
              data-index="{{ forloop.index0 }}"
              style="--slide-bg: var(--jjw-{{ block.settings.color_pair }}); --slide-shadow: var(--jjw-{{ block.settings.color_pair }}-bg);"
              {% unless forloop.first %}aria-hidden="true"{% endunless %}
              {{ block.shopify_attributes }}
            >
              <div class="jjw-carousel__stars" aria-label="{{ star_count }} out of 5 stars">
                {%- for i in (1..star_count) -%}★{%- endfor -%}
              </div>
              <p class="jjw-carousel__quote">&ldquo;{{ block.settings.quote | escape }}&rdquo;</p>
              <p class="jjw-carousel__author">{{ block.settings.author | escape }}</p>
              {%- if block.settings.product_tag != blank -%}
                <span class="jjw-badge jjw-badge--new jjw-carousel__tag">{{ block.settings.product_tag | escape }}</span>
              {%- endif -%}
            </div>
          {%- endfor -%}
        </div>

        {%- if blocks_size > 1 -%}
          <div class="jjw-carousel__arrows">
            <button type="button" class="jjw-carousel__arrow jjw-carousel__arrow--prev" data-jjw-prev aria-label="Previous review">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
            <button type="button" class="jjw-carousel__arrow jjw-carousel__arrow--next" data-jjw-next aria-label="Next review">
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false">
                <path d="M15 5L8 12L15 19" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </button>
          </div>

          <div class="jjw-carousel__dots">
            {%- for block in section.blocks -%}
              {%- assign character = block.settings.character | default: 'jevika' -%}
              <button
                type="button"
                class="jjw-carousel__dot {% if forloop.first %}is-active{% endif %}"
                data-jjw-dot
                data-index="{{ forloop.index0 }}"
                aria-label="Show review {{ forloop.index }}"
                {% if forloop.first %}aria-current="true"{% endif %}
              >
                <img
                  src="{{ character | append: '-face.png' | asset_url }}"
                  alt=""
                  width="80"
                  height="80"
                  loading="lazy"
                >
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>
    {%- else -%}
      <p class="jjw-carousel__empty">{{ 'sections.reviews.empty' | t | default: 'Add review blocks to fill this carousel.' }}</p>
    {%- endif -%}
  </div>
</section>

{%- if blocks_size > 1 -%}
  <script>
    (function () {
      var root = document.getElementById('JJWReviews-{{ section.id }}');
      if (!root) return;
      var carousel = root.querySelector('[data-jjw-carousel]');
      if (!carousel) return;

      var slides = Array.prototype.slice.call(carousel.querySelectorAll('[data-jjw-slide]'));
      var dots = Array.prototype.slice.call(carousel.querySelectorAll('[data-jjw-dot]'));
      var prevButton = carousel.querySelector('[data-jjw-prev]');
      var nextButton = carousel.querySelector('[data-jjw-next]');
      var total = slides.length;
      var current = 0;

      function render() {
        slides.forEach(function (slide, index) {
          slide.classList.remove('is-active', 'is-prev', 'is-next');
          if (index === current) {
            slide.classList.add('is-active');
            slide.removeAttribute('aria-hidden');
          } else {
            slide.setAttribute('aria-hidden', 'true');
            if (index === (current - 1 + total) % total) {
              slide.classList.add('is-prev');
            } else if (index === (current + 1) % total) {
              slide.classList.add('is-next');
            }
          }
        });

        dots.forEach(function (dot, index) {
          var active = index === current;
          dot.classList.toggle('is-active', active);
          if (active) {
            dot.setAttribute('aria-current', 'true');
          } else {
            dot.removeAttribute('aria-current');
          }
        });
      }

      function goTo(index) {
        current = ((index % total) + total) % total;
        render();
      }

      if (prevButton) {
        prevButton.addEventListener('click', function () {
          goTo(current - 1);
        });
      }

      if (nextButton) {
        nextButton.addEventListener('click', function () {
          goTo(current + 1);
        });
      }

      dots.forEach(function (dot, index) {
        dot.addEventListener('click', function () {
          goTo(index);
        });
      });
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "JJW Reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Prefix",
      "default": "Loved by Families,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Word (Pink Cursive)",
      "default": "Trusted"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix",
      "default": "by Parents."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The organic cotton is so soft and the print hasn't faded after a dozen washes. My daughter wears hers every week."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Priya M."
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag (Optional)",
          "default": "Verified Parent"
        },
        {
          "type": "select",
          "id": "color_pair",
          "label": "Card color",
          "options": [
            { "value": "blue", "label": "Blue" },
            { "value": "gold", "label": "Gold" },
            { "value": "pink", "label": "Pink" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "blue"
        },
        {
          "type": "select",
          "id": "character",
          "label": "Dot character",
          "options": [
            { "value": "jevika", "label": "Jevika" },
            { "value": "joy", "label": "Joy" },
            { "value": "brutus", "label": "Brutus" },
            { "value": "minku", "label": "Minku" },
            { "value": "pinki", "label": "Pinki" }
          ],
          "default": "jevika"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JJW Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "The organic cotton is so soft and the Jevika print hasn't faded after a dozen washes. My daughter wears hers every week.",
            "author": "Priya M.",
            "product_tag": "Jevika Tee",
            "color_pair": "pink",
            "character": "jevika"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Finally, merch that's actually safe and certified. The organic cotton tees are buttery soft on my son's sensitive skin.",
            "author": "Ananya R.",
            "product_tag": "Organic Cotton",
            "color_pair": "blue",
            "character": "pinki"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Sizing runs true and the print quality is fantastic — no cracking, wash after wash. Ordered three more for his cousins.",
            "author": "Rahul K.",
            "product_tag": "True to Size",
            "color_pair": "gold",
            "character": "minku"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Got tees for both my twins — one Joy, one Brutus. The colors are still bright months later and the fabric feels premium.",
            "author": "Sneha D.",
            "product_tag": "Twin Pack",
            "color_pair": "green",
            "character": "joy"
          }
        }
      ]
    }
  ]
}
{% endschema %}
