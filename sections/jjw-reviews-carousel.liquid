{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWReviews-{{ section.id }} .jjw-reviews-track {
    padding-left: max(16px, env(safe-area-inset-left));
    padding-right: max(16px, env(safe-area-inset-right));
  }

  #JJWReviews-{{ section.id }} .jjw-review-card__footer {
    display: flex;
    flex-direction: column;
    gap: 4px;
    margin-top: auto;
  }

  #JJWReviews-{{ section.id }} .jjw-review-card__tag {
    margin-top: 6px;
    align-self: flex-start;
  }
{%- endstyle -%}

<section id="JJWReviews-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-section__header {{ reveal }}">
      <h2 class="jjw-section__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {{ section.settings.heading_suffix }}
      </h2>
    </div>

    <div class="jjw-reviews-track {{ reveal }}">
      {%- for block in section.blocks -%}
        <div class="jjw-review-card" {{ block.shopify_attributes }}>
          <div class="jjw-review-card__stars" aria-label="{{ block.settings.stars | default: 5 }} out of 5 stars">
            {%- assign star_count = block.settings.stars | default: 5 -%}
            {%- for i in (1..star_count) -%}★{%- endfor -%}
          </div>
          <p class="jjw-review-card__quote">
            &ldquo;{{ block.settings.quote | escape }}&rdquo;
          </p>
          <div class="jjw-review-card__footer">
            <div class="jjw-review-card__author">{{ block.settings.author | escape }}</div>
            <div class="jjw-review-card__verified">&#10003; Verified Buyer</div>
            {%- if block.settings.product_tag != blank -%}
              <span class="jjw-badge jjw-badge--new jjw-review-card__tag">{{ block.settings.product_tag | escape }}</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Reviews",
  "tag": "section",
  "class": "section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading Prefix",
      "default": "Loved by Families,"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Word (Pink Cursive)",
      "default": "Trusted"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix",
      "default": "by Parents."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        {
          "type": "range",
          "id": "stars",
          "min": 1,
          "max": 5,
          "step": 1,
          "label": "Stars Rating",
          "default": 5
        },
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "The organic cotton is so soft and the print hasn't faded after a dozen washes. My daughter wears hers every week."
        },
        {
          "type": "text",
          "id": "author",
          "label": "Author",
          "default": "Priya M."
        },
        {
          "type": "text",
          "id": "product_tag",
          "label": "Product Tag (Optional)",
          "default": "Verified Parent"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JJW Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "The organic cotton is so soft and the Jevika print hasn't faded after a dozen washes. My daughter wears hers every week.",
            "author": "Priya M.",
            "product_tag": "Jevika Tee"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Finally, merch that's actually safe and certified. The organic cotton tees are buttery soft on my son's sensitive skin.",
            "author": "Ananya R.",
            "product_tag": "Organic Cotton"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Sizing runs true and the print quality is fantastic — no cracking, wash after wash. Ordered three more for his cousins.",
            "author": "Rahul K.",
            "product_tag": "True to Size"
          }
        },
        {
          "type": "review",
          "settings": {
            "stars": 5,
            "quote": "Got tees for both my twins — one Joy, one Brutus. The colors are still bright months later and the fabric feels premium.",
            "author": "Sneha D.",
            "product_tag": "Twin Pack"
          }
        }
      ]
    }
  ]
}
{% endschema %}
