{%- comment -%}
  Multi-buy offer strip — announces the bundle discount on the PDP and in the
  cart. The discount itself is a Shopify automatic discount configured in
  admin; this section only tells the shopper it exists, because an automatic
  discount that nobody knows about changes no behaviour.

  All copy is settings, so the same section carries whatever the offer turns
  out to be without a code change. It renders nothing when the heading is
  blank, which is how the offer gets switched off.

  Every product in the catalogue is a flat Rs. 599 tee, so a quantity bundle
  fits this store better than a cross-sell upsell — parents buy tees in
  multiples, and there is no higher tier to trade up to.
{%- endcomment -%}

{%- if section.settings.heading != blank -%}
  {%- style -%}
    #BundleBanner-{{ section.id }} {
      background: var(--cream);
      padding-block: {{ section.settings.padding_top }}rem {{ section.settings.padding_bottom }}rem;
    }

    #BundleBanner-{{ section.id }} .bb__card {
      display: flex;
      align-items: center;
      justify-content: center;
      flex-wrap: wrap;
      gap: 1.2rem 2.4rem;
      padding: 2.4rem 3rem;
      background: var(--tone-bg, var(--gold-bg));
      border-radius: 2rem;
      text-align: center;
    }

    {%- comment -%}
      Navy on the fill, never the fill's own solid — Sunshine Gold type on
      Star Yellow is 1.50:1. The tints all carry --ink at 4.6:1 or better.
    {%- endcomment -%}
    #BundleBanner-{{ section.id }} .bb__heading {
      margin: 0;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 3.2rem;
      line-height: 1.1;
      letter-spacing: 0.12rem;
      text-transform: uppercase;
      color: var(--ink);
    }

    #BundleBanner-{{ section.id }} .bb__text {
      margin: 0;
      font-size: 1.7rem;
      line-height: 1.4;
      color: var(--ink);
    }

    #BundleBanner-{{ section.id }} .bb__note {
      display: block;
      margin-top: 0.4rem;
      font-size: 1.4rem;
      color: var(--ink-soft);
    }

    #BundleBanner-{{ section.id }} .bb__cta .btn {
      min-height: var(--touch-target);
      padding: 1.2rem 2.4rem;
      font-size: var(--button-text-size);
      --btn-bg: var(--ink);
      --btn-fg: var(--cream);
    }

    #BundleBanner-{{ section.id }} [data-tone='pink'] { --tone-bg: var(--pink-bg); }
    #BundleBanner-{{ section.id }} [data-tone='blue'] { --tone-bg: var(--blue-bg); }
    #BundleBanner-{{ section.id }} [data-tone='gold'] { --tone-bg: var(--gold-bg); }
    #BundleBanner-{{ section.id }} [data-tone='green'] { --tone-bg: var(--green-bg); }
    #BundleBanner-{{ section.id }} [data-tone='purple'] { --tone-bg: var(--purple-bg); }

    @media screen and (max-width: 749px) {
      #BundleBanner-{{ section.id }} .bb__card {
        flex-direction: column;
        padding: 2rem 1.6rem;
        gap: 1.2rem;
      }

      #BundleBanner-{{ section.id }} .bb__heading {
        font-size: 2.4rem;
      }

      #BundleBanner-{{ section.id }} .bb__text {
        font-size: 1.5rem;
      }
    }
  {%- endstyle -%}

  <section id="BundleBanner-{{ section.id }}">
    <div class="page-width">
      <div class="bb__card scroll-trigger animate--fade-in" data-tone="{{ section.settings.tone }}">
        <div>
          <h2 class="bb__heading">{{ section.settings.heading | escape }}</h2>
          {%- if section.settings.text != blank -%}
            <p class="bb__text">
              {{- section.settings.text | escape -}}
              {%- if section.settings.note != blank -%}
                <span class="bb__note">{{ section.settings.note | escape }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </div>

        {%- if section.settings.cta_label != blank -%}
          <span class="bb__cta btn-wrap">
            <span class="btn-shadow" aria-hidden="true"></span>
            <a class="btn" href="{{ section.settings.cta_url | default: routes.all_products_collection_url }}">
              {{- section.settings.cta_label | escape -}}
            </a>
          </span>
        {%- endif -%}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Bundle offer",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Offer headline",
      "info": "Leave blank to switch the offer off everywhere it appears.",
      "default": "Any 3 Tees for Rs. 1,499"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Supporting line",
      "default": "Mix any characters, any sizes — the discount applies at checkout."
    },
    {
      "type": "text",
      "id": "note",
      "label": "Small print",
      "default": "Saves Rs. 298 on three"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "Button label",
      "default": "Shop All Tees"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link",
      "info": "Defaults to all products."
    },
    {
      "type": "select",
      "id": "tone",
      "label": "Card colour",
      "options": [
        { "value": "gold", "label": "Star Yellow" },
        { "value": "pink", "label": "Candy Pink" },
        { "value": "blue", "label": "Sky Blue" },
        { "value": "green", "label": "Mint Green" },
        { "value": "purple", "label": "Lavender" }
      ],
      "default": "gold"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding top",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "default": 4
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding bottom",
      "min": 0,
      "max": 10,
      "step": 1,
      "unit": "rem",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Bundle offer"
    }
  ]
}
{% endschema %}
