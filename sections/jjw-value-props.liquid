{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  #JJWValueProps-{{ section.id }} {
    background-color: var(--jjw-peach);
  }

  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWValueProps-{{ section.id }} .jjw-value-item__icon {
    background: var(--jjw-white);
  }
{%- endstyle -%}

<section id="JJWValueProps-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-section__header {{ reveal }}">
      {%- if section.settings.eyebrow != blank -%}
        <div class="jjw-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      <h2 class="jjw-section__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
        {{ section.settings.heading_suffix }}
      </h2>
    </div>

    <div class="jjw-value-grid">
      <!-- Item 1 -->
      <div class="jjw-value-item {{ reveal }}" style="--animation-order: 0;">
        <div class="jjw-value-item__icon" aria-hidden="true">🛡️</div>
        <h3 class="jjw-value-item__title">BIS &amp; EN71 Certified</h3>
        <div class="jjw-value-item__desc">Lab-tested child-safe. 100% free of lead, phthalates, and sharp edges. Hypoallergenic materials safe for ages 3+.</div>
      </div>

      <!-- Item 2 -->
      <div class="jjw-value-item {{ reveal }}" style="--animation-order: 1;">
        <div class="jjw-value-item__icon" aria-hidden="true">📖</div>
        <h3 class="jjw-value-item__title">Zero Screen-Time Guilt</h3>
        <div class="jjw-value-item__desc">Every toy and book reinforces friendship, courage, and creative problem-solving &mdash; not algorithmic noise.</div>
      </div>

      <!-- Item 3 -->
      <div class="jjw-value-item {{ reveal }}" style="--animation-order: 2;">
        <div class="jjw-value-item__icon" aria-hidden="true">🧸</div>
        <h3 class="jjw-value-item__title">Uncompromising Craft</h3>
        <div class="jjw-value-item__desc">Handcrafted with premium 220 GSM organic cotton, OEKO-TEX certified water-based inks, and reinforced safety seams.</div>
      </div>

      <!-- Item 4 -->
      <div class="jjw-value-item {{ reveal }}" style="--animation-order: 3;">
        <div class="jjw-value-item__icon" aria-hidden="true">🌍</div>
        <h3 class="jjw-value-item__title">Mission Driven</h3>
        <div class="jjw-value-item__desc">Indian-born, values-first brand creating original 3D heroes that replace social media in kids' lives with story.</div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Value Props",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "WHY PARENTS CHOOSE JJW"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for Play."
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent Word (Pink Cursive)",
      "default": "Trusted"
    },
    {
      "type": "text",
      "id": "heading_suffix",
      "label": "Heading Suffix",
      "default": "by Parents."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Value Props"
    }
  ]
}
{% endschema %}
