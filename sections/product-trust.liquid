{%- comment -%}
  Compact reassurance below the collection catalogue. Each existing claim is
  rendered once; no feature-card grid, photography or duplicated marquee.
{%- endcomment -%}
{%- style -%}
  #ProductTrust-{{ section.id }} { background: var(--cream); }
  #ProductTrust-{{ section.id }} .pt__inner {
    display: flex;
    align-items: center;
    gap: 3.2rem;
    padding-block: 2.8rem;
  }
  #ProductTrust-{{ section.id }} .pt__intro { flex: 0 0 30rem; }
  #ProductTrust-{{ section.id }} .pt__heading {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
    font-size: var(--heading-small-size);
    line-height: 1.2;
    color: var(--ink);
  }
  #ProductTrust-{{ section.id }} .pt__strip {
    margin: 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--body-ink);
  }
  #ProductTrust-{{ section.id }} .pt__list {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  #ProductTrust-{{ section.id }} .pt__badge {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    max-width: 100%;
    font-size: var(--text-sm);
    font-weight: 600;
    line-height: 1.4;
    color: var(--ink);
  }
  #ProductTrust-{{ section.id }} .pt__icon {
    display: grid;
    place-items: center;
    flex: 0 0 2rem;
    height: 2rem;
    border-radius: 50%;
    background: var(--tone-bg, var(--sky));
  }
  #ProductTrust-{{ section.id }} .pt__icon img,
  #ProductTrust-{{ section.id }} .pt__icon svg { width: 1.4rem; height: 1.4rem; object-fit: contain; }
  #ProductTrust-{{ section.id }} [data-tone='pink'] { --tone-bg: var(--pink-bg); }
  #ProductTrust-{{ section.id }} [data-tone='blue'] { --tone-bg: var(--blue-bg); }
  #ProductTrust-{{ section.id }} [data-tone='gold'] { --tone-bg: var(--gold-bg); }
  #ProductTrust-{{ section.id }} [data-tone='green'] { --tone-bg: var(--green-bg); }
  #ProductTrust-{{ section.id }} [data-tone='purple'] { --tone-bg: var(--purple-bg); }
  @media screen and (max-width: 989px) {
    #ProductTrust-{{ section.id }} .pt__inner { align-items: flex-start; flex-direction: column; gap: 1.8rem; padding-block: 2.4rem; }
    #ProductTrust-{{ section.id }} .pt__intro { flex: none; }
    #ProductTrust-{{ section.id }} .pt__list { gap: 1rem 1.6rem; }
    #ProductTrust-{{ section.id }} .pt__heading { font-size: 2.4rem; }
  }
{%- endstyle -%}
<section id="ProductTrust-{{ section.id }}">
  <div class="page-width pt__inner">
    {%- if section.settings.heading != blank or section.settings.reassurance != blank -%}
    <div class="pt__intro">
    {%- if section.settings.heading != blank -%}
      <h2 class="pt__heading scroll-trigger animate--fade-in">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.reassurance != blank -%}
      <p class="pt__strip scroll-trigger animate--fade-in">{{ section.settings.reassurance | escape }}</p>
    {%- endif -%}
    </div>
    {%- endif -%}
    {%- if section.blocks.size > 0 -%}
      <ul class="pt__list">
        {%- for block in section.blocks -%}
          <li class="pt__badge scroll-trigger animate--fade-in" data-tone="{{ block.settings.tone | escape }}" style="--animation-order: {{ forloop.index0 }};" {{ block.shopify_attributes }}>
            <span class="pt__icon" aria-hidden="true">
              {%- if block.settings.image != blank -%}
                {{ block.settings.image | image_url: width: 88 | image_tag: loading: 'lazy', width: 44, height: 44, alt: '' }}
              {%- else -%}
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" focusable="false"><path d="m6 12 4 4 8-9"/></svg>
              {%- endif -%}
            </span>
            <span>{{ block.settings.label | escape }}</span>
          </li>
        {%- endfor -%}
      </ul>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Product trust",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave blank to hide.",
      "default": "Made to a standard you can check"
    },
    {
      "type": "text",
      "id": "reassurance",
      "label": "Reassurance line",
      "info": "Leave blank to hide.",
      "default": "Every tee is washed, checked and packed by hand before it reaches your little one."
    }
  ],
  "blocks": [
    {
      "type": "badge",
      "name": "Badge",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Badge image",
          "info": "Optional icon. Defaults to a check on a coloured circle."
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Skin Friendly"
        },
        {
          "type": "select",
          "id": "tone",
          "label": "Colour",
          "options": [
            { "value": "pink", "label": "Pink" },
            { "value": "blue", "label": "Blue" },
            { "value": "gold", "label": "Gold" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ],
          "default": "pink"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product trust",
      "blocks": [
        { "type": "badge", "settings": { "label": "BIS Certified", "tone": "blue" } },
        { "type": "badge", "settings": { "label": "100% Organic Cotton", "tone": "green" } },
        { "type": "badge", "settings": { "label": "OEKO-TEX Inks", "tone": "purple" } },
        { "type": "badge", "settings": { "label": "Skin Friendly", "tone": "pink" } },
        { "type": "badge", "settings": { "label": "Machine Washable", "tone": "gold" } }
      ]
    }
  ]
}
{% endschema %}
