{%- comment -%}
  Floating WhatsApp button. Lives in the footer group, which renders on every
  template just before </body>, so one instance covers the whole site.

  Renders nothing until a number is set — an empty button that opens
  wa.me/ with no recipient is worse than no button, so the guard is on the
  number rather than on a "show" checkbox.

  Colour: Outdoor Green from the brand sheet, not WhatsApp's own #25D366.
  Reference brands contribute the pattern, never the palette. Night navy on
  that green measures 5.51:1; cream would have been 2.62:1 and white 2.78:1,
  both under the 3:1 that a meaningful graphic needs. The glyph shape is what
  makes it recognisable, not the exact hue.
{%- endcomment -%}

{%- liquid
  comment
    wa.me wants digits only — no +, spaces, brackets or dashes — so strip the
    ways a phone number is normally written rather than making the merchant
    format it correctly.
  endcomment
  comment
    Kept on one line on purpose. Inside a liquid tag every line is its own
    statement, so a filter chain wrapped across lines parses as unknown tags.
    Do not write percent-brace markup in here either — it closes the tag early.
  endcomment
  assign wa_number = section.settings.number | remove: '+' | remove: ' ' | remove: '-' | remove: '(' | remove: ')' | strip
-%}

{%- if wa_number != blank -%}
  {%- style -%}
    #Whatsapp-{{ section.id }} {
      position: fixed;
      right: 2rem;
      bottom: 2rem;
      {%- comment -%}
        Below the header overlay's z-index of 10, so opening the menu or the
        search panel covers this rather than leaving it floating over the scrim.
      {%- endcomment -%}
      z-index: 8;
      display: flex;
      align-items: center;
      gap: 1.2rem;
      height: 5.6rem;
      padding-inline: 1.8rem;
      color: var(--ink-deep);
      background: var(--green);
      border-radius: 999px;
      box-shadow: 0 0.4rem 1.6rem rgba(16, 36, 74, 0.28);
      transition: transform 0.2s var(--ease);
    }

    #Whatsapp-{{ section.id }} svg {
      flex: none;
      height: 2.8rem;
      width: 2.8rem;
    }

    #Whatsapp-{{ section.id }} .wa__label {
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 2rem;
      line-height: 1;
      letter-spacing: 0.1rem;
      text-transform: uppercase;
      white-space: nowrap;
    }

    @media (hover: hover) and (prefers-reduced-motion: no-preference) {
      #Whatsapp-{{ section.id }}:hover {
        transform: translateY(-3px);
      }
    }

    {%- comment -%}
      Collapse to a circle on phones. A pill with a label eats the width the
      cart and search controls need, and the glyph alone is understood.
    {%- endcomment -%}
    @media screen and (max-width: 749px) {
      #Whatsapp-{{ section.id }} {
        right: 1.5rem;
        /* Lifted clear of the PDP's sticky buy bar, which is fixed to the
           bottom on phones at z-index 9 — one above this bubble's 8, so
           without the offset the bar would sit over the bubble and the
           bubble's tail would poke out from behind it. The var is unset on
           every other template, where this falls back to the plain 1.5rem. */
        bottom: calc(1.5rem + var(--jjw-sticky-atc-offset, 0px));
        height: 5.2rem;
        width: 5.2rem;
        padding-inline: 0;
        justify-content: center;
      }

      #Whatsapp-{{ section.id }} .wa__label {
        display: none;
      }
    }
  {%- endstyle -%}

  <a
    id="Whatsapp-{{ section.id }}"
    href="https://wa.me/{{ wa_number }}{% if section.settings.message != blank %}?text={{ section.settings.message | url_encode }}{% endif %}"
    target="_blank"
    rel="noopener"
    aria-label="{{ section.settings.label | default: 'Chat on WhatsApp' | escape }}"
  >
    <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
      <path d="M12.04 2c-5.46 0-9.91 4.45-9.91 9.91 0 1.75.46 3.45 1.32 4.95L2.05 22l5.25-1.38a9.9 9.9 0 0 0 4.74 1.21h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2m0 1.67c2.2 0 4.27.86 5.83 2.42a8.2 8.2 0 0 1 2.41 5.83c0 4.54-3.7 8.24-8.25 8.24a8.2 8.2 0 0 1-4.2-1.15l-.3-.18-3.12.82.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.38c0-4.54 3.7-8.25 8.26-8.25M8.53 7.33c-.16 0-.43.06-.66.31-.22.25-.87.85-.87 2.07s.89 2.4 1.02 2.56c.12.17 1.75 2.67 4.23 3.74.59.26 1.05.41 1.41.52.59.19 1.13.16 1.56.1.48-.07 1.46-.6 1.67-1.18s.21-1.07.15-1.18c-.07-.1-.23-.16-.48-.28s-1.47-.72-1.69-.8c-.23-.09-.39-.13-.56.12s-.64.81-.78.97c-.14.17-.29.19-.53.07-.25-.13-1.06-.39-2.02-1.24-.74-.67-1.25-1.49-1.4-1.74s-.02-.38.11-.51c.11-.11.25-.29.37-.44s.17-.25.25-.41c.08-.17.04-.31-.02-.43s-.56-1.34-.76-1.84c-.2-.48-.4-.42-.56-.43z"/>
    </svg>
    <span class="wa__label">{{ section.settings.label | default: 'Chat with us' | escape }}</span>
  </a>
{%- endif -%}

{% schema %}
{
  "name": "WhatsApp button",
  "enabled_on": { "groups": ["footer"] },
  "settings": [
    {
      "type": "text",
      "id": "number",
      "label": "WhatsApp number",
      "info": "Country code first, no plus sign — e.g. 919876543210 for India. Leave blank to hide the button."
    },
    {
      "type": "text",
      "id": "label",
      "label": "Button label",
      "info": "Hidden on phones, where the button collapses to a circle.",
      "default": "Chat with us"
    },
    {
      "type": "textarea",
      "id": "message",
      "label": "Pre-filled message",
      "info": "Sent as the first message so you know which page they came from.",
      "default": "Hi! I have a question about a JJW tee."
    }
  ],
  "presets": [
    {
      "name": "WhatsApp button"
    }
  ]
}
{% endschema %}
