{%- liquid
  assign reveal = ''
  if settings.animations_reveal_on_scroll
    assign reveal = 'scroll-trigger animate--slide-in'
  endif
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWPressLogos-{{ section.id }} .jjw-press-heading {
    text-align: center;
    font-family: var(--font-body);
    font-size: 0.8125rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--jjw-ink-light);
    margin-bottom: 24px;
  }

  #JJWPressLogos-{{ section.id }} .jjw-press-empty {
    text-align: center;
    font-size: 0.875rem;
    color: var(--jjw-ink-light);
    font-style: italic;
    margin: 0;
    padding: 12px 0;
  }
{%- endstyle -%}

<section id="JJWPressLogos-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    {%- if section.settings.heading != blank -%}
      <div class="jjw-press-heading {{ reveal }}">
        {{ section.settings.heading }}
      </div>
    {%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="jjw-press-row {{ reveal }}">
        {%- for block in section.blocks -%}
          <div class="jjw-press-logo" {{ block.shopify_attributes }}>
            {%- if block.settings.image != blank -%}
              {{
                block.settings.image
                | image_url: height: 72
                | image_tag:
                  loading: 'lazy',
                  height: 36,
                  alt: block.settings.alt_text | default: block.settings.image.alt | default: 'Press logo' | escape
              }}
            {%- else -%}
              <span class="jjw-press-logo-placeholder">{{ 'Logo ' | append: forloop.index }}</span>
            {%- endif -%}
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <p class="jjw-press-empty">Add press &amp; partner logos in the Theme Editor</p>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "JJW Press Logos",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "As Featured In"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 36
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 36
    }
  ],
  "blocks": [
    {
      "type": "logo",
      "name": "Logo",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Logo Image"
        },
        {
          "type": "text",
          "id": "alt_text",
          "label": "Alt text"
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "JJW Press Logos"
    }
  ]
}
{% endschema %}
