{%- comment -%}
  JJW social icons — mirrors Partake's `social-icons` section (§9 row 11, H152, cream field).
  Centred row of 80px solid-color circles, gap 15px, each holding a platform SVG.
  Icons come from assets/icon-*.svg via the theme's own `inline_asset_content` filter —
  same approach as snippets/social-icons.liquid. Block-driven so merchants pick platform + URL.
  Reference: docs/clone/DESIGN-SYSTEM.md §9 row 11.
{%- endcomment -%}

{%- style -%}
  #JJWSocialIcons-{{ section.id }} .jjw-social-icons {
    background-color: {{ section.settings.bg_color }};
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #JJWSocialIcons-{{ section.id }} .jjw-social-icons__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 15px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #JJWSocialIcons-{{ section.id }} .jjw-social-icons__link {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 80px;
    height: 80px;
    border-radius: 50%;
    background-color: {{ section.settings.circle_color }};
    transition: transform 0.3s;
  }

  #JJWSocialIcons-{{ section.id }} .jjw-social-icons__link .icon {
    width: 32px;
    height: 32px;
    fill: {{ section.settings.icon_color }};
    color: {{ section.settings.icon_color }};
  }

  @media (hover: hover) {
    #JJWSocialIcons-{{ section.id }} .jjw-social-icons__link:hover {
      transform: scale(1.1);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #JJWSocialIcons-{{ section.id }} .jjw-social-icons__link {
      transition: none;
    }
    #JJWSocialIcons-{{ section.id }} .jjw-social-icons__link:hover {
      transform: none;
    }
  }
{%- endstyle -%}

<section id="JJWSocialIcons-{{ section.id }}">
  <div class="jjw-social-icons page-width">
    <ul class="jjw-social-icons__list" role="list">
      {%- for block in section.blocks -%}
        {%- liquid
          assign platform = block.settings.platform
          assign icon_file = 'icon-' | append: platform | append: '.svg'
        -%}
        <li class="jjw-social-icons__item" {{ block.shopify_attributes }}>
          {%- if block.settings.url != blank -%}
            <a href="{{ block.settings.url }}" class="jjw-social-icons__link" target="_blank" rel="noopener">
              <span class="svg-wrapper">{{- icon_file | inline_asset_content -}}</span>
              <span class="visually-hidden">{{ platform | capitalize }}</span>
            </a>
          {%- else -%}
            <span class="jjw-social-icons__link">
              <span class="svg-wrapper">{{- icon_file | inline_asset_content -}}</span>
              <span class="visually-hidden">{{ platform | capitalize }}</span>
            </span>
          {%- endif -%}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "JJW social icons",
  "tag": "section",
  "settings": [
    { "type": "color", "id": "bg_color", "label": "Background", "default": "#FFF6EB" },
    { "type": "color", "id": "circle_color", "label": "Circle color", "default": "#1A2F5E" },
    { "type": "color", "id": "icon_color", "label": "Icon color", "default": "#FFF6EB" },
    { "type": "range", "id": "padding_top", "label": "Padding top",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 },
    { "type": "range", "id": "padding_bottom", "label": "Padding bottom",
      "min": 0, "max": 100, "step": 4, "unit": "px", "default": 36 }
  ],
  "blocks": [
    { "type": "icon", "name": "Icon", "limit": 8,
      "settings": [
        { "type": "select", "id": "platform", "label": "Platform",
          "options": [
            { "value": "instagram", "label": "Instagram" },
            { "value": "facebook", "label": "Facebook" },
            { "value": "tiktok", "label": "TikTok" },
            { "value": "youtube", "label": "YouTube" },
            { "value": "pinterest", "label": "Pinterest" }
          ],
          "default": "instagram" },
        { "type": "url", "id": "url", "label": "Link" }
      ]
    }
  ],
  "presets": [
    { "name": "JJW social icons",
      "blocks": [
        { "type": "icon", "settings": { "platform": "instagram" } },
        { "type": "icon", "settings": { "platform": "facebook" } },
        { "type": "icon", "settings": { "platform": "tiktok" } },
        { "type": "icon", "settings": { "platform": "youtube" } }
      ]
    }
  ]
}
{% endschema %}
