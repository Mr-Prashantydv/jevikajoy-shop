{%- style -%}
  #JJWCategoryGrid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #JJWCategoryGrid-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .jjw-category-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 20px;
  }

  @media screen and (min-width: 750px) {
    .jjw-category-grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 24px;
    }
  }

  .jjw-cat-tile {
    border-radius: var(--jjw-radius-card);
    background: var(--tile-bg, var(--jjw-cream));
    padding: 22px 20px;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .jjw-cat-tile__title {
    font-family: var(--jjw-font-display);
    font-size: clamp(18px, 1.8vw, 24px);
    color: var(--jjw-ink);
    margin: 0;
  }

  .jjw-cat-tile__chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .jjw-cat-tile__chips a.jjw-chip {
    text-decoration: none;
  }

  .jjw-cat-tile__chips img {
    width: 20px;
    height: 20px;
    border-radius: 50%;
    object-fit: cover;
    margin-right: 2px;
  }
{%- endstyle -%}

<section id="JJWCategoryGrid-{{ section.id }}" class="jjw-category-grid-section">
  <div class="page-width">
    <!-- Centered Section Header -->
    <div class="jjw-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="jjw-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      <h2 class="jjw-section__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="jjw-section__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <!-- Shop-by Grid: Character / Gender / Age / Color -->
    <div class="jjw-category-grid">
      <!-- 1. Shop by Character -->
      <div class="jjw-cat-tile" style="--tile-bg: var(--jjw-pink-bg);">
        <h3 class="jjw-cat-tile__title">Shop by Character</h3>
        <div class="jjw-cat-tile__chips">
          <a href="{{ routes.collections_url }}/jevika" class="jjw-chip" style="--chip-fg: #E5377E;"><img src="{{ 'jevika-face.png' | asset_url }}" alt="" loading="lazy">Jevika</a>
          <a href="{{ routes.collections_url }}/joy" class="jjw-chip" style="--chip-fg: #F68B1F;"><img src="{{ 'joy-face.png' | asset_url }}" alt="" loading="lazy">Joy</a>
          <a href="{{ routes.collections_url }}/pinki" class="jjw-chip" style="--chip-fg: #0F7DAF;"><img src="{{ 'pinki-face.png' | asset_url }}" alt="" loading="lazy">Pinki</a>
          <a href="{{ routes.collections_url }}/minku" class="jjw-chip" style="--chip-fg: #2FA85E;"><img src="{{ 'minku-face.png' | asset_url }}" alt="" loading="lazy">Minku</a>
          <a href="{{ routes.collections_url }}/brutus" class="jjw-chip" style="--chip-fg: #6E55D6;"><img src="{{ 'brutus-face.png' | asset_url }}" alt="" loading="lazy">Brutus</a>
        </div>
      </div>

      <!-- 2. Shop by Gender -->
      <div class="jjw-cat-tile" style="--tile-bg: var(--jjw-blue-bg);">
        <h3 class="jjw-cat-tile__title">Shop by Gender</h3>
        <div class="jjw-cat-tile__chips">
          <a href="{{ routes.collections_url }}/boys" class="jjw-chip" style="--chip-fg: var(--jjw-blue);">Boys</a>
          <a href="{{ routes.collections_url }}/girls" class="jjw-chip" style="--chip-fg: var(--jjw-blue);">Girls</a>
        </div>
      </div>

      <!-- 3. Shop by Age -->
      <div class="jjw-cat-tile" style="--tile-bg: var(--jjw-gold-bg);">
        <h3 class="jjw-cat-tile__title">Shop by Age</h3>
        <div class="jjw-cat-tile__chips">
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.age=4-5+Y" class="jjw-chip" style="--chip-fg: var(--jjw-gold);">4–5 Y</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.age=6-7+Y" class="jjw-chip" style="--chip-fg: var(--jjw-gold);">6–7 Y</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.age=8-9+Y" class="jjw-chip" style="--chip-fg: var(--jjw-gold);">8–9 Y</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.age=10-12+Y" class="jjw-chip" style="--chip-fg: var(--jjw-gold);">10–12 Y</a>
        </div>
      </div>

      <!-- 4. Shop by Color -->
      <div class="jjw-cat-tile" style="--tile-bg: var(--jjw-purple-bg);">
        <h3 class="jjw-cat-tile__title">Shop by Color</h3>
        <div class="jjw-cat-tile__chips">
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.color=Black" class="jjw-chip" style="--chip-fg: var(--jjw-purple);">Black</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.color=Blue" class="jjw-chip" style="--chip-fg: var(--jjw-purple);">Blue</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.color=White" class="jjw-chip" style="--chip-fg: var(--jjw-purple);">White</a>
          <a href="{{ routes.all_products_collection_url }}?filter.v.option.color=Pink" class="jjw-chip" style="--chip-fg: var(--jjw-purple);">Pink</a>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Category Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "THE JJW SHOP"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop By"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent (Pink)",
      "default": "Whatever You Love"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Find your tee by character, age, color, or who it's for."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Category Grid"
    }
  ]
}
{% endschema %}
