{%- style -%}
  #JJWCategoryGrid-{{ section.id }} {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #JJWCategoryGrid-{{ section.id }} {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  .jjw-category-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
    gap: 24px;
  }

  @media screen and (max-width: 749px) {
    .jjw-category-grid {
      grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
      gap: 16px;
    }

    .jjw-cat-card {
      padding: 24px 16px;
    }

    .jjw-cat-card__icon {
      font-size: 2.75rem;
      margin-bottom: 12px;
    }

    .jjw-cat-card__title {
      font-size: 1.1rem;
    }
  }
{%- endstyle -%}

<section id="JJWCategoryGrid-{{ section.id }}" class="jjw-category-grid-section">
  <div class="page-width">
    <!-- Centered Section Header -->
    <div class="jjw-section__header">
      {%- if section.settings.eyebrow != blank -%}
        <div class="jjw-eyebrow">{{ section.settings.eyebrow }}</div>
      {%- endif -%}

      <h2 class="jjw-section__title">
        {{ section.settings.heading }}
        {%- if section.settings.heading_accent != blank -%}
          <span class="jjw-accent">{{ section.settings.heading_accent }}</span>
        {%- endif -%}
      </h2>

      {%- if section.settings.subtitle != blank -%}
        <p class="jjw-section__subtitle">
          {{ section.settings.subtitle }}
        </p>
      {%- endif -%}
    </div>

    <!-- Category Grid Cards -->
    <div class="jjw-category-grid">
      <!-- 1. Character Plushies -->
      <a href="{{ routes.collections_url }}/plushies" class="jjw-cat-card" style="background-color: #FFE5EE;">
        <div class="jjw-cat-card__icon" aria-hidden="true">🧸</div>
        <h3 class="jjw-cat-card__title">Character Plushies</h3>
        <span class="jjw-cat-card__link">Shop Now &rarr;</span>
      </a>

      <!-- 2. Bedtime Storybooks -->
      <a href="{{ routes.collections_url }}/storybooks" class="jjw-cat-card" style="background-color: #FFF2D6;">
        <div class="jjw-cat-card__icon" aria-hidden="true">📚</div>
        <h3 class="jjw-cat-card__title">Bedtime Storybooks</h3>
        <span class="jjw-cat-card__link">Shop Now &rarr;</span>
      </a>

      <!-- 3. Story Apparel -->
      <a href="{{ routes.collections_url }}/apparel" class="jjw-cat-card" style="background-color: #E0F4FC;">
        <div class="jjw-cat-card__icon" aria-hidden="true">👕</div>
        <h3 class="jjw-cat-card__title">Story Apparel</h3>
        <span class="jjw-cat-card__link">Shop Now &rarr;</span>
      </a>

      <!-- 4. Activity & Stationery -->
      <a href="{{ routes.collections_url }}/stationery" class="jjw-cat-card" style="background-color: #E4F9EC;">
        <div class="jjw-cat-card__icon" aria-hidden="true">🎨</div>
        <h3 class="jjw-cat-card__title">Activity &amp; Stationery</h3>
        <span class="jjw-cat-card__link">Shop Now &rarr;</span>
      </a>

      <!-- 5. Gift Sets & Bundles -->
      <a href="{{ routes.collections_url }}/bundles" class="jjw-cat-card" style="background-color: #EFEAFF;">
        <div class="jjw-cat-card__icon" aria-hidden="true">🎁</div>
        <h3 class="jjw-cat-card__title">Gift Sets &amp; Bundles</h3>
        <span class="jjw-cat-card__link">Shop Now &rarr;</span>
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Category Grid",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow Text",
      "default": "PREMIUM MERCHANDISE"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Explore Our"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading Accent (Pink)",
      "default": "Goodies"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Handcrafted plushies, bedtime adventures, organic apparel, and mindful stationery made for young imaginations."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top Padding",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom Padding",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "JJW Category Grid"
    }
  ]
}
{% endschema %}
