{%- comment -%}
  Shared footer: compact logo, shopping and merchant menus, published policies,
  and newsletter. Empty icon blocks take no space.
{%- endcomment -%}

{%- style -%}
  #Footer-{{ section.id }} {
    background: var(--ink);
    color: color-mix(in srgb, var(--cream) 75%, transparent);
    margin-bottom: 2.6rem;
  }

  #Footer-{{ section.id }} .footer__inner {
    padding-top: 4.8rem;
    padding-bottom: 4rem;
  }

  #Footer-{{ section.id }} .footer__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: 3.2rem;
  }

  #Footer-{{ section.id }} .footer__logo {
    grid-column: span 3;
  }

  #Footer-{{ section.id }} .footer__logo img {
    /* Letters + name pill, no tagline: the tagline's navy words vanish on this
       navy footer. The art is 3:2, so narrower than the old 2:1 mark's 32rem. */
    width: 18rem;
    max-width: 100%;
    height: auto;
  }

  #Footer-{{ section.id }} .footer__spacer {
    grid-column: span 9;
    height: 5.2rem;
    display: none;
  }

  #Footer-{{ section.id }} .footer__nav {
    grid-column: span 4;
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem 2.4rem;
  }

  #Footer-{{ section.id }} .footer__menu {
    flex: 1 1 14rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #Footer-{{ section.id }} .footer__item {
    padding-block: 0.53rem;
  }

  #Footer-{{ section.id }} .footer__item:first-child {
    padding-top: 0;
    padding-bottom: 0.56rem;
  }

  #Footer-{{ section.id }} .footer__link {
    display: block;
    min-height: var(--touch-target);
    padding: 1.1rem 0;
    font-family: var(--font-body);
    font-size: var(--control-text-size);
    font-weight: 600;
    line-height: 1.4;
    color: var(--cream);
    transition: color 0.2s var(--ease);
    text-transform: none;
    letter-spacing: 0;
  }

  #Footer-{{ section.id }} .footer__link:hover {
    color: #fff;
  }

  #Footer-{{ section.id }} .footer__newsletter {
    grid-column: span 5;
  }

  #Footer-{{ section.id }} .footer__heading {
    margin: 0;
    font-size: 3rem;
    line-height: 1.2;
    color: var(--cream);
    font-family: var(--font-heading);
    font-weight: 800;
    text-transform: none;
    letter-spacing: 0;
  }

  /* Newsletter description is ordinary body copy. */
  #Footer-{{ section.id }} .footer__text {
    margin: 1.25rem 0;
    max-width: 46rem;
    font-size: var(--text-base);
    line-height: 1.6;
    color: var(--cream);
  }

  #Footer-{{ section.id }} .footer__form {
    max-width: 46rem;
    margin: 0;
  }

  #Footer-{{ section.id }} .footer__message {
    margin: 0 0 1rem;
    font-size: 1.6rem;
    line-height: 2.2rem;
    color: var(--cream);
  }

  #Footer-{{ section.id }} .footer__field {
    position: relative;
    display: flex;
    height: 5.2rem;
    align-items: center;
    border-bottom: 2px solid color-mix(in srgb, var(--cream) 50%, transparent);
    transition: border-color 0.2s var(--ease);
    background: var(--white);
    border: 2px solid var(--white);
    border-radius: 1.2rem;
  }

  #Footer-{{ section.id }} .footer__field:focus-within {
    border-bottom-color: var(--cream);
  }

  #Footer-{{ section.id }} .footer__input {
    width: 100%;
    flex: 1 1 auto;
    padding: 1.2rem 5.6rem 1.2rem 1.4rem;
    border: 0;
    background: transparent;
    font-family: var(--font-body);
    font-size: 1.6rem;
    line-height: 1;
    color: var(--ink);
    border-radius: 1rem;
  }

  #Footer-{{ section.id }} .footer__input::placeholder {
    color: var(--ink-soft);
  }

  #Footer-{{ section.id }} .footer__submit {
    position: absolute;
    top: 50%;
    right: 0.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    /* The icon is 24px wide; the button needs to be a finger wide. */
    min-width: 4.4rem;
    height: 4.4rem;
    padding: 0;
    color: var(--ink);
    transform: translateY(-50%);
    transition: transform 0.2s var(--ease);
    width: 4.4rem;
    background: var(--gold);
    border-radius: 0.8rem;
  }

  #Footer-{{ section.id }} .footer__submit:hover {
    transform: translateY(-50%);
    background: var(--yellow);
  }

  #Footer-{{ section.id }} .footer__submit svg {
    height: 1.6rem;
    width: 2.4rem;
  }

  #Footer-{{ section.id }} .footer__icons {
    grid-column: span 6;
  }

  #Footer-{{ section.id }} .footer__icons-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 2rem;
    padding-block: 2rem;
  }

  #Footer-{{ section.id }} .footer__icons-row img {
    max-height: 6rem;
    width: auto;
  }

  #Footer-{{ section.id }} .footer__icons-empty {
    grid-column: span 6;
    height: 4rem;
    display: none;
  }

  #Footer-{{ section.id }} .footer__credits {
    margin-top: 2.25rem;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 2rem;
  }

  #Footer-{{ section.id }} .footer__credit {
    /* 25px of line-height alone is a 25px link; the padding makes it 44px. */
    display: inline-block;
    padding: 0.95rem 0;
    font-size: 1.4rem;
    line-height: 2.5rem;
    /* Footer field is --ink; credit text must be the light tone, not the same colour. */
    color: var(--cream);
    transition: color 0.2s var(--ease);
  }

  #Footer-{{ section.id }} a.footer__credit:hover {
    text-decoration: underline;
  }

  @media screen and (min-width: 750px) and (max-width: 1099px) {
    #Footer-{{ section.id }} .footer__logo { grid-column: span 2; }
    #Footer-{{ section.id }} .footer__nav { grid-column: span 4; }
    #Footer-{{ section.id }} .footer__newsletter { grid-column: span 6; }
  }

  @media screen and (max-width: 749px) {
    #Footer-{{ section.id }} {
      margin-bottom: 0;
    }

    #Footer-{{ section.id }} .footer__inner {
      padding-top: 2rem;
      padding-bottom: 2rem;
    }

    #Footer-{{ section.id }} .footer__grid {
      gap: 2rem;
    }

    #Footer-{{ section.id }} .footer__logo,
    #Footer-{{ section.id }} .footer__nav,
    #Footer-{{ section.id }} .footer__newsletter,
    #Footer-{{ section.id }} .footer__icons,
    #Footer-{{ section.id }} .footer__icons-empty {
      grid-column: span 12;
    }

    #Footer-{{ section.id }} .footer__nav {
      gap: 2rem;
    }

    #Footer-{{ section.id }} .footer__spacer {
      display: none;
    }
  }
{%- endstyle -%}

{%- assign icon_blocks = section.blocks | where: 'type', 'icon' -%}

<footer id="Footer-{{ section.id }}">
  <div class="page-width footer__inner">
    <div class="footer__grid">
      <div class="footer__logo">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 640
            | image_tag: loading: 'lazy', widths: '320, 480, 640', alt: shop.name
          }}
        {%- else -%}
          <img
            src="{{ 'jjw-logo-lockup.webp' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="720"
            height="486"
            loading="lazy"
          >
        {%- endif -%}
      </div>

      <nav class="footer__nav" aria-label="{{ section.settings.nav_label | escape }}">
        {%- if section.settings.show_quick_links -%}
          <ul class="footer__menu">
            <li class="footer__item"><a class="footer__link" href="{{ routes.all_products_collection_url }}">{{ section.settings.shop_label | escape }}</a></li>
            <li class="footer__item"><a class="footer__link" href="{{ routes.collections_url }}">{{ section.settings.characters_label | escape }}</a></li>
            {%- if pages.contact != blank -%}
              <li class="footer__item"><a class="footer__link" href="{{ pages.contact.url }}">{{ section.settings.contact_label | escape }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}
        {%- for block in section.blocks -%}
          {%- if block.type == 'menu' and block.settings.menu != blank -%}
            <ul class="footer__menu" {{ block.shopify_attributes }}>
              {%- for link in block.settings.menu.links -%}
                <li class="footer__item">
                  <a class="accent-caps footer__link" href="{{ link.url }}">{{ link.title }}</a>
                </li>
              {%- endfor -%}
            </ul>
          {%- endif -%}
        {%- endfor -%}
        {%- if section.settings.show_policies and shop.policies.size > 0 -%}
          <ul class="footer__menu">
            {%- for policy in shop.policies -%}
              {%- if policy.body != blank -%}
                <li class="footer__item"><a class="footer__link" href="{{ policy.url }}">{{ policy.title | escape }}</a></li>
              {%- endif -%}
            {%- endfor -%}
          </ul>
        {%- endif -%}
      </nav>

      <div class="footer__newsletter">
        {%- if section.settings.newsletter_heading != blank -%}
          <h2 class="accent-caps footer__heading">{{ section.settings.newsletter_heading }}</h2>
        {%- endif -%}

        {%- if section.settings.newsletter_text != blank -%}
          <p class="footer__text">{{ section.settings.newsletter_text }}</p>
        {%- endif -%}

        {%- form 'customer', id: 'ContactFooter', class: 'footer__form' -%}
          <input type="hidden" name="contact[tags]" value="newsletter">

          {%- if form.posted_successfully? -%}
            <p class="footer__message">{{ section.settings.newsletter_success }}</p>
          {%- elsif form.errors -%}
            <p class="footer__message">{{ form.errors.messages['email'] }}</p>
          {%- endif -%}

          <div class="footer__field">
            <input
              class="footer__input"
              type="email"
              name="contact[email]"
              id="ContactFooter-email-{{ section.id }}"
              value="{{ form.email }}"
              autocomplete="email"
              autocorrect="off"
              autocapitalize="off"
              required
              placeholder="{{ section.settings.newsletter_placeholder | escape }}"
              aria-label="{{ section.settings.newsletter_placeholder | escape }}"
            >
            <button class="footer__submit" type="submit" aria-label="{{ section.settings.subscribe_label | escape }}">
              <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 14 10" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M10.28.22a.75.75 0 0 1 1.06 0l2.5 2.5a.75.75 0 0 1 0 1.06l-2.5 2.5a.75.75 0 1 1-1.06-1.06l1.22-1.22H.75a.75.75 0 0 1 0-1.5h10.75L10.28 1.28a.75.75 0 0 1 0-1.06ZM1.5 8.25a.75.75 0 0 1 1.06 0l2.5 2.5a.75.75 0 0 1 0 1.06l-2.5 2.5a.75.75 0 0 1-1.06-1.06l1.22-1.22H.75a.75.75 0 0 1 0-1.5h10.75l-1.22-1.22a.75.75 0 0 1 0-1.06Z"
                  transform="translate(0 -2)"
                />
              </svg>
            </button>
          </div>
        {%- endform -%}
      </div>

      {%- if section.settings.show_icons and icon_blocks.size > 0 -%}
        <div class="footer__icons">
          <div class="footer__icons-row">
            {%- for block in icon_blocks -%}
              {%- if block.settings.image != blank -%}
                <div {{ block.shopify_attributes }}>
                  {{
                    block.settings.image
                    | image_url: width: 240
                    | image_tag: loading: 'lazy', widths: '60, 120, 240', alt: block.settings.image.alt
                  }}
                </div>
              {%- endif -%}
            {%- endfor -%}
          </div>
        </div>
      {%- else -%}
        <div class="footer__icons-empty" aria-hidden="true"></div>
      {%- endif -%}
    </div>

    {%- comment -%}
      Credits ship empty: the old defaults named the reference site's agencies. A label with
      no link renders as plain text rather than a dead '#' link.
    {%- endcomment -%}
    {%- if section.settings.credit_one_label != blank or section.settings.credit_two_label != blank -%}
      <div class="page-width footer__credits">
        {%- if section.settings.credit_one_label != blank -%}
          {%- if section.settings.credit_one_link != blank -%}
            <a
              class="accent-caps footer__credit"
              href="{{ section.settings.credit_one_link }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ section.settings.credit_one_label }}
            </a>
          {%- else -%}
            <span class="accent-caps footer__credit">{{ section.settings.credit_one_label }}</span>
          {%- endif -%}
        {%- endif -%}

        {%- if section.settings.credit_two_label != blank -%}
          {%- if section.settings.credit_two_link != blank -%}
            <a
              class="accent-caps footer__credit"
              href="{{ section.settings.credit_two_link }}"
              target="_blank"
              rel="noopener noreferrer"
            >
              {{ section.settings.credit_two_label }}
            </a>
          {%- else -%}
            <span class="accent-caps footer__credit">{{ section.settings.credit_two_label }}</span>
          {%- endif -%}
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": [
    { "type": "text", "id": "nav_label", "label": "Navigation accessible label", "default": "Footer" },
    { "type": "checkbox", "id": "show_quick_links", "label": "Show shopping links", "default": true },
    { "type": "text", "id": "shop_label", "label": "Shop link", "default": "Shop all tees" },
    { "type": "text", "id": "characters_label", "label": "Collections link", "default": "Meet the characters" },
    { "type": "text", "id": "contact_label", "label": "Contact link", "default": "Get in touch" },
    { "type": "checkbox", "id": "show_policies", "label": "Show published policies", "default": true },
    { "type": "text", "id": "subscribe_label", "label": "Subscribe button accessible label", "default": "Subscribe" },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer logo",
      "info": "Falls back to the theme logo when empty."
    },
    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Heading",
      "default": "Join the JJW crew"
    },
    {
      "type": "textarea",
      "id": "newsletter_text",
      "label": "Text",
      "default": "New characters, new drops and first dibs on restocks — straight to your inbox."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email placeholder",
      "default": "Email"
    },
    {
      "type": "text",
      "id": "newsletter_success",
      "label": "Success message",
      "default": "Thanks for subscribing!"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_icons",
      "label": "Show icon row",
      "default": true
    },
    {
      "type": "header",
      "content": "Credits"
    },
    {
      "type": "text",
      "id": "credit_one_label",
      "label": "First credit label"
    },
    {
      "type": "url",
      "id": "credit_one_link",
      "label": "First credit link"
    },
    {
      "type": "text",
      "id": "credit_two_label",
      "label": "Second credit label"
    },
    {
      "type": "url",
      "id": "credit_two_link",
      "label": "Second credit link"
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Link column",
      "settings": [
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "icon",
      "name": "Icon",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Icon"
        }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "Footer",
      "blocks": [
        { "type": "menu" }
      ]
    }
  ]
}
{% endschema %}
