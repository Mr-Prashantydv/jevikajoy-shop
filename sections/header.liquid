{%- comment -%}
  Header — converted from the React source at
  src/components/site/header.tsx (that file is the source of truth).

  Reused from theme.css: .btn-wrap / .btn-shadow / .btn (blob + offset shadow),
  .visually-hidden, tokens. The blob clip path (#jjw-blob) is declared once in
  layout/theme.liquid and only referenced here.

  Role mapping: their lightblue -> --blue, their blue/ink -> --ink-deep,
  beige -> --cream, card palettes -> the JJW *-bg / solid token pairs.
{%- endcomment -%}

{%- assign s = section.id -%}

{%- style -%}
  {%- comment -%}
    React puts sticky + h-0 on the outermost element, whose parent is the page.
    Here that outermost element is Shopify's own section wrapper, so the sticky
    lives there — on an inner div it would have a zero-height containing block
    and never travel. Still uniquely scoped, so nothing leaks.
  {%- endcomment -%}
  #shopify-section-{{ s }} {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 0;
  }

  #Header-{{ s }} {
    position: relative;
  }

  #Header-{{ s }} .hdr-overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--ink-deep);
    opacity: 0.33;
  }

  #Header-{{ s }} .hdr-bar {
    position: relative;
    z-index: 20;
    background: transparent;
    border-bottom: 1px solid var(--cream);
  }

  #Header-{{ s }}[data-open='true'] .hdr-bar {
    background: var(--cream);
  }

  #Header-{{ s }}[data-open='false'] .hdr-overlay,
  #Header-{{ s }}[data-open='false'] .hdr-mega,
  #Header-{{ s }}[data-open='false'] .hdr-drawer {
    display: none;
  }

  /* --- Top bar ---------------------------------------------------------- */

  #Header-{{ s }} .hdr-grid {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 2rem;
    padding: 1.44rem 2.16rem;
  }

  #Header-{{ s }} .hdr-logo {
    display: block;
    padding-inline: 0.5rem;
    margin-left: -0.5rem;
  }

  #Header-{{ s }} .hdr-logo img,
  #Header-{{ s }} .hdr-logo svg {
    height: 8.3rem;
    width: {{ section.settings.logo_width | default: 300 }}px;
    max-width: 100%;
    object-fit: contain;
    object-position: left center;
  }

  #Header-{{ s }} .hdr-menu-wrap {
    position: relative;
    display: block;
  }

  #Header-{{ s }} .hdr-menu-wrap .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-menu {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 7.5rem;
    width: 8.3rem;
    padding: 0;
    color: var(--cream);
    background: var(--blue);
    clip-path: url(#jjw-blob);
    -webkit-clip-path: url(#jjw-blob);
  }

  #Header-{{ s }} .hdr-menu .icon-burger {
    height: 4.5rem;
    width: 5.3rem;
  }

  #Header-{{ s }} .hdr-menu .icon-close {
    height: 1.6rem;
    width: 1.6rem;
  }

  #Header-{{ s }}[data-open='false'] .hdr-menu .icon-close,
  #Header-{{ s }}[data-open='true'] .hdr-menu .icon-burger {
    display: none;
  }

  {%- comment -%}
    React shipped one 6.9rem icon here; this header has up to three plus the
    CTA, which overflows the row long before phone widths (750–990px too).
    Wrapping lets the extra pills drop to a second line instead of being
    clipped off-screen by body { overflow-x: hidden }.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    row-gap: 0.8rem;
    justify-self: end;
    margin-right: -1.12rem;
  }

  #Header-{{ s }} .hdr-cta {
    position: relative;
    z-index: 10;
    display: block;
    margin-right: 1.9rem;
  }

  #Header-{{ s }} .hdr-cta .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-cta .btn {
    height: 7rem;
    max-height: 7rem;
    min-height: 0;
    width: 22.1rem;
    max-width: 100%;
    padding: 0 1.25rem;
    font-size: 3rem;
    line-height: 1.2;
    letter-spacing: 0.15rem;
    --btn-bg: var(--blue);
    --btn-fg: var(--cream);
  }

  #Header-{{ s }} .hdr-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: flex-end;
    height: 7rem;
    width: 6.9rem;
    flex: none;
    color: var(--cream);
    background: var(--blue);
    border-radius: 0.75rem;
  }

  #Header-{{ s }} .hdr-icon + .hdr-icon {
    margin-left: 0.8rem;
  }

  #Header-{{ s }} .hdr-icon > span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.4rem;
    width: 4.4rem;
  }

  #Header-{{ s }} .hdr-icon svg {
    height: 4rem;
    width: 4rem;
  }

  #Header-{{ s }} .hdr-count {
    position: absolute;
    top: 0.6rem;
    right: 0.4rem;
    min-width: 2rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--pink);
    color: var(--cream);
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 2rem;
    text-align: center;
  }

  /* --- Desktop mega panel ------------------------------------------------ */

  #Header-{{ s }} .hdr-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 50;
    background: var(--cream);
    padding: 3rem 3rem 5rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  #Header-{{ s }} .hdr-mega-inner {
    display: flex;
    min-height: 35rem;
    gap: 4rem;
  }

  #Header-{{ s }} .hdr-mega-links {
    width: 20rem;
    flex-shrink: 0;
    padding-block: 2rem;
  }

  #Header-{{ s }} .hdr-mega-links ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  #Header-{{ s }} .hdr-mega-links li {
    margin-bottom: 1rem;
    width: auto;
  }

  #Header-{{ s }} .hdr-mega-links .btn-wrap {
    display: block;
    width: 100%;
  }

  #Header-{{ s }} .hdr-mega-links .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-mega-links .btn {
    min-height: 0;
    padding: 1rem 2.5rem;
    font-size: 3rem;
    line-height: 1.8;
    letter-spacing: 0.15rem;
    border-radius: 0.8rem;
    --btn-bg: var(--blue);
    --btn-fg: var(--cream);
  }

  #Header-{{ s }} .hdr-mega-link {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1.8;
    letter-spacing: 0.15rem;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  #Header-{{ s }} .hdr-mega-link:hover {
    color: var(--pink);
  }

  #Header-{{ s }} .hdr-mega-cards {
    position: relative;
    flex: 1;
  }

  #Header-{{ s }} .hdr-mega-spacer {
    visibility: hidden;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  #Header-{{ s }} .hdr-mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 1vw;
  }

  @media screen and (min-width: 1200px) {
    #Header-{{ s }} .hdr-mega-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  #Header-{{ s }} .hdr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    border-radius: 2rem;
    background: var(--mc-bg, var(--sky));
    box-shadow: 6px 6px 0 0 var(--mc-shadow, var(--ink-deep));
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  #Header-{{ s }} .hdr-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 0 0 transparent;
  }

  #Header-{{ s }} .hdr-card-inner {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 2rem 1rem;
    text-align: center;
  }

  #Header-{{ s }} .hdr-card-media {
    margin: 0 auto 1rem;
    aspect-ratio: 2000 / 2125;
    width: 100%;
    max-width: 20rem;
  }

  #Header-{{ s }} .hdr-card-media img {
    aspect-ratio: 1 / 1;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    transform: scale(1.2);
    border-radius: 0.8rem;
  }

  #Header-{{ s }} .hdr-card-label {
    margin-inline: auto;
    max-width: 90%;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 3rem;
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--mc-shadow, var(--ink-deep));
  }

  /* --- Mobile drawer ----------------------------------------------------- */

  #Header-{{ s }} .hdr-drawer {
    position: fixed;
    inset: 0;
    z-index: 50;
    overflow-y: auto;
    background: var(--cream);
    padding: 2rem;
  }

  #Header-{{ s }} .hdr-drawer-inner {
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-width: 40rem;
  }

  #Header-{{ s }} .hdr-drawer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  #Header-{{ s }} .hdr-drawer-links .btn-wrap {
    min-width: 12rem;
    flex: 1;
  }

  #Header-{{ s }} .hdr-drawer-links .btn-wrap.is-active {
    flex: 1 0 100%;
  }

  #Header-{{ s }} .hdr-drawer-links .btn-shadow {
    transform: none;
    opacity: 0;
    --btn-shadow-color: var(--ink-deep);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #Header-{{ s }} .hdr-drawer-links .is-active .btn-shadow {
    transform: translate(4px, 4px);
    opacity: 1;
  }

  #Header-{{ s }} .hdr-drawer-links .btn {
    min-height: 0;
    padding: 1rem 1.5rem;
    font-size: max(2rem, 25px);
    line-height: 1.2;
    letter-spacing: 0.15rem;
    --btn-bg: var(--blue);
    --btn-fg: var(--cream);
  }

  #Header-{{ s }} .hdr-drawer-grid {
    display: grid;
    justify-items: center;
    gap: 2rem;
    padding-block: 1rem;
  }

  #Header-{{ s }} .hdr-drawer-card {
    width: 100%;
    border-radius: 1rem;
    padding: 1rem;
    text-align: center;
    background: var(--mc-bg, var(--sky));
    box-shadow: 4px 4px 0 0 var(--mc-shadow, var(--ink-deep));
  }

  #Header-{{ s }} .hdr-drawer-card img {
    margin-inline: auto;
    height: auto;
    width: 80%;
  }

  #Header-{{ s }} .hdr-drawer-card-label {
    margin-top: 0.5rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1.2;
    text-transform: uppercase;
    color: var(--mc-shadow, var(--ink-deep));
  }

  /* --- Card palettes ------------------------------------------------------ */

  #Header-{{ s }} [data-palette='sky']    { --mc-bg: var(--sky);       --mc-shadow: var(--blue); }
  #Header-{{ s }} [data-palette='blue']   { --mc-bg: var(--blue-bg);   --mc-shadow: var(--ink); }
  #Header-{{ s }} [data-palette='pink']   { --mc-bg: var(--pink-bg);   --mc-shadow: var(--pink); }
  #Header-{{ s }} [data-palette='gold']   { --mc-bg: var(--gold-bg);   --mc-shadow: var(--gold); }
  #Header-{{ s }} [data-palette='green']  { --mc-bg: var(--green-bg);  --mc-shadow: var(--green); }
  #Header-{{ s }} [data-palette='purple'] { --mc-bg: var(--purple-bg); --mc-shadow: var(--purple); }

  /* --- Breakpoints -------------------------------------------------------- */

  @media screen and (max-width: 990px) {
    #Header-{{ s }} .hdr-mega {
      display: none;
    }
  }

  @media screen and (min-width: 991px) {
    #Header-{{ s }} .hdr-drawer {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    #Header-{{ s }} .hdr-grid {
      padding-inline: 1rem;
      gap: 1rem;
    }

    #Header-{{ s }} .hdr-logo img,
    #Header-{{ s }} .hdr-logo svg {
      /* ponytail: React keeps the 300px width here, which squashes the mark.
         Width follows the art instead; drop this rule to match React exactly.
         5rem (~82px wide) leaves room for all three icon pills on one line
         from 360px up. */
      height: 5rem;
      width: auto;
    }

    /* Icon pills shrink to a 44px touch target and share one gap so search,
       account and cart all stay on-screen and tappable. */
    #Header-{{ s }} .hdr-actions {
      gap: 0.8rem;
      margin-right: 0;
    }

    #Header-{{ s }} .hdr-icon {
      height: 5.6rem;
      width: 4.4rem;
      justify-content: center;
    }

    #Header-{{ s }} .hdr-icon + .hdr-icon {
      margin-left: 0;
    }

    #Header-{{ s }} .hdr-icon > span {
      height: 3.6rem;
      width: 3.6rem;
    }

    #Header-{{ s }} .hdr-icon svg {
      height: 3.2rem;
      width: 3.2rem;
    }

    #Header-{{ s }} .hdr-count {
      top: 0.2rem;
      right: 0.2rem;
      min-width: 1.8rem;
      padding: 0 0.4rem;
      font-size: 1.3rem;
      line-height: 1.8rem;
    }

    /* Stays visible — React keeps the CTA at every width; only the fixed
       22.1rem width is relaxed so it fits a phone. */
    #Header-{{ s }} .hdr-cta {
      margin-right: 0;
    }

    #Header-{{ s }} .hdr-cta .btn {
      width: auto;
      min-width: 0;
      padding-inline: 1rem;
      font-size: 2.2rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #Header-{{ s }} .hdr-card,
    #Header-{{ s }} .hdr-drawer-links .btn-shadow,
    #Header-{{ s }} .hdr-mega-link {
      transition: none;
    }

    #Header-{{ s }} .hdr-card:hover {
      transform: none;
    }
  }
{%- endstyle -%}

<div id="Header-{{ s }}" data-open="false">
  <div class="hdr-overlay" data-hdr-close aria-hidden="true"></div>

  <header class="hdr-bar">
    <div class="hdr-grid">
      <a href="{{ routes.root_url }}" class="hdr-logo" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 900
            | image_tag: alt: shop.name, width: section.settings.logo_width, loading: 'eager'
          }}
        {%- else -%}
          <img
            src="{{ 'jjw-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="300"
            height="83"
          >
        {%- endif -%}
      </a>

      <div class="hdr-menu-wrap btn-wrap">
        <span class="btn-shadow" aria-hidden="true"></span>
        <button
          type="button"
          class="hdr-menu"
          data-hdr-toggle
          aria-expanded="false"
          aria-controls="HeaderMega-{{ s }} HeaderDrawer-{{ s }}"
          aria-label="{{ 'sections.header.menu' | t }}"
        >
          <svg class="icon-burger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M1 .5a.5.5 0 1 0 0 1h15.71a.5.5 0 0 0 0-1zM.5 8a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1A.5.5 0 0 1 .5 8m0 7a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1a.5.5 0 0 1-.5-.5"/>
          </svg>
          <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 17" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"/>
          </svg>
        </button>
      </div>

      <div class="hdr-actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.root_url }}" class="hdr-cta btn-wrap">
            <span class="btn-shadow" aria-hidden="true"></span>
            <span class="btn">{{ section.settings.cta_text | escape }}</span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_search -%}
          <a href="{{ routes.search_url }}" class="hdr-icon" aria-label="{{ 'general.search.search' | t }}">
            <span>
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 1 1 2.85 3.5a5.784 5.784 0 0 1 8.18 8.18m.26 1.12a6.78 6.78 0 1 1 .72-.7l5.4 5.4a.5.5 0 1 1-.71.7z"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <a href="{{ routes.account_url }}" class="hdr-icon" aria-label="{{ section.settings.account_label | escape }}">
            <span>
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 1.5a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5M6.25 5.25a2.75 2.75 0 1 1 5.5 0 2.75 2.75 0 0 1-5.5 0M9 10.5c-3.6 0-6.5 2.4-6.5 5.36 0 .84.7 1.52 1.55 1.52h9.9c.86 0 1.55-.68 1.55-1.52 0-2.96-2.9-5.36-6.5-5.36m-5.5 5.36c0-2.32 2.36-4.36 5.5-4.36s5.5 2.04 5.5 4.36c0 .29-.24.52-.55.52h-9.9a.54.54 0 0 1-.55-.52"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- if section.settings.show_cart -%}
          <a href="{{ routes.cart_url }}" class="hdr-icon" aria-label="{{ 'sections.header.cart_count' | t }}">
            <span>
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 1.5A3.25 3.25 0 0 0 5.75 4.75V5.5H3.4a1 1 0 0 0-.996.91l-.9 9.9A1.5 1.5 0 0 0 3 18h12a1.5 1.5 0 0 0 1.494-1.69l-.9-9.9A1 1 0 0 0 14.6 5.5h-2.35v-.75A3.25 3.25 0 0 0 9 1.5m2.25 5h3.35l.9 9.9a.5.5 0 0 1-.5.6H3a.5.5 0 0 1-.5-.6l.9-9.9h3.35v2a.5.5 0 0 0 1 0v-2h2.5v2a.5.5 0 0 0 1 0zm-1-1h-4.5v-.75a2.25 2.25 0 0 1 4.5 0z"/>
              </svg>
            </span>
            {%- if cart.item_count > 0 -%}
              <span class="hdr-count" aria-hidden="true">{{ cart.item_count }}</span>
              <span class="visually-hidden">{{ cart.item_count }}</span>
            {%- endif -%}
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Desktop mega panel — hidden at 990px and below, per React. {%- endcomment -%}
    <div
      id="HeaderMega-{{ s }}"
      class="hdr-mega"
      role="navigation"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <div class="hdr-mega-inner">
        <div class="hdr-mega-links">
          <ul>
            {%- for link in section.settings.menu.links -%}
              <li>
                {%- if link.active or link.child_active -%}
                  <div class="btn-wrap">
                    <span class="btn-shadow" aria-hidden="true"></span>
                    <a href="{{ link.url }}" class="btn" aria-current="page">{{ link.title | escape }}</a>
                  </div>
                {%- else -%}
                  <a href="{{ link.url }}" class="hdr-mega-link">{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="hdr-mega-cards">
          <h3 class="hdr-mega-spacer" aria-hidden="true">{{ section.settings.cards_heading | escape }}</h3>
          <div class="hdr-mega-grid">
            {%- for block in section.blocks -%}
              <div class="hdr-card" data-palette="{{ block.settings.palette }}" {{ block.shopify_attributes }}>
                <div class="hdr-card-inner">
                  <a href="{{ block.settings.link | default: routes.root_url }}">
                    {%- if block.settings.image != blank -%}
                      <div class="hdr-card-media">
                        {{
                          block.settings.image
                          | image_url: width: 400
                          | image_tag: alt: block.settings.label, loading: 'lazy'
                        }}
                      </div>
                    {%- endif -%}
                    <div class="hdr-card-label">{{ block.settings.label | escape }}</div>
                  </a>
                </div>
              </div>
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Mobile drawer — hidden at 991px and above, per React. {%- endcomment -%}
    <div
      id="HeaderDrawer-{{ s }}"
      class="hdr-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <div class="hdr-drawer-inner">
        <div class="hdr-drawer-links">
          {%- for link in section.settings.menu.links -%}
            <div class="btn-wrap{% if link.active or link.child_active %} is-active{% endif %}">
              <span class="btn-shadow" aria-hidden="true"></span>
              <a
                href="{{ link.url }}"
                class="btn"
                {% if link.active or link.child_active %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </div>
          {%- endfor -%}
        </div>

        <div class="hdr-drawer-grid">
          {%- for block in section.blocks -%}
            <div class="hdr-drawer-card" data-palette="{{ block.settings.palette }}" {{ block.shopify_attributes }}>
              <a href="{{ block.settings.link | default: routes.root_url }}">
                {%- if block.settings.image != blank -%}
                  {{
                    block.settings.image
                    | image_url: width: 400
                    | image_tag: alt: block.settings.label, loading: 'lazy'
                  }}
                {%- endif -%}
                <div class="hdr-drawer-card-label">{{ block.settings.label | escape }}</div>
              </a>
            </div>
          {%- endfor -%}
        </div>
      </div>
    </div>
  </header>
</div>

<script>
  (function () {
    var root = document.getElementById('Header-{{ s }}');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    var toggle = root.querySelector('[data-hdr-toggle]');

    function setOpen(open) {
      root.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      document.body.style.overflow = open ? 'hidden' : '';
    }

    toggle.addEventListener('click', function () {
      setOpen(root.dataset.open !== 'true');
    });

    root.querySelector('[data-hdr-close]').addEventListener('click', function () {
      setOpen(false);
    });

    document.addEventListener('keydown', function (e) {
      // Section may have been swapped out by the theme editor.
      if (!root.isConnected) return;
      if (e.key === 'Escape' && root.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });
  })();
</script>

