{%- comment -%}
  Header — converted from the React source at
  src/components/site/header.tsx (that file is the source of truth).

  Reused from theme.css: .btn-wrap / .btn-shadow / .btn (blob + offset shadow),
  .visually-hidden, tokens. The blob clip path (#jjw-blob) is declared once in
  layout/theme.liquid and only referenced here.

  Role mapping: their lightblue -> --blue, their blue/ink -> --ink-deep,
  beige -> --cream, card palettes -> the JJW *-bg / solid token pairs.
{%- endcomment -%}

{%- assign s = section.id -%}

{%- style -%}
  {%- comment -%}
    React puts sticky + h-0 on the outermost element, whose parent is the page.
    Here that outermost element is Shopify's own section wrapper, so the sticky
    lives there — on an inner div it would have a zero-height containing block
    and never travel. Still uniquely scoped, so nothing leaks.
  {%- endcomment -%}
  #shopify-section-{{ s }} {
    position: sticky;
    top: 0;
    z-index: 50;
    height: 0;
  }

  {%- comment -%}
    height: 0 only works where the section beneath is drawn to sit under the
    bar — that is the homepage hero and nothing else. Everywhere else the bar
    landed on top of the content (PDP h1, and again on the sticky info column,
    which parked at its own top: 3rem underneath it). Reference does the same
    split: its header is position: relative and in flow, so main starts below.
  {%- endcomment -%}
  body:not(.template--index) #shopify-section-{{ s }} {
    position: relative;
    height: auto;
  }

  body:not(.template--index) #Header-{{ s }} .hdr-bar {
    background: var(--cream);
  }

  #Header-{{ s }} {
    position: relative;
  }

  #Header-{{ s }} .hdr-overlay {
    position: fixed;
    inset: 0;
    z-index: 10;
    background: var(--ink-deep);
    opacity: 0.33;
  }

  #Header-{{ s }} .hdr-bar {
    position: relative;
    z-index: 20;
    background: transparent;
    border-bottom: 1px solid var(--cream);
  }

  {%- comment -%}
    While the menu is open the bar is pinned to the viewport. On interior
    templates the section is position: relative, so the bar scrolls away with
    the page — open the drawer after scrolling and the close button, logo and
    search were simply off-screen above it. Fixed + z 60 keeps all three
    reachable on every template; the drawer's padding-top clears this height.
  {%- endcomment -%}
  #Header-{{ s }}[data-open='true'] .hdr-bar,
  #Header-{{ s }}[data-search='true'] .hdr-bar {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 60;
    background: var(--cream);
  }

  #Header-{{ s }}[data-open='false'] .hdr-mega,
  #Header-{{ s }}[data-open='false'] .hdr-drawer,
  #Header-{{ s }}[data-search='false'] .hdr-search {
    display: none;
  }

  {%- comment -%}
    The menu and the search panel are separate states and close each other,
    but only the menu draws the scrim. The reference leaves the page bright
    behind its search drop-down; .hdr-search covers the viewport transparently
    and closes on an outside click instead.
  {%- endcomment -%}
  #Header-{{ s }}[data-open='false'] .hdr-overlay {
    display: none;
  }

  /* --- Top bar ---------------------------------------------------------- */

  {%- comment -%}
    The drawer and the mega panel are children of .hdr-bar, not siblings. Once
    the bar becomes a stacking context (it takes z-index 60 while open), any
    positioned descendant with a positive z-index paints above this row —
    which is unpositioned. That buried the logo, close button and search under
    the open drawer. Giving the row its own layer above the drawer's 15 keeps
    the controls on top; the mega panel's 50 still sits above the row, which
    is right since it drops below the bar rather than over it.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-grid {
    position: relative;
    z-index: 30;
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 1.6rem;
    padding: 1.2rem var(--page-gutter);
  }

  #Header-{{ s }} .hdr-logo {
    display: block;
    padding-inline: 0.5rem;
    margin-left: -0.5rem;
  }

  #Header-{{ s }} .hdr-logo img,
  #Header-{{ s }} .hdr-logo svg {
    /* Size by height and let width follow the artwork's own ratio, so a logo of
       any proportion sits flush instead of being letterboxed inside a fixed track. */
    height: 5.6rem;
    width: auto;
    max-width: {{ section.settings.logo_width | default: 220 }}px;
    object-fit: contain;
    object-position: left center;
  }

  #Header-{{ s }} .hdr-menu-wrap {
    position: relative;
    display: block;
  }

  #Header-{{ s }} .hdr-menu-wrap:has(.hdr-menu:focus-visible) {
    outline: 3px solid var(--cream);
    box-shadow: 0 0 0 6px var(--ink);
    border-radius: 0.8rem;
  }

  #Header-{{ s }} .hdr-menu-wrap .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-menu {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.8rem;
    width: 5.4rem;
    padding: 0;
    color: var(--cream);
    background: var(--ink);
    clip-path: url(#jjw-blob);
    -webkit-clip-path: url(#jjw-blob);
  }

  #Header-{{ s }} .hdr-menu .icon-burger {
    height: 2.8rem;
    width: 3.2rem;
  }

  #Header-{{ s }} .hdr-menu .icon-close {
    height: 1.6rem;
    width: 1.6rem;
  }

  #Header-{{ s }}[data-open='false'] .hdr-menu .icon-close,
  #Header-{{ s }}[data-open='true'] .hdr-menu .icon-burger {
    display: none;
  }

  {%- comment -%}
    React shipped one 6.9rem icon here; this header has up to three plus the
    CTA. The breakpoints below drop controls until what is left fits, so this
    should never wrap in practice — but a merchant can add a long CTA label
    or a fourth control, and wrapping is the graceful failure. Without it the
    overflow is clipped off-screen by body { overflow-x: hidden }.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-actions {
    display: flex;
    flex-wrap: nowrap;
    align-items: center;
    justify-content: flex-end;
    row-gap: 0.8rem;
    justify-self: end;
    margin-right: 0;
  }

  #Header-{{ s }} .hdr-cta {
    position: relative;
    z-index: 10;
    display: block;
    margin-right: 1.9rem;
  }

  #Header-{{ s }} .hdr-cta .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-cta .btn {
    height: 4.8rem;
    max-height: 4.8rem;
    min-height: var(--touch-target);
    width: auto;
    max-width: 100%;
    padding: 0 1.8rem;
    font-size: var(--button-text-size);
    line-height: 1.2;
    letter-spacing: 0.05em;
    --btn-bg: var(--ink);
    --btn-fg: var(--cream);
  }

  #Header-{{ s }} .hdr-icon {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.8rem;
    width: 4.8rem;
    flex: none;
    color: var(--ink);
    background: var(--cream);
    border: 1px solid color-mix(in srgb, var(--ink) 18%, transparent);
    border-radius: 1.2rem;
    transition: border-color 0.2s var(--ease), background 0.2s var(--ease);
  }

  #Header-{{ s }} .hdr-icon:hover {
    border-color: var(--ink);
    background: var(--white);
  }

  #Header-{{ s }} .hdr-icon + .hdr-icon {
    margin-left: 0.8rem;
  }

  #Header-{{ s }} .hdr-icon > span {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.4rem;
    width: 4.4rem;
  }

  #Header-{{ s }} .hdr-icon svg {
    height: 2.8rem;
    width: 2.8rem;
  }

  {%- comment -%}
    Account component. Shopify renders the avatar and the sign-in sheet inside
    a shadow root, so the only handles are these custom properties — they
    inherit through the shadow boundary, which is why our own tokens resolve.
    Everything here maps a JJW token onto one of Shopify's roles.

    Accent is Adventure Blue rather than Heart Pink: the sheet sets ordinary
    14-16px button text, where pink on cream measures about 2.9:1 and misses
    AA. Blue with white clears it at 4.6:1.
  {%- endcomment -%}
  #Header-{{ s }} shopify-account {
    display: flex;
    align-items: center;
    justify-content: center;

    --shopify-account-avatar-size: 3.2rem;
    --shopify-account-color-accent: var(--blue);
    --shopify-account-color-accent-text: var(--white);
    --shopify-account-color-background: var(--cream);
    --shopify-account-color-background-subdued: var(--warm-white);
    --shopify-account-color-border: var(--sky);
    --shopify-account-color-card-background: var(--white);
    --shopify-account-color-card-text: var(--ink);
    --shopify-account-color-control-background: var(--white);
    --shopify-account-color-control-text: var(--ink);
    --shopify-account-color-text: var(--ink);
    --shopify-account-color-text-subdued: var(--ink-soft);
    --shopify-account-font-body: var(--font-body);
    --shopify-account-font-heading: var(--font-heading);
    --shopify-account-font-heading-weight: 800;
    --shopify-account-radius-base: 0.8rem;
    --shopify-account-radius-button: 0.8rem;
    --shopify-account-radius-dialog: 2rem;
    --shopify-account-radius-input: 0.8rem;

    /* Signed in, the avatar becomes the customer's initial — pink on cream
       is fine here because it is a single large glyph, not body copy. */
    --shopify-account-signed-in-avatar-size: 3.2rem;
    --shopify-account-signed-in-avatar-color-background: var(--pink);
    --shopify-account-signed-in-avatar-color-text: var(--cream);

    /* Clear the bar so the sheet does not open underneath it. */
    --shopify-account-dialog-position-top: 9rem;
  }

  #Header-{{ s }} .hdr-icon--account {
    justify-content: center;
  }

  #Header-{{ s }} .hdr-account-avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 4.4rem;
    width: 4.4rem;
    color: var(--ink);
  }

  {%- comment -%}
    Drawer copy of the component. Hidden above the drawer breakpoint so only
    one of the two instances is ever interactive. The avatar keeps the blue
    pill so it reads as the same control as the one in the bar.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-drawer-account {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    margin-top: 2.4rem;
    padding-top: 2.4rem;
    border-top: 2px solid var(--sky);
  }

  #Header-{{ s }} .hdr-drawer-account shopify-account {
    flex: none;
    height: 5rem;
    width: 5rem;
    color: var(--cream);
    background: var(--blue);
    border-radius: 0.75rem;
    --shopify-account-avatar-size: 3.4rem;
    --shopify-account-signed-in-avatar-size: 3.4rem;
  }

  #Header-{{ s }} .hdr-drawer-account .hdr-account-avatar {
    height: 3.4rem;
    width: 3.4rem;
  }

  #Header-{{ s }} .hdr-drawer-account .hdr-account-avatar svg {
    height: 3rem;
    width: 3rem;
  }

  #Header-{{ s }} .hdr-drawer-account-label {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1.2;
    letter-spacing: 0.11rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  {%- comment -%}
    Exact complement of the 749px rule that hides the bar pill, so precisely
    one of the two instances is visible at any width — never both, never none.
    No later rule touches this selector, so its position here is safe.
  {%- endcomment -%}
  @media screen and (min-width: 750px) {
    #Header-{{ s }} .hdr-drawer-account {
      display: none;
    }
  }

  #Header-{{ s }} .hdr-account-avatar svg {
    height: 2.8rem;
    width: 2.8rem;
  }

  #Header-{{ s }} .hdr-count {
    position: absolute;
    top: 0.6rem;
    right: 0.4rem;
    min-width: 2rem;
    padding: 0 0.5rem;
    border-radius: 999px;
    background: var(--pink);
    color: var(--ink-deep);
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 2rem;
    text-align: center;
  }

  #Header-{{ s }} .hdr-icon > .hdr-count {
    height: 2rem;
    width: auto;
    font-size: 1.2rem;
    line-height: 2rem;
  }

  /* --- Desktop mega panel ------------------------------------------------ */

  #Header-{{ s }} .hdr-mega {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 50;
    background: var(--cream);
    padding: 3rem 3rem 5rem;
    max-height: 70vh;
    overflow-y: auto;
  }

  #Header-{{ s }} .hdr-mega-inner {
    display: flex;
    min-height: 35rem;
    gap: 4rem;
  }

  #Header-{{ s }} .hdr-mega-links {
    width: 20rem;
    flex-shrink: 0;
    padding-block: 2rem;
  }

  #Header-{{ s }} .hdr-mega-links ul {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    list-style: none;
    margin: 0 0 1rem;
    padding: 0;
  }

  #Header-{{ s }} .hdr-mega-links li {
    margin-bottom: 1rem;
    width: auto;
  }

  #Header-{{ s }} .hdr-mega-links .btn-wrap {
    display: block;
    width: 100%;
  }

  #Header-{{ s }} .hdr-mega-links .btn-shadow {
    transform: translate(4px, 4px);
    --btn-shadow-color: var(--ink-deep);
  }

  #Header-{{ s }} .hdr-mega-links .btn {
    min-height: var(--touch-target);
    padding: 1rem 2.5rem;
    font-size: var(--button-text-size);
    line-height: 1.3;
    letter-spacing: 0.05em;
    border-radius: 0.8rem;
    --btn-bg: var(--blue);
    --btn-fg: var(--white);
  }

  #Header-{{ s }} .hdr-mega-link {
    display: block;
    width: 100%;
    text-align: center;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.5;
    min-height: var(--touch-target);
    letter-spacing: 0.135rem;
    text-transform: uppercase;
    color: var(--ink);
    transition: color 0.3s var(--ease);
  }

  #Header-{{ s }} .hdr-mega-link:hover {
    color: var(--ink-deep);
    text-decoration: underline;
  }

  #Header-{{ s }} .hdr-mega-cards {
    position: relative;
    flex: 1;
  }

  #Header-{{ s }} .hdr-mega-spacer {
    visibility: hidden;
    font-size: 1.5rem;
    font-weight: 600;
    line-height: 1.3;
    margin: 0;
  }

  #Header-{{ s }} .hdr-mega-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    align-items: center;
    justify-items: center;
    gap: 1vw;
  }

  @media screen and (min-width: 1200px) {
    #Header-{{ s }} .hdr-mega-grid {
      grid-template-columns: repeat(5, minmax(0, 1fr));
    }
  }

  #Header-{{ s }} .hdr-card {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    height: 100%;
    width: 100%;
    border-radius: 2rem;
    background: var(--mc-bg, var(--sky));
    box-shadow: 6px 6px 0 0 var(--mc-shadow, var(--ink-deep));
    transition: transform 0.3s var(--ease), box-shadow 0.3s var(--ease);
  }

  #Header-{{ s }} .hdr-card:hover {
    transform: translateY(-2px);
    box-shadow: 0 0 0 0 transparent;
  }

  /* Padding lives on the link so the whole card is one hit target. */
  #Header-{{ s }} .hdr-card > a {
    display: block;
    width: 100%;
    overflow: hidden;
    padding: 2rem 1rem;
    text-align: center;
  }

  #Header-{{ s }} .hdr-card-media {
    margin: 0 auto 1rem;
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 20rem;
  }

  {%- comment -%}
    Character art is a cut-out sticker on transparency. cover + scale(1.2)
    would crop the head; contain keeps the whole character inside the card.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }

  #Header-{{ s }} .hdr-card-label {
    margin-inline: auto;
    max-width: 90%;
    font-family: var(--font-accent);
    font-weight: 700;
    /* Reference card label: 27px condensed caps, letter-spacing 1.35px. */
    font-size: 2.7rem;
    line-height: 1.3;
    letter-spacing: 0.135rem;
    text-transform: uppercase;
    {%- comment -%}
      Navy, not the card's own solid. --mc-bg now holds a brand-sheet colour
      rather than a pale tint, so Heart Pink on Candy Pink measured 1.1:1 and
      the label was invisible; gold and green were 1.5. --mc-shadow still
      drives the offset shadow, where contrast does not apply.
    {%- endcomment -%}
    color: var(--ink);
  }

  /* --- Mobile drawer ----------------------------------------------------- */

  {%- comment -%}
    Sits under the bar (z 20), not over it, so the close button, logo and
    search stay reachable while the drawer is open — the reference keeps all
    three visible. padding-top clears the bar's own height.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-drawer {
    position: fixed;
    inset: 0;
    z-index: 15;
    overflow-y: auto;
    background: var(--cream);
    padding: 12rem 2rem 4rem;
  }

  #Header-{{ s }} .hdr-drawer-inner {
    display: flex;
    flex-direction: column;
    margin-inline: auto;
    max-width: 76rem;
  }

  #Header-{{ s }} .hdr-drawer-links {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    margin-bottom: 1rem;
  }

  #Header-{{ s }} .hdr-drawer-links .btn-wrap {
    min-width: 12rem;
    flex: 1;
  }

  {%- comment -%}
    Reference features the first entry across the full width with the rest
    sharing the row beneath. Keyed to position, not to the active link, so
    the block keeps that shape on every page — on a product page no menu
    link is active and all four collapsed into one cramped row.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-drawer-links .btn-wrap:first-child {
    flex: 1 0 100%;
  }

  {%- comment -%}
    Every drawer button carries the offset shadow, as the reference does.
    Previously only the active one did, so on any page without an active menu
    link the whole block rendered flat.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-drawer-links .btn-shadow {
    transform: translate(4px, 4px);
    opacity: 1;
    --btn-shadow-color: var(--ink-deep);
    transition: opacity 0.2s ease, transform 0.2s ease;
  }

  #Header-{{ s }} .hdr-drawer-links .btn {
    min-height: var(--touch-target);
    padding: 1rem 1.5rem;
    font-size: var(--button-text-size);
    line-height: 1.2;
    letter-spacing: 0.15rem;
    --btn-bg: var(--blue);
    --btn-fg: var(--white);
  }

  {%- comment -%}
    Reference drawer runs the cards as a wrapping grid, not a single column:
    two up on a phone, four from tablet width.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-drawer-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.6rem;
    padding-block: 1rem;
  }

  @media screen and (min-width: 600px) {
    #Header-{{ s }} .hdr-drawer-grid {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  #Header-{{ s }} .hdr-drawer-card {
    border-radius: 1.2rem;
    background: var(--mc-bg, var(--sky));
    box-shadow: 6px 6px 0 0 var(--mc-shadow, var(--ink-deep));
  }

  #Header-{{ s }} .hdr-drawer-card > a {
    display: block;
    padding: 1.4rem 1rem;
    text-align: center;
  }

  #Header-{{ s }} .hdr-drawer-card-media {
    aspect-ratio: 1 / 1;
    width: 100%;
    max-width: 12rem;
    margin: 0 auto 0.6rem;
  }

  #Header-{{ s }} .hdr-drawer-card-media img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  #Header-{{ s }} .hdr-drawer-card-label {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2.2rem;
    line-height: 1.2;
    letter-spacing: 0.11rem;
    text-transform: uppercase;
    {%- comment -%}
      Navy, not the card's own solid. --mc-bg now holds a brand-sheet colour
      rather than a pale tint, so Heart Pink on Candy Pink measured 1.1:1 and
      the label was invisible; gold and green were 1.5. --mc-shadow still
      drives the offset shadow, where contrast does not apply.
    {%- endcomment -%}
    color: var(--ink);
  }

  /* --- Card palettes ------------------------------------------------------ */

  #Header-{{ s }} [data-palette='sky']    { --mc-bg: var(--sky);       --mc-shadow: var(--blue); }
  #Header-{{ s }} [data-palette='blue']   { --mc-bg: var(--blue-bg);   --mc-shadow: var(--ink); }
  #Header-{{ s }} [data-palette='pink']   { --mc-bg: var(--pink-bg);   --mc-shadow: var(--pink); }
  #Header-{{ s }} [data-palette='gold']   { --mc-bg: var(--gold-bg);   --mc-shadow: var(--gold); }
  #Header-{{ s }} [data-palette='green']  { --mc-bg: var(--green-bg);  --mc-shadow: var(--green); }
  #Header-{{ s }} [data-palette='purple'] { --mc-bg: var(--purple-bg); --mc-shadow: var(--purple); }

  /* --- Search panel -------------------------------------------------------
     A drop-down, not a full sheet: the page stays visible behind it, as the
     reference does. The fixed layer spans the viewport but is transparent —
     it exists to catch outside clicks and to let the panel scroll on a short
     screen. padding-top clears the bar's own height. */

  #Header-{{ s }} .hdr-search {
    position: fixed;
    inset: 0;
    z-index: 15;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 10.4rem 2rem 4rem;
  }

  #Header-{{ s }} .hdr-search-inner {
    margin-inline: auto;
    max-width: 92rem;
  }

  {%- comment -%}
    Field box: label stacked over the input, with the clear and submit
    controls sharing the same border. Not .btn — the reference keeps the field
    quiet so the results below carry the weight.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-search-form {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.2rem 0.8rem 1.6rem;
    background: var(--white);
    border: 2px solid var(--sky);
    border-radius: 0.8rem;
  }

  #Header-{{ s }} .hdr-search-field {
    display: flex;
    flex: 1;
    min-width: 0;
    flex-direction: column;
  }

  #Header-{{ s }} .hdr-search-label {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.3rem;
    line-height: 1.4;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  #Header-{{ s }} .hdr-search-input {
    width: 100%;
    padding: 0;
    font-family: var(--font-body);
    font-size: 1.8rem;
    line-height: 1.5;
    color: var(--ink);
    background: none;
    border: 0;
    -webkit-appearance: none;
    appearance: none;
  }

  #Header-{{ s }} .hdr-search-input:focus {
    outline: none;
  }

  #Header-{{ s }} .hdr-search-input::placeholder {
    color: var(--ink-soft);
  }

  /* The UA's own clear affordance would sit beside ours. */
  #Header-{{ s }} .hdr-search-input::-webkit-search-cancel-button {
    -webkit-appearance: none;
  }

  #Header-{{ s }} .hdr-search-clear,
  #Header-{{ s }} .hdr-search-go {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: none;
    height: 4.4rem;
    width: 4.4rem;
    padding: 0;
    color: var(--ink);
    background: none;
    border: 0;
    border-radius: 0.6rem;
    cursor: pointer;
  }

  #Header-{{ s }} .hdr-search-clear[hidden] {
    display: none;
  }

  #Header-{{ s }} .hdr-search-clear svg {
    height: 1.6rem;
    width: 1.6rem;
  }

  #Header-{{ s }} .hdr-search-go {
    border-left: 2px solid var(--sky);
    border-radius: 0;
    color: var(--blue);
  }

  #Header-{{ s }} .hdr-search-go svg {
    height: 2.2rem;
    width: 2.2rem;
  }

  #Header-{{ s }} .hdr-search-clear:hover,
  #Header-{{ s }} .hdr-search-go:hover {
    color: var(--pink);
  }

  {%- comment -%}
    Results arrive from sections/predictive-search.liquid, which ships markup
    only — everything below is its stylesheet. Empty until the first fetch,
    so the box only draws once it has something in it.
  {%- endcomment -%}
  #Header-{{ s }} .hdr-search-results:not(:empty) {
    margin-top: 1.2rem;
    background: var(--white);
    border: 2px solid var(--sky);
    border-radius: 1.2rem;
    overflow: hidden;
  }

  #Header-{{ s }} .psearch-cols {
    display: grid;
    grid-template-columns: 1fr 1.6fr;
    gap: 0 4rem;
    padding: 2.4rem 2.4rem 0.8rem;
  }

  #Header-{{ s }} .psearch-head {
    margin: 0 0 1.2rem;
    padding-bottom: 1rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.4;
    letter-spacing: 0.12rem;
    text-transform: uppercase;
    color: var(--ink-soft);
    border-bottom: 2px solid var(--sky);
  }

  #Header-{{ s }} .psearch-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #Header-{{ s }} .psearch-item,
  #Header-{{ s }} .psearch-product {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    padding-block: 1rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--ink);
  }

  {%- comment -%}
    styled_text marks the part that matched what was typed. Lightening it
    leaves the completion reading bold, which is the cue the reference gives.
  {%- endcomment -%}
  #Header-{{ s }} .psearch-item span {
    font-weight: 400;
    color: var(--ink-soft);
  }

  #Header-{{ s }} .psearch-item:hover,
  #Header-{{ s }} .psearch-product:hover {
    color: var(--blue);
  }

  #Header-{{ s }} .psearch-item:hover span {
    color: var(--blue);
  }

  #Header-{{ s }} .psearch-thumb {
    display: grid;
    place-items: center;
    flex: none;
    height: 6.2rem;
    width: 6.2rem;
    overflow: hidden;
    background: var(--blue-bg);
    border-radius: 0.6rem;
  }

  #Header-{{ s }} .psearch-thumb img {
    height: 100%;
    width: 100%;
    object-fit: contain;
  }

  {%- comment -%}
    Half the catalogue has no photography, so an empty thumb has to read as
    deliberate. It falls back to the product's character colour, the same cue
    the collection cards use.
  {%- endcomment -%}
  #Header-{{ s }} .psearch-thumb[data-pair='pink']   { background: var(--pink-bg); }
  #Header-{{ s }} .psearch-thumb[data-pair='blue']   { background: var(--blue-bg); }
  #Header-{{ s }} .psearch-thumb[data-pair='gold']   { background: var(--gold-bg); }
  #Header-{{ s }} .psearch-thumb[data-pair='green']  { background: var(--green-bg); }
  #Header-{{ s }} .psearch-thumb[data-pair='purple'] { background: var(--purple-bg); }

  #Header-{{ s }} .psearch-all {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    padding: 1.8rem 2.4rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2rem;
    line-height: 1.2;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    color: var(--ink);
    border-top: 2px solid var(--sky);
  }

  #Header-{{ s }} .psearch-all svg {
    flex: none;
    height: 1.4rem;
    width: 2rem;
  }

  #Header-{{ s }} .psearch-all:hover {
    color: var(--blue);
  }

  #Header-{{ s }} .psearch-empty {
    margin: 0;
    padding: 2.4rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
    text-align: center;
    color: var(--ink-soft);
  }

  /* --- Breakpoints -------------------------------------------------------- */

  @media screen and (max-width: 990px) {
    #Header-{{ s }} .hdr-mega {
      display: none;
    }

    {%- comment -%}
      Wherever the drawer is the nav mode, the bar takes the reference's
      phone arrangement: menu / logo / search with the logo centred. Tied to
      the same 990px breakpoint as the drawer so the two never disagree.
      Source order stays logo-first for the skip link; only columns reorder.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-grid {
      grid-template-columns: 1fr auto 1fr;
    }

    #Header-{{ s }} .hdr-menu-wrap {
      order: 1;
      justify-self: start;
    }

    #Header-{{ s }} .hdr-logo {
      order: 2;
      justify-self: center;
      margin-left: 0;
    }

    #Header-{{ s }} .hdr-actions {
      order: 3;
      flex-wrap: nowrap;
    }

    {%- comment -%}
      The CTA leaves the bar at the same breakpoint as the mega nav, for the
      same reason the pills do at 749: 1fr auto 1fr makes the two side tracks
      equal, so the actions column only ever gets half of what is left after
      the 176px logo. That is 245px at 750 and 365px at 990, against the
      452px the CTA and three pills want — the row wrapped to 177px tall
      across the whole range. Three pills alone need 223px and clear 245.

      Shrinking rather than hiding does not work here: at 750, pills held at
      the 44px touch-target floor leave the CTA 97px including its margin,
      and 'Find In Store' does not survive a 78px button.

      The drawer lists section.settings.menu, not this CTA, so below 991px
      the destination is only reachable if that menu carries it too. Worth a
      drawer copy of the CTA if it ever points somewhere the menu does not.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-cta {
      display: none;
    }
  }

  @media screen and (min-width: 991px) {
    #Header-{{ s }} .hdr-drawer {
      display: none;
    }
  }

  @media screen and (max-width: 749px) {
    {%- comment -%}
      Column order is set at the 990px drawer breakpoint above.

      The gap is 0.6rem here, not 1rem, because 1fr auto 1fr splits the space
      left over after the logo evenly: at 360px that left the actions column
      106px to hold two 5rem pills and their gap, which need 108px, and the
      row wrapped to 137px tall. Two pixels. Trimming both gaps buys the
      column 110px and keeps the logo centred, which shrinking the pills to
      fit would not — they are already at the 44px touch-target floor.

      The compact band below also supports 320px without wrapping either icon.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-grid {
      padding-inline: 1rem;
      gap: 0.6rem;
    }

    {%- comment -%}
      At 12rem minimum only two buttons fit a phone row, which stranded the
      fourth link alone on a full-width row. 9rem lets the three that follow
      the featured link share one row, as the reference does.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-drawer-links .btn-wrap {
      min-width: 9rem;
    }

    #Header-{{ s }} .hdr-drawer-links .btn {
      padding: 1rem 0.8rem;
      font-size: var(--button-text-size);
    }

    {%- comment -%}
      Reference mobile header carries three controls: menu, logo, search.
      The CTA already left at 990; the account pill drops out here as well,
      so the bar keeps menu / logo / search + cart. Cart stays, it is commerce.

      A third icon genuinely does not fit. .hdr-grid is 1fr auto 1fr, and those
      two 1fr tracks are equal, so the menu column reserves whatever the
      actions column needs — three 5rem pills demand 150px a side, which with
      the 110px logo is 430px of appetite inside 342px of room, and the row
      wraps to 195px tall. Shrinking the pills does not rescue it: even at the
      44px touch-target floor the two tracks still want 264px of the 342.

      So the account component moves into the drawer at this width instead,
      which is where .hdr-drawer-account renders it.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-icon--account {
      display: none;
    }

    #Header-{{ s }} .hdr-logo img,
    #Header-{{ s }} .hdr-logo svg {
      /* ponytail: React keeps the 300px width here, which squashes the mark.
         Width follows the art instead; drop this rule to match React exactly.
         5rem (~82px wide) leaves room for all three icon pills on one line
         from 360px up. */
      height: 5rem;
      width: auto;
      max-width: min(11rem, calc(100vw - 23rem));
    }

    {%- comment -%}
      The logo drops to 5rem here but the menu blob and icon pills keep their
      desktop heights, leaving the burger half again taller than the mark.
      Everything in the row is pinned to the logo's 5rem so the three read as
      one line. The blob keeps its 83:75 ratio; the pills stay square.
      5rem is still a 50px touch target, above the 44px minimum.
    {%- endcomment -%}
    #Header-{{ s }} .hdr-menu {
      height: 5rem;
      width: 5.5rem;
    }

    #Header-{{ s }} .hdr-menu .icon-burger {
      height: 2.8rem;
      width: 3.3rem;
    }

    #Header-{{ s }} .hdr-menu .icon-close {
      height: 1.4rem;
      width: 1.4rem;
    }

    #Header-{{ s }} .hdr-actions {
      gap: 0.6rem;
      margin-right: 0;
    }

    #Header-{{ s }} .hdr-icon {
      height: 5rem;
      width: 5rem;
      justify-content: center;
    }

    #Header-{{ s }} .hdr-icon + .hdr-icon {
      margin-left: 0;
    }

    #Header-{{ s }} .hdr-icon > span {
      height: 3.2rem;
      width: 3.2rem;
    }

    #Header-{{ s }} .hdr-icon svg {
      height: 2.8rem;
      width: 2.8rem;
    }

    #Header-{{ s }} .hdr-count {
      top: 0.2rem;
      right: 0.2rem;
      min-width: 1.8rem;
      padding: 0 0.4rem;
      font-size: 1.3rem;
      line-height: 1.8rem;
    }

    /* The bar is shorter here (5rem controls), so the panel needs less clearance. */
    #Header-{{ s }} .hdr-search {
      padding: 8.4rem 1.5rem 4rem;
    }

    {%- comment -%}
      Columns stack, so the products list needs a rule above it to stay
      readable as a separate group once it is no longer beside the other.
    {%- endcomment -%}
    #Header-{{ s }} .psearch-cols {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 2rem 1.6rem 0.4rem;
    }

    #Header-{{ s }} .psearch-col + .psearch-col {
      margin-top: 2rem;
    }

    #Header-{{ s }} .psearch-all {
      padding: 1.6rem;
    }
  }

  @media screen and (max-width: 359px) {
    #Header-{{ s }} .hdr-logo img,
    #Header-{{ s }} .hdr-logo svg {
      height: 4.4rem;
    }
    #Header-{{ s }} .hdr-menu,
    #Header-{{ s }} .hdr-icon {
      height: var(--touch-target);
      width: var(--touch-target);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #Header-{{ s }} .hdr-card,
    #Header-{{ s }} .hdr-drawer-links .btn-shadow,
    #Header-{{ s }} .hdr-mega-link {
      transition: none;
    }

    #Header-{{ s }} .hdr-card:hover {
      transform: none;
    }
  }
{%- endstyle -%}

<div id="Header-{{ s }}" data-open="false" data-search="false">
  <div class="hdr-overlay" data-hdr-close aria-hidden="true"></div>

  <header class="hdr-bar">
    <div class="hdr-grid">
      <a href="{{ routes.root_url }}" class="hdr-logo" aria-label="{{ shop.name | escape }}">
        {%- if section.settings.logo != blank -%}
          {{
            section.settings.logo
            | image_url: width: 900
            | image_tag: alt: shop.name, width: section.settings.logo_width, loading: 'eager'
          }}
        {%- else -%}
          <img
            src="{{ 'jjw-logo.png' | asset_url }}"
            alt="{{ shop.name | escape }}"
            width="1774"
            height="887"
          >
        {%- endif -%}
      </a>

      <div class="hdr-menu-wrap btn-wrap">
        <span class="btn-shadow" aria-hidden="true"></span>
        <button
          type="button"
          class="hdr-menu"
          data-hdr-toggle
          aria-expanded="false"
          aria-controls="HeaderMega-{{ s }} HeaderDrawer-{{ s }}"
          aria-label="{{ 'sections.header.menu' | t }}"
        >
          <svg class="icon-burger" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 16" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M1 .5a.5.5 0 1 0 0 1h15.71a.5.5 0 0 0 0-1zM.5 8a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1A.5.5 0 0 1 .5 8m0 7a.5.5 0 0 1 .5-.5h15.71a.5.5 0 0 1 0 1H1a.5.5 0 0 1-.5-.5"/>
          </svg>
          <svg class="icon-close" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 18 17" aria-hidden="true" focusable="false">
            <path fill="currentColor" d="M.865 15.978a.5.5 0 0 0 .707.707l7.433-7.431 7.579 7.282a.501.501 0 0 0 .846-.37.5.5 0 0 0-.153-.351L9.712 8.546l7.417-7.416a.5.5 0 1 0-.707-.708L8.991 7.853 1.413.573a.5.5 0 1 0-.693.72l7.563 7.268z"/>
          </svg>
        </button>
      </div>

      <div class="hdr-actions">
        {%- if section.settings.cta_text != blank -%}
          <a href="{{ section.settings.cta_url | default: routes.root_url }}" class="hdr-cta btn-wrap">
            <span class="btn-shadow" aria-hidden="true"></span>
            <span class="btn">{{ section.settings.cta_text | escape }}</span>
          </a>
        {%- endif -%}

        {%- comment -%}
          Still an anchor, not a button: with JS off it navigates to /search,
          which is a real page. The script cancels the navigation and opens
          the panel instead.
        {%- endcomment -%}
        {%- if section.settings.show_search -%}
          <a
            href="{{ routes.search_url }}"
            class="hdr-icon"
            data-hdr-search-toggle
            aria-controls="HeaderSearch-{{ s }}"
            aria-expanded="false"
            aria-label="{{ 'general.search.search' | t }}"
          >
            <span>
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 1 1 2.85 3.5a5.784 5.784 0 0 1 8.18 8.18m.26 1.12a6.78 6.78 0 1 1 .72-.7l5.4 5.4a.5.5 0 1 1-.71.7z"/>
              </svg>
            </span>
          </a>
        {%- endif -%}

        {%- comment -%}
          Shopify's own account component, not a link to /account. The store
          runs new customer accounts, so a plain link 302s the shopper off to
          shopify.com/authentication — an unbranded page we cannot touch below
          the Plus plan. This opens a sign-in sheet on the storefront instead,
          so they never leave JJW. Passwordless, Sign in with Shop and social
          providers all come with it.

          The signed-out-avatar slot takes our own person icon, so the control
          keeps the same blue pill as search and cart. Shopify owns the sheet
          and can change it independently of the theme; the CSS variables above
          are the whole extent of what we control.
        {%- endcomment -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <span class="hdr-icon hdr-icon--account">
            <shopify-account menu="customer-account-main-menu">
              <span slot="signed-out-avatar" class="hdr-account-avatar">
                <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                  <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 1.5a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5M6.25 5.25a2.75 2.75 0 1 1 5.5 0 2.75 2.75 0 0 1-5.5 0M9 10.5c-3.6 0-6.5 2.4-6.5 5.36 0 .84.7 1.52 1.55 1.52h9.9c.86 0 1.55-.68 1.55-1.52 0-2.96-2.9-5.36-6.5-5.36m-5.5 5.36c0-2.32 2.36-4.36 5.5-4.36s5.5 2.04 5.5 4.36c0 .29-.24.52-.55.52h-9.9a.54.54 0 0 1-.55-.52"/>
                </svg>
              </span>
            </shopify-account>
          </span>
        {%- endif -%}

        {%- comment -%}
          Still an anchor to /cart: with JS off it navigates to the cart page,
          which is a real template. The drawer script cancels the navigation and
          opens instead. The badge always renders, hidden at zero, so JS can
          update it in place rather than having to build the element the first
          time something is added.
        {%- endcomment -%}
        {%- if section.settings.show_cart -%}
          <a
            href="{{ routes.cart_url }}"
            class="hdr-icon"
            data-cart-open
            aria-label="{{ 'sections.header.cart_count' | t }}"
          >
            <span>
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 1.5A3.25 3.25 0 0 0 5.75 4.75V5.5H3.4a1 1 0 0 0-.996.91l-.9 9.9A1.5 1.5 0 0 0 3 18h12a1.5 1.5 0 0 0 1.494-1.69l-.9-9.9A1 1 0 0 0 14.6 5.5h-2.35v-.75A3.25 3.25 0 0 0 9 1.5m2.25 5h3.35l.9 9.9a.5.5 0 0 1-.5.6H3a.5.5 0 0 1-.5-.6l.9-9.9h3.35v2a.5.5 0 0 0 1 0v-2h2.5v2a.5.5 0 0 0 1 0zm-1-1h-4.5v-.75a2.25 2.25 0 0 1 4.5 0z"/>
              </svg>
            </span>
            <span
              class="hdr-count"
              data-cart-count
              aria-hidden="true"
              {% if cart.item_count == 0 %}hidden{% endif %}
            >
              {{- cart.item_count -}}
            </span>
          </a>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%} Desktop mega panel — hidden at 990px and below, per React. {%- endcomment -%}
    <div
      id="HeaderMega-{{ s }}"
      class="hdr-mega"
      role="navigation"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <div class="hdr-mega-inner">
        <div class="hdr-mega-links">
          <ul>
            {%- for link in section.settings.menu.links -%}
              <li>
                {%- if link.active or link.child_active -%}
                  <div class="btn-wrap">
                    <span class="btn-shadow" aria-hidden="true"></span>
                    <a href="{{ link.url }}" class="btn" aria-current="page">{{ link.title | escape }}</a>
                  </div>
                {%- else -%}
                  <a href="{{ link.url }}" class="hdr-mega-link">{{ link.title | escape }}</a>
                {%- endif -%}
              </li>
            {%- endfor -%}
          </ul>
        </div>

        <div class="hdr-mega-cards">
          <h3 class="hdr-mega-spacer" aria-hidden="true">{{ section.settings.cards_heading | escape }}</h3>
          <div class="hdr-mega-grid">
            {%- for block in section.blocks -%}
              {%- render 'header-card', block: block -%}
            {%- endfor -%}
          </div>
        </div>
      </div>
    </div>

    {%- comment -%} Mobile drawer — hidden at 991px and above, per React. {%- endcomment -%}
    <div
      id="HeaderDrawer-{{ s }}"
      class="hdr-drawer"
      role="dialog"
      aria-modal="true"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <div class="hdr-drawer-inner">
        <div class="hdr-drawer-links">
          {%- for link in section.settings.menu.links -%}
            <div class="btn-wrap{% if link.active or link.child_active %} is-active{% endif %}">
              <span class="btn-shadow" aria-hidden="true"></span>
              <a
                href="{{ link.url }}"
                class="btn"
                {% if link.active or link.child_active %}
                  aria-current="page"
                {% endif %}
              >
                {{- link.title | escape -}}
              </a>
            </div>
          {%- endfor -%}
        </div>

        <div class="hdr-drawer-grid">
          {%- for block in section.blocks -%}
            {%- render 'header-card', block: block, style: 'drawer' -%}
          {%- endfor -%}
        </div>

        {%- comment -%}
          The account pill cannot fit the phone bar (see the 749px block), so
          the component renders here as well. Two instances of it exist on the
          page and CSS hides whichever does not belong at the current width —
          the ordinary responsive-header pattern, and the component tolerates
          it because each keeps its own shadow root.
        {%- endcomment -%}
        {%- if section.settings.show_account and shop.customer_accounts_enabled -%}
          <div class="hdr-drawer-account">
            <shopify-account menu="customer-account-main-menu">
              <span slot="signed-out-avatar" class="hdr-account-avatar">
                <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                  <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M9 1.5a3.75 3.75 0 1 0 0 7.5 3.75 3.75 0 0 0 0-7.5M6.25 5.25a2.75 2.75 0 1 1 5.5 0 2.75 2.75 0 0 1-5.5 0M9 10.5c-3.6 0-6.5 2.4-6.5 5.36 0 .84.7 1.52 1.55 1.52h9.9c.86 0 1.55-.68 1.55-1.52 0-2.96-2.9-5.36-6.5-5.36m-5.5 5.36c0-2.32 2.36-4.36 5.5-4.36s5.5 2.04 5.5 4.36c0 .29-.24.52-.55.52h-9.9a.54.54 0 0 1-.55-.52"/>
                </svg>
              </span>
            </shopify-account>
            <span class="hdr-drawer-account-label">{{ section.settings.account_label | escape }}</span>
          </div>
        {%- endif -%}
      </div>
    </div>

    {%- comment -%}
      Search panel. A child of .hdr-bar like the drawer and the mega panel, so
      the bar's stacking context governs all three the same way.
    {%- endcomment -%}
    {%- if section.settings.show_search -%}
      <div
        id="HeaderSearch-{{ s }}"
        class="hdr-search"
        role="dialog"
        aria-modal="true"
        aria-label="{{ 'general.search.search' | t }}"
      >
        <div class="hdr-search-inner">
          {%- comment -%}
            Prefix matching is applied by theme.js on submit — see the note
            there on why options[prefix] is not used.

            The label sits above the field inside the same bordered box, as
            the reference does, so it is visible type rather than a
            placeholder that vanishes the moment anyone types.
          {%- endcomment -%}
          <form action="{{ routes.search_url }}" method="get" role="search" class="hdr-search-form">
            <input type="hidden" name="type" value="product">

            <span class="hdr-search-field">
              <label class="hdr-search-label" for="HeaderSearchInput-{{ s }}">
                {{- 'general.search.search' | t -}}
              </label>
              <input
                id="HeaderSearchInput-{{ s }}"
                class="hdr-search-input"
                type="search"
                name="q"
                placeholder="{{ section.settings.search_placeholder | escape }}"
                autocomplete="off"
                autocorrect="off"
                spellcheck="false"
                data-hdr-search-input
              >
            </span>

            <button
              type="button"
              class="hdr-search-clear"
              data-hdr-search-clear
              hidden
              aria-label="{{ 'general.search.clear' | t }}"
            >
              <svg viewBox="0 0 14 14" fill="none" aria-hidden="true" focusable="false">
                <path
                  fill="currentColor"
                  d="M.65 13.35a.5.5 0 0 0 .7 0L7 7.71l5.65 5.64a.5.5 0 0 0 .7-.7L7.71 7l5.64-5.65a.5.5 0 1 0-.7-.7L7 6.29 1.35.65a.5.5 0 1 0-.7.7L6.29 7 .65 12.65a.5.5 0 0 0 0 .7"
                />
              </svg>
            </button>

            <button type="submit" class="hdr-search-go" aria-label="{{ 'general.search.search' | t }}">
              <svg fill="none" viewBox="0 0 18 19" aria-hidden="true" focusable="false">
                <path fill="currentColor" fill-rule="evenodd" clip-rule="evenodd" d="M11.03 11.68A5.784 5.784 0 1 1 2.85 3.5a5.784 5.784 0 0 1 8.18 8.18m.26 1.12a6.78 6.78 0 1 1 .72-.7l5.4 5.4a.5.5 0 1 1-.71.7z"/>
              </svg>
            </button>
          </form>

          {%- comment -%}
            The live region is this container, which survives every fetch.
            Declaring it on the injected markup instead would insert a region
            that is already populated, which is not reliably announced.
          {%- endcomment -%}
          <div class="hdr-search-results" data-hdr-search-results aria-live="polite"></div>
        </div>
      </div>
    {%- endif -%}
  </header>
</div>

<script>
  (function () {
    var root = document.getElementById('Header-{{ s }}');
    if (!root || root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    var toggle = root.querySelector('[data-hdr-toggle]');
    var searchToggle = root.querySelector('[data-hdr-search-toggle]');
    var searchInput = root.querySelector('[data-hdr-search-input]');
    var searchResults = root.querySelector('[data-hdr-search-results]');

    function lockScroll() {
      var any = root.dataset.open === 'true' || root.dataset.search === 'true';
      document.body.style.overflow = any ? 'hidden' : '';
    }

    // The cart drawer is a separate section with its own overlay. Announce so it
    // can stand down rather than two scrims stacking.
    function announceOpen() {
      document.dispatchEvent(new CustomEvent('jjw:header-open'));
    }

    function setOpen(open) {
      root.dataset.open = open ? 'true' : 'false';
      toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        setSearch(false);
        announceOpen();
      }
      lockScroll();
    }

    function setSearch(open) {
      if (!searchToggle) return;
      root.dataset.search = open ? 'true' : 'false';
      searchToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
      if (open) {
        setOpen(false);
        announceOpen();
        // iOS will not focus an input from a handler that also ran a fetch,
        // so focus first and let the query fire on the next keystroke.
        searchInput.focus();
      }
      lockScroll();
    }

    // Symmetric: the cart drawer closes these when it opens.
    document.addEventListener('jjw:cart-open', function () {
      if (!root.isConnected) return;
      if (root.dataset.open === 'true') setOpen(false);
      if (root.dataset.search === 'true') setSearch(false);
    });

    toggle.addEventListener('click', function () {
      setOpen(root.dataset.open !== 'true');
    });

    root.querySelector('[data-hdr-close]').addEventListener('click', function () {
      setOpen(false);
      setSearch(false);
    });

    document.addEventListener('keydown', function (e) {
      // Section may have been swapped out by the theme editor.
      if (!root.isConnected) return;
      if (e.key !== 'Escape') return;
      if (root.dataset.search === 'true') {
        setSearch(false);
        searchToggle.focus();
      } else if (root.dataset.open === 'true') {
        setOpen(false);
        toggle.focus();
      }
    });

    if (!searchToggle) return;

    searchToggle.addEventListener('click', function (e) {
      // The href is the no-JS fallback to /search; here we open the panel.
      e.preventDefault();
      setSearch(root.dataset.search !== 'true');
    });

    /* Predictive search. Shopify renders sections/predictive-search.liquid for
       us, so the character colour logic stays in Liquid instead of being
       reimplemented here. */
    var controller = null;
    var timer = null;
    var lastTerm = '';

    function render(term) {
      if (term === lastTerm) return;
      lastTerm = term;

      if (controller) controller.abort();

      if (term.length < 2) {
        searchResults.innerHTML = '';
        return;
      }

      controller = new AbortController();
      // Trailing * is what actually gives prefix matching here — "adven"
      // returns nothing, "adven*" finds the Adventure Tee. See theme.js.
      var query = term.slice(-1) === '*' ? term : term + '*';
      fetch(
        '{{ routes.predictive_search_url }}?q=' +
          encodeURIComponent(query) +
          '&resources[type]=query,product,collection&resources[limit]=5' +
          '&section_id=predictive-search',
        { signal: controller.signal }
      )
        .then(function (res) {
          if (!res.ok) throw new Error(res.status);
          return res.text();
        })
        .then(function (html) {
          var doc = new DOMParser().parseFromString(html, 'text/html');
          var section = doc.getElementById('shopify-section-predictive-search');
          searchResults.innerHTML = section ? section.innerHTML : '';
        })
        .catch(function (err) {
          // An aborted request is the expected outcome of typing quickly.
          if (err.name === 'AbortError') return;
          searchResults.innerHTML = '';
        });
    }

    var searchPanel = root.querySelector('.hdr-search');
    var searchInner = root.querySelector('.hdr-search-inner');
    var searchClear = root.querySelector('[data-hdr-search-clear]');

    function syncClear() {
      searchClear.hidden = searchInput.value === '';
    }

    searchInput.addEventListener('input', function () {
      var term = searchInput.value.trim();
      syncClear();
      clearTimeout(timer);
      timer = setTimeout(function () {
        render(term);
      }, 250);
    });

    searchClear.addEventListener('click', function () {
      searchInput.value = '';
      syncClear();
      lastTerm = '';
      if (controller) controller.abort();
      searchResults.innerHTML = '';
      searchInput.focus();
    });

    // No scrim to click, so the transparent layer itself dismisses.
    searchPanel.addEventListener('click', function (e) {
      if (searchInner.contains(e.target)) return;
      setSearch(false);
      searchToggle.focus();
    });
  })();
</script>

{% schema %}
{
  "name": "Header",
  "tag": "section",
  "class": "jjw-header-section",
  "enabled_on": { "groups": ["header"] },
  "max_blocks": 10,
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo",
      "info": "Falls back to the built-in JJW logo."
    },
    {
      "type": "range",
      "id": "logo_width",
      "label": "Logo width",
      "min": 120,
      "max": 400,
      "step": 10,
      "unit": "px",
      "default": 300
    },
    {
      "type": "link_list",
      "id": "menu",
      "label": "Menu",
      "default": "main-menu",
      "info": "Shown in the mega menu and the mobile drawer."
    },
    {
      "type": "header",
      "content": "Call to action"
    },
    {
      "type": "text",
      "id": "cta_text",
      "label": "Button text",
      "default": "Find In Store"
    },
    {
      "type": "url",
      "id": "cta_url",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Icons"
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Show search",
      "default": true
    },
    {
      "type": "text",
      "id": "search_placeholder",
      "label": "Search placeholder",
      "default": "Try a character, colour or age"
    },
    {
      "type": "checkbox",
      "id": "show_account",
      "label": "Show account",
      "default": true
    },
    {
      "type": "text",
      "id": "account_label",
      "label": "Account label",
      "default": "Account"
    },
    {
      "type": "checkbox",
      "id": "show_cart",
      "label": "Show cart",
      "default": true
    },
    {
      "type": "header",
      "content": "Mega menu cards"
    },
    {
      "type": "text",
      "id": "cards_heading",
      "label": "Card group heading",
      "default": "Products",
      "info": "Reserves vertical space above the cards; not shown to sighted users."
    }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Card",
      "settings": [
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Characters"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        },
        {
          "type": "select",
          "id": "character",
          "label": "Character",
          "info": "Supplies the card artwork from the theme's built-in face stickers when no image is uploaded.",
          "default": "jevika",
          "options": [
            { "value": "jevika", "label": "Jevika" },
            { "value": "joy", "label": "Joy" },
            { "value": "brutus", "label": "Brutus" },
            { "value": "minku", "label": "Minku" },
            { "value": "pinki", "label": "Pinki" },
            { "value": "", "label": "None" }
          ]
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Optional. Overrides the built-in character sticker."
        },
        {
          "type": "select",
          "id": "palette",
          "label": "Colour",
          "default": "sky",
          "options": [
            { "value": "sky", "label": "Sky" },
            { "value": "blue", "label": "Blue" },
            { "value": "pink", "label": "Pink" },
            { "value": "gold", "label": "Gold" },
            { "value": "green", "label": "Green" },
            { "value": "purple", "label": "Purple" }
          ]
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Header",
      "blocks": [
        { "type": "card", "settings": { "label": "Jevika", "palette": "pink" } },
        { "type": "card", "settings": { "label": "Joy", "palette": "sky" } },
        { "type": "card", "settings": { "label": "Brutus", "palette": "gold" } },
        { "type": "card", "settings": { "label": "Minku", "palette": "green" } },
        { "type": "card", "settings": { "label": "Pinki", "palette": "purple" } }
      ]
    }
  ]
}
{% endschema %}
