{%- comment -%}
  Hero — converted from the React component at
  src/components/site/hero.tsx (plus stickers.tsx / button.tsx, which it
  composes). DOM order, spacing and sizing follow that file exactly:
  16/10 media box (16/9 under 750px), absolutely positioned cover image,
  centred copy column, hard text-shadow on the headline.

  Button, marquee-free layout and the reveal animation all come from
  theme.css — nothing is re-implemented here.
{%- endcomment -%}

{%- style -%}
  #Hero-{{ section.id }} {
    position: relative;
  }

  /* Keep the hero within one screen. 16/10 alone overflows on most viewports
     (1920x1080 would compute to 1200px), so cap it and let the image crop.
     dvh follows mobile browser chrome; the vh line is the fallback. */
  #Hero-{{ section.id }} {
    background: {{ section.settings.backdrop_color }};
  }

  #Hero-{{ section.id }} .hero__media {
    position: relative;
    width: 100%;
    aspect-ratio: 16 / 10;
    max-height: 100vh;
    max-height: 100dvh;
  }

  #Hero-{{ section.id }} .hero__image {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  #Hero-{{ section.id }} .hero__layer {
    position: absolute;
    inset: 0;
    display: flex;
    align-items: center;
  }

  #Hero-{{ section.id }} .hero__inner {
    width: 100%;
  }

  #Hero-{{ section.id }} .hero__text {
    max-width: 67rem;
    padding-block: 4rem;
    padding-left: 8rem;
  }

  /* The hero art is a #034CA2 royal-blue field. Navy measured 1.59:1 against it
     (invisible); cream measures 7.67:1. The hard shadow goes to a deeper blue so
     it reads as depth on the field rather than as a second colour. */
  #Hero-{{ section.id }} .hero__heading {
    color: {{ section.settings.heading_color }};
    text-shadow: 5px 5px 0 {{ section.settings.heading_shadow }};
  }

  #Hero-{{ section.id }} .hero__cta {
    margin-top: 2.4rem;
  }

  #Hero-{{ section.id }} .hero__cta .btn {
    padding-inline: 3.6rem;
  }

  #Hero-{{ section.id }} .hero__stickers {
    position: absolute;
    inset: 0;
    z-index: 100;
    pointer-events: none;
  }

  #Hero-{{ section.id }} .hero__sticker {
    position: absolute;
    right: 5%;
  }

  #Hero-{{ section.id }} .hero__sticker img {
    width: 100%;
    height: auto;
  }

  #Hero-{{ section.id }} .hero__sticker--1 {
    top: 35vh;
    width: 25rem;
    height: 25rem;
  }

  #Hero-{{ section.id }} .hero__sticker--2 {
    top: 55vh;
    width: 30rem;
    height: 30rem;
  }

  /* Text stickers: tilted tags pinned over the artwork, no PNG required. */
  #Hero-{{ section.id }} .hero__tag {
    position: absolute;
    z-index: 101;
    left: var(--tag-x, 78%);
    top: var(--tag-y, 42%);
    display: block;
    padding: 1.1rem 2rem 1rem;
    border-radius: 0.4rem;
    background: var(--tag-bg, var(--pink));
    color: var(--tag-fg, var(--cream));
    box-shadow: 5px 5px 0 0 var(--tag-shadow, rgba(0, 0, 0, 0.18));
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2.6rem;
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-wrap: balance;
    max-width: 22rem;
    transform: rotate(var(--rot, -8deg));
    transform-origin: center;
    animation: jjw-hero-tag 7s ease-in-out infinite;
    animation-delay: var(--tag-delay, 0s);
    pointer-events: none;
  }

  @keyframes jjw-hero-tag {
    0%   { transform: rotate(var(--rot, -8deg)) translateY(-12px) scale(0.92); }
    5%   { transform: rotate(var(--rot, -8deg)) translateY(0) scale(1.05); }
    9%   { transform: rotate(var(--rot, -8deg)) translateY(-7px) scale(1); }
    13%  { transform: rotate(var(--rot, -8deg)) translateY(0) scale(1.02); }
    17%  { transform: rotate(var(--rot, -8deg)) translateY(-3px) scale(1); }
    21%, 100% { transform: rotate(var(--rot, -8deg)) translateY(0) scale(1); }
  }

  @media screen and (max-width: 749px) {
    #Hero-{{ section.id }} .hero__tag {
      font-size: 1.5rem;
      padding: 0.7rem 1.2rem 0.6rem;
      max-width: 13rem;
      box-shadow: 3px 3px 0 0 var(--tag-shadow, rgba(0, 0, 0, 0.18));
    }
  }

  @media screen and (max-width: 749px) {
    #Hero-{{ section.id }} .hero__media {
      /* 16/9 collapsed the hero to ~314px on a phone. The reference fills most
         of the screen, so switch to a portrait ratio with a viewport floor. */
      aspect-ratio: 3 / 4;
      min-height: 86vh;
      min-height: 86dvh;
      max-height: 100dvh;
    }

    #Hero-{{ section.id }} .hero__text {
      padding-left: 2rem;
      padding-right: 2rem;
      /* Clear the fixed header, which overlays the hero. */
      padding-top: 12rem;
      padding-bottom: 4rem;
    }

    /* Reference sits the copy low in the frame rather than centred. */
    #Hero-{{ section.id }} .hero__layer {
      align-items: flex-end;
    }

    #Hero-{{ section.id }} .hero__heading {
      font-size: 4.4rem;
    }

    #Hero-{{ section.id }} .hero__stickers {
      display: none;
    }
  }
{%- endstyle -%}

{%- liquid
  assign hero_image = section.settings.image
  assign hero_alt = section.settings.image_alt | escape
  assign cta_url = section.settings.button_link | default: routes.all_products_collection_url
-%}

<section
  id="Hero-{{ section.id }}"
  class="banner-section scroll-trigger animate--fade-in"
>
  {%- for i in (1..2) -%}
    {%- if i == 1 -%}
      {%- assign tg = section.settings.tag_one_text -%}
      {%- assign tbg = section.settings.tag_one_bg -%}
      {%- assign tfg = section.settings.tag_one_fg -%}
      {%- assign tx = section.settings.tag_one_x -%}
      {%- assign ty = section.settings.tag_one_y -%}
      {%- assign tr = section.settings.tag_one_rotate -%}
      {%- assign td = '0s' -%}
    {%- else -%}
      {%- assign tg = section.settings.tag_two_text -%}
      {%- assign tbg = section.settings.tag_two_bg -%}
      {%- assign tfg = section.settings.tag_two_fg -%}
      {%- assign tx = section.settings.tag_two_x -%}
      {%- assign ty = section.settings.tag_two_y -%}
      {%- assign tr = section.settings.tag_two_rotate -%}
      {%- assign td = '0.5s' -%}
    {%- endif -%}
    {%- if tg != blank -%}
      <span
        class="hero__tag"
        aria-hidden="true"
        style="--tag-x:{{ tx }}%;--tag-y:{{ ty }}%;--rot:{{ tr }}deg;--tag-bg:{{ tbg }};--tag-fg:{{ tfg }};--tag-shadow:{{ tbg | color_darken: 18 }};--tag-delay:{{ td }};"
      >{{ tg | escape }}</span>
    {%- endif -%}
  {%- endfor -%}

  {%- if section.settings.sticker_1 != blank or section.settings.sticker_2 != blank -%}
    <div class="hero__stickers" aria-hidden="true">
      {%- if section.settings.sticker_1 != blank -%}
        <div class="hero__sticker hero__sticker--1">
          {{ section.settings.sticker_1 | image_url: width: 500 | image_tag: alt: '', loading: 'eager', widths: '250, 500' }}
        </div>
      {%- endif -%}
      {%- if section.settings.sticker_2 != blank -%}
        <div class="hero__sticker hero__sticker--2">
          {{ section.settings.sticker_2 | image_url: width: 600 | image_tag: alt: '', loading: 'eager', widths: '300, 600' }}
        </div>
      {%- endif -%}
    </div>
  {%- endif -%}

  <div class="hero__media scroll-trigger animate--fade-in">
    {%- if hero_image != blank -%}
      {{
        hero_image
        | image_url: width: 2400
        | image_tag:
          class: 'hero__image',
          alt: hero_alt,
          loading: 'eager',
          fetchpriority: 'high',
          sizes: '100vw',
          widths: '600, 900, 1200, 1600, 2000, 2400'
      }}
    {%- else -%}
      <img
        class="hero__image"
        src="{{ 'jjw-hero.png' | asset_url }}"
        alt="{{ hero_alt }}"
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}

    <div class="hero__layer">
      <div class="hero__inner page-width">
        <div class="hero__text scroll-trigger animate--slide-in">
          {%- if section.settings.heading != blank -%}
            <h2 class="hxxl hero__heading">{{ section.settings.heading | escape }}</h2>
          {%- endif -%}

          {%- if section.settings.button_label != blank -%}
            <div class="hero__cta">
              <span class="btn-wrap">
                <span class="btn-shadow" aria-hidden="true"></span>
                <a class="btn btn--primary" href="{{ cta_url }}">
                  {{- section.settings.button_label | escape -}}
                </a>
              </span>
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "header",
      "content": "Colour"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading",
      "default": "#FFF6EB"
    },
    {
      "type": "color",
      "id": "heading_shadow",
      "label": "Heading shadow",
      "default": "#012F66"
    },
    {
      "type": "color",
      "id": "backdrop_color",
      "label": "Backdrop behind image",
      "default": "#034CA2",
      "info": "Matches the artwork's field so any crop edge blends."
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero image",
      "info": "Falls back to jjw-hero.png when empty."
    },
    {
      "type": "text",
      "id": "image_alt",
      "label": "Hero image alt text",
      "default": "Jevika and Joy's World characters"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Tees Every Kid Can Call Their Own"
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the Squad"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "header",
      "content": "Stickers"
    },
    {
      "type": "image_picker",
      "id": "sticker_1",
      "label": "Sticker 1",
      "info": "Decorative, hidden under 750px. Nothing renders when empty."
    },
    {
      "type": "image_picker",
      "id": "sticker_2",
      "label": "Sticker 2"
    },
    {
      "type": "header",
      "content": "Floating tags"
    },
    {
      "type": "paragraph",
      "content": "Tilted labels over the artwork. Leave text blank to hide one. Position is a percentage of the hero, from its top-left."
    },
    {
      "type": "text",
      "id": "tag_one_text",
      "label": "Tag 1 text",
      "default": "Soft on skin"
    },
    {
      "type": "color",
      "id": "tag_one_bg",
      "label": "Tag 1 background",
      "default": "#E5377E"
    },
    {
      "type": "color",
      "id": "tag_one_fg",
      "label": "Tag 1 text colour",
      "default": "#FFF6EB"
    },
    {
      "type": "range",
      "id": "tag_one_x",
      "label": "Tag 1 across",
      "min": 0,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 78
    },
    {
      "type": "range",
      "id": "tag_one_y",
      "label": "Tag 1 down",
      "min": 0,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 40
    },
    {
      "type": "range",
      "id": "tag_one_rotate",
      "label": "Tag 1 tilt",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "deg",
      "default": -8
    },
    {
      "type": "text",
      "id": "tag_two_text",
      "label": "Tag 2 text",
      "default": "Built for play"
    },
    {
      "type": "color",
      "id": "tag_two_bg",
      "label": "Tag 2 background",
      "default": "#59C8F6"
    },
    {
      "type": "color",
      "id": "tag_two_fg",
      "label": "Tag 2 text colour",
      "default": "#1A2F5E"
    },
    {
      "type": "range",
      "id": "tag_two_x",
      "label": "Tag 2 across",
      "min": 0,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 74
    },
    {
      "type": "range",
      "id": "tag_two_y",
      "label": "Tag 2 down",
      "min": 0,
      "max": 92,
      "step": 1,
      "unit": "%",
      "default": 66
    },
    {
      "type": "range",
      "id": "tag_two_rotate",
      "label": "Tag 2 tilt",
      "min": -20,
      "max": 20,
      "step": 1,
      "unit": "deg",
      "default": 7
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
