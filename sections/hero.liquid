{%- comment -%}
  Paper Boat campaign: character-led art with editable shopping copy.
  Use native landscape and portrait compositions so none of the five friends
  is lost to a cover crop. Content participates in layout when copy grows.
{%- endcomment -%}

{%- liquid
  assign desktop_image = section.settings.image
  assign mobile_image = section.settings.mobile_image
  assign cta_url = section.settings.button_link | default: routes.all_products_collection_url
-%}

{%- style -%}
  #Hero-{{ section.id }} {
    position: relative;
    isolation: isolate;
    background: var(--cream);
    color: var(--ink);
  }
  #Hero-{{ section.id }} .hero__scene {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: max(58rem, 56.28vw);
  }
  #Hero-{{ section.id }} .hero__art {
    position: absolute;
    inset: 0;
    overflow: hidden;
    pointer-events: none;
  }
  #Hero-{{ section.id }} .hero__art picture { display: block; width: 100%; }
  #Hero-{{ section.id }} .hero__image {
    display: block;
    width: 100%;
    height: auto;
    aspect-ratio: 1672 / 941;
    object-fit: contain;
    object-position: center top;
  }
  #Hero-{{ section.id }} .hero__content {
    position: relative;
    z-index: 1;
    align-self: center;
    width: 34%;
    padding: 12rem 0 7rem clamp(2.4rem, 4.5vw, 8rem);
  }
  #Hero-{{ section.id }} .hero__eyebrow {
    margin: 0 0 1.8rem;
    font: 700 clamp(1.1rem, 1vw, 1.5rem)/1.4 var(--font-accent);
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }
  #Hero-{{ section.id }} .hero__heading {
    margin: 0;
    color: var(--blue);
    font: 800 clamp(4.2rem, 4.8vw, 8.4rem)/0.98 var(--font-heading);
    letter-spacing: -0.035em;
    text-wrap: balance;
    overflow-wrap: break-word;
  }
  #Hero-{{ section.id }} .hero__description {
    max-width: 30ch;
    margin: 2rem 0 0;
    font-size: clamp(1.6rem, 1.25vw, 1.9rem);
    font-weight: 500;
    line-height: 1.6;
    text-wrap: pretty;
  }
  #Hero-{{ section.id }} .hero__cta { margin-top: 2.8rem; }
  #Hero-{{ section.id }} .hero__cta .btn { gap: 1.4rem; padding-inline: 2.8rem; }
  #Hero-{{ section.id }} .hero__cta svg { flex: none; width: 2rem; height: 2rem; }
  #Hero-{{ section.id }} .btn-wrap:focus-within { outline: 3px solid var(--ink); outline-offset: 7px; border-radius: 1rem; }

  @media screen and (min-width: 750px) and (max-width: 1100px) {
    #Hero-{{ section.id }} .hero__scene { min-height: max(58rem, calc(56.28vw + 9rem)); }
    #Hero-{{ section.id }} .hero__art picture { position: relative; padding-top: 9rem; }
    #Hero-{{ section.id }} .hero__content { width: 35%; padding-top: 11rem; padding-bottom: 4rem; }
    #Hero-{{ section.id }} .hero__heading { font-size: clamp(3.6rem, 4.8vw, 5.2rem); }
    #Hero-{{ section.id }} .hero__description { font-size: var(--text-base); line-height: 1.5; }
    #Hero-{{ section.id }} .hero__eyebrow { margin-bottom: 1.4rem; font-size: 1.1rem; }
    #Hero-{{ section.id }} .hero__cta { margin-top: 2rem; }
    #Hero-{{ section.id }} .hero__cta .btn { gap: 0.8rem; padding-inline: 1.8rem; font-size: 1.5rem; }
  }
  @media screen and (max-width: 749px) {
    #Hero-{{ section.id }} .hero__scene { min-height: 177.68vw; }
    #Hero-{{ section.id }} .hero__image { aspect-ratio: 941 / 1672; }
    #Hero-{{ section.id }} .hero__content {
      align-self: end;
      width: 100%;
      max-width: 48rem;
      margin: 118vw auto 0;
      padding: 0 2.4rem 3.2rem;
      text-align: center;
    }
    #Hero-{{ section.id }} .hero__eyebrow { margin-bottom: 1rem; font-size: 1.1rem; letter-spacing: 0.1em; }
    #Hero-{{ section.id }} .hero__heading { font-size: clamp(3.6rem, 10.3vw, 5.8rem); line-height: 1.02; }
    #Hero-{{ section.id }} .hero__description { margin: 1.2rem auto 0; max-width: 34ch; font-size: var(--text-base); line-height: 1.5; }
    #Hero-{{ section.id }} .hero__cta { margin-top: 1.8rem; }
    #Hero-{{ section.id }} .hero__cta .btn { min-height: 5.2rem; padding-inline: 2.6rem; font-size: 1.6rem; }
  }
{%- endstyle -%}

<section id="Hero-{{ section.id }}" class="banner-section" aria-labelledby="HeroHeading-{{ section.id }}">
  <div class="hero__scene">
    <div class="hero__art">
      <picture>
        {%- if mobile_image != blank -%}
          <source media="(max-width: 749px)" srcset="{{ mobile_image | image_url: width: 500 }} 500w, {{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w" sizes="100vw" width="{{ mobile_image.width }}" height="{{ mobile_image.height }}">
        {%- elsif desktop_image == blank -%}
          <source media="(max-width: 749px)" srcset="{{ 'jjw-hero-paper-boat-mobile.png' | asset_img_url: '500x' }} 500w, {{ 'jjw-hero-paper-boat-mobile.png' | asset_img_url: '750x' }} 750w, {{ 'jjw-hero-paper-boat-mobile.png' | asset_url }} 941w" sizes="100vw" width="941" height="1672">
        {%- endif -%}
        {%- if desktop_image != blank -%}
          {{ desktop_image | image_url: width: 2400 | image_tag: class: 'hero__image', loading: 'eager', fetchpriority: 'high', widths: '750, 1100, 1500, 1800, 2400', sizes: '100vw', alt: section.settings.image_alt }}
        {%- else -%}
          <img class="hero__image" src="{{ 'jjw-hero-paper-boat-desktop.png' | asset_url }}" srcset="{{ 'jjw-hero-paper-boat-desktop.png' | asset_img_url: '900x' }} 900w, {{ 'jjw-hero-paper-boat-desktop.png' | asset_img_url: '1200x' }} 1200w, {{ 'jjw-hero-paper-boat-desktop.png' | asset_url }} 1672w" sizes="100vw" alt="{{ section.settings.image_alt | escape }}" width="1672" height="941" loading="eager" fetchpriority="high">
        {%- endif -%}
      </picture>
    </div>
    <div class="hero__content">
      {%- if section.settings.eyebrow != blank -%}
        <p class="hero__eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}
      <h1 id="HeroHeading-{{ section.id }}" class="hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- if section.settings.description != blank -%}
        <p class="hero__description">{{ section.settings.description | escape }}</p>
      {%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <div class="hero__cta">
          <span class="btn-wrap"><span class="btn-shadow" aria-hidden="true"></span>
            <a class="btn btn--primary" href="{{ cta_url }}">
              {{ section.settings.button_label | escape }}
              <svg viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M4 12h15m-6-6 6 6-6 6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/></svg>
            </a>
          </span>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Paper boat hero",
  "settings": [
    { "type": "header", "content": "Story artwork" },
    { "type": "image_picker", "id": "image", "label": "Desktop hero image", "info": "Uses the JJW Paper Boat landscape when empty. Best with a 16:9 image and clear space on the left." },
    { "type": "image_picker", "id": "mobile_image", "label": "Mobile hero image", "info": "Uses the matching Paper Boat portrait with default desktop art. Best with a 9:16 portrait and clear space in the bottom third." },
    { "type": "text", "id": "image_alt", "label": "Image description", "default": "Jevika, Joy, Brutus, Minku and Pinki sail a giant yellow paper boat through sunlit clouds" },
    { "type": "header", "content": "Shopping message" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Character tees for ages 4–12" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Wear a little wonder." },
    { "type": "textarea", "id": "description", "label": "Description", "default": "Original character tees in soft organic cotton, made for everyday adventures." },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop character tees" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [{ "name": "Paper boat hero" }]
}
{% endschema %}
