{%- comment -%}
  Main product — rebuilt to the partakefoods.com PDP layout, measured at 1440:

  Media column (677px):            Info column (576px, sticky):
    [badges 200px | packshot 457]    h1 70px condensed
    [wide image 677x338 (2:1)]       category tabs + product cards
    [square 328] [square 328]        accordions
                                     price + pickers + ATC (stacked buttons row)

  Their tabs are pack formats; ours are characters, driven by tab blocks that
  point at the character collections. Their left-hand badges are PNGs; ours are
  text ribbons (hard rule: convert image text to real type), tilted in CSS.

  Media is grouped per colour by the alt text's FIRST word — a substring match
  read the background out of "flat lay on yellow" and filed a navy tee under
  Yellow. Untagged media appears in every colour's gallery. Within a colour,
  alt containing "packshot" takes the featured slot, "banner" the wide slot,
  the rest go two-up. Products with no media fall back to a character-colour
  block; never a broken img.
{%- endcomment -%}

{%- liquid
  assign character = ''
  for tag in product.tags
    if tag contains 'character:'
      assign character = tag | split: ':' | last | strip | downcase
    endif
  endfor

  case character
    when 'jevika'
      assign pair = 'pink'
    when 'joy'
      assign pair = 'blue'
    when 'brutus'
      assign pair = 'gold'
    when 'minku'
      assign pair = 'green'
    when 'pinki'
      assign pair = 'purple'
    else
      assign pair = 'blue'
  endcase

  assign current_variant = product.selected_or_first_available_variant

  assign colour_option = nil
  for option in product.options_with_values
    assign oname = option.name | downcase
    if oname == 'color' or oname == 'colour'
      assign colour_option = option
    endif
  endfor

  assign selected_colour = ''
  if colour_option
    assign selected_colour = colour_option.selected_value
  endif

  comment
    One id for the buy form, so the sticky mobile bar's button can submit it
    through the `form` attribute instead of carrying a second form of its own.
  endcomment
  assign atc_form_id = 'PdpForm-' | append: section.id
-%}

{%- style -%}
  #MainProduct-{{ section.id }} {
    --char-bg: var(--{{ pair }}-bg);
    --char-fg: var(--{{ pair }});
    background: var(--cream);
    padding-block: 4rem 6rem;
  }

  #MainProduct-{{ section.id }} .pdp__grid {
    /* Reference at 1440: media 765px, info 576px, 50px gap — 1.33 : 1. */
    display: grid;
    grid-template-columns: minmax(0, 1.33fr) minmax(0, 1fr);
    gap: 5rem;
    align-items: start;
  }

  /* --- Media: stacked gallery ------------------------------------------- */

  #MainProduct-{{ section.id }} .pdp__gallery[hidden] {
    display: none;
  }

  /* Row 1 — badge rail + featured packshot, 200px : rest. */
  #MainProduct-{{ section.id }} .pdp__featured-row {
    display: grid;
    grid-template-columns: 20rem minmax(0, 1fr);
    gap: 2rem;
    align-items: center;
  }

  #MainProduct-{{ section.id }} .pdp__badges {
    display: grid;
    gap: 3.6rem;
    justify-items: start;
    align-content: center;
  }

  #MainProduct-{{ section.id }} .pdp__badge {
    max-width: 18rem;
    padding: 1.2rem 1.6rem;
    border-radius: 0.8rem;
    background: var(--char-fg);
    color: var(--cream);
    font-family: var(--font-accent);
    font-weight: 800;
    font-size: 1.8rem;
    line-height: 1.15;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    box-shadow: 3px 3px 0 0 var(--ink-deep);
  }

  #MainProduct-{{ section.id }} .pdp__badge:nth-child(3n + 1) { transform: rotate(-7deg); }
  #MainProduct-{{ section.id }} .pdp__badge:nth-child(3n + 2) { transform: rotate(5deg); }
  #MainProduct-{{ section.id }} .pdp__badge:nth-child(3n) { transform: rotate(-4deg); }

  #MainProduct-{{ section.id }} .pdp__featured {
    aspect-ratio: 1 / 1;
    border-radius: 1.6rem;
    overflow: hidden;
    background: var(--char-bg);
  }

  #MainProduct-{{ section.id }} .pdp__featured img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* No media at all: the title sits on the character colour. */
  #MainProduct-{{ section.id }} .pdp__fallback {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 3rem;
  }

  #MainProduct-{{ section.id }} .pdp__fallback span {
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: clamp(3.2rem, 5vw, 5.6rem);
    line-height: 1;
    text-align: center;
    text-wrap: balance;
    /* --char-fg fails contrast on gold (1.73:1) and green (2.57:1) against
       its own tint; ink clears every pair. */
    color: var(--ink);
  }

  /* Row 2 — the wide shot, reference 677x338 = 2:1. */
  #MainProduct-{{ section.id }} .pdp__wide {
    margin-top: 2rem;
    aspect-ratio: 2 / 1;
    border-radius: 1.6rem;
    overflow: hidden;
  }

  #MainProduct-{{ section.id }} .pdp__wide img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* Row 3+ — squares, two-up with the reference's 20px gutter. */
  #MainProduct-{{ section.id }} .pdp__squares {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 2rem;
    margin-top: 2rem;
  }

  #MainProduct-{{ section.id }} .pdp__square {
    aspect-ratio: 1 / 1;
    border-radius: 1.6rem;
    overflow: hidden;
    background: var(--char-bg);
  }

  #MainProduct-{{ section.id }} .pdp__square img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  /* --- Info -------------------------------------------------------------- */

  #MainProduct-{{ section.id }} .pdp__info {
    min-width: 0;
    position: sticky;
    top: 3rem;
  }

  #MainProduct-{{ section.id }} .pdp__title {
    /* Product title role: prominent, but not campaign-display size. */
    font-family: var(--font-accent);
    font-weight: 900;
    font-size: var(--product-title-size);
    line-height: 1.1;
    letter-spacing: 0.06rem;
    /* Big-heading blue like every other page title; 32px+ at 900 is large text, 4.31:1 passes. */
    color: var(--heading);
    margin: 0 0 1.5rem;
  }

  /* Mobile-order duplicate of the h1 — shown only when the grid stacks. */
  #MainProduct-{{ section.id }} .pdp__title--mob {
    display: none;
  }

  /* Carousel dots, built by JS; desktop never shows them. */
  #MainProduct-{{ section.id }} .pdp__dots {
    display: none;
  }

  /* --- Category tabs — reference .product-variant-tabs ------------------- */

  #MainProduct-{{ section.id }} .pdp__tabs {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin: 0 0 2rem;
  }

  #MainProduct-{{ section.id }} .pdp__tab {
    position: relative;
    min-height: var(--touch-target);
    padding: 1rem 1.5rem;
    border-radius: 0.5rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.8rem;
    line-height: 1.3;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    background: var(--blue-bg);
    color: var(--ink);
    cursor: pointer;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  #MainProduct-{{ section.id }} .pdp__tab[aria-selected='true'] {
    background: var(--ink);
    color: var(--cream);
    box-shadow: 4px 4px 0 0 var(--ink-deep);
  }

  #MainProduct-{{ section.id }} .pdp__tab-panel {
    margin: 0 0 2.4rem;
  }

  #MainProduct-{{ section.id }} .pdp__tab-panel[hidden] {
    display: none;
  }

  /* Reference grid: 4 cards across, ~15px gutters, wrapping to a second row. */
  #MainProduct-{{ section.id }} .pdp__cards {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 1.5rem;
  }

  #MainProduct-{{ section.id }} .pdp__card {
    text-align: center;
  }

  #MainProduct-{{ section.id }} .pdp__card-thumb {
    /* Spans are inline; without this the aspect-ratio is ignored and the
       whole thumb collapses to its 2px border. */
    display: block;
    aspect-ratio: 1 / 1;
    border: 2px solid var(--blue);
    border-radius: 1rem;
    overflow: hidden;
    background: var(--card-bg, var(--blue-bg));
  }

  /* The product being viewed — reference outlines its own card in the grid. */
  #MainProduct-{{ section.id }} .pdp__card[aria-current='page'] .pdp__card-thumb {
    border: 3px solid var(--pink);
  }

  #MainProduct-{{ section.id }} .pdp__card-thumb img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Character art stands in for products with no photography yet. It is a
     transparent cut-out, not a packshot, so `cover` would crop the face off.
     Qualified with `img` deliberately: the rule above scores 1,1,1 and a plain
     `.pdp__card-face` (1,1,0) would lose to it no matter where it sits. */
  #MainProduct-{{ section.id }} .pdp__card-thumb img.pdp__card-face {
    object-fit: contain;
    padding: 1.2rem;
  }

  #MainProduct-{{ section.id }} .pdp__card-thumb span {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 1rem;
    font-family: var(--font-heading);
    font-weight: 800;
    font-size: 1.6rem;
    line-height: 1.1;
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__card-label {
    display: block;
    margin-top: 0.8rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: var(--text-base);
    line-height: 1.25;
    color: var(--ink);
  }

  /* --- Purchase block ---------------------------------------------------- */

  #MainProduct-{{ section.id }} .pdp__buy {
    margin-top: 1.6rem;
  }

  #MainProduct-{{ section.id }} .pdp__related {
    margin-top: 3.2rem;
  }

  #MainProduct-{{ section.id }} .pdp__details {
    margin-top: 3.2rem;
    padding-top: 2.4rem;
    border-top: 1px solid color-mix(in srgb, var(--ink) 16%, transparent);
  }

  #MainProduct-{{ section.id }} .pdp__price {
    display: flex;
    align-items: baseline;
    gap: 1.2rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 2.4rem;
    letter-spacing: 0.1rem;
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__compare {
    font-size: 1.8rem;
    color: var(--ink-soft);
  }

  #MainProduct-{{ section.id }} .pdp__compare:empty {
    display: none;
  }

  #MainProduct-{{ section.id }} .pdp__group {
    min-inline-size: 0;
    max-width: 100%;
    margin: 2.4rem 0 0;
    padding: 0;
    border: 0;
  }

  #MainProduct-{{ section.id }} .pdp__group-name {
    display: block;
    margin-bottom: 1rem;
    font-size: var(--text-base);
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__group-name b {
    font-weight: 400;
    color: var(--ink-soft);
  }

  #MainProduct-{{ section.id }} .pdp__values {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
  }

  #MainProduct-{{ section.id }} .pdp__values input {
    position: absolute;
    width: 1px;
    height: 1px;
    margin: -1px;
    padding: 0;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }

  /* Size pills */
  #MainProduct-{{ section.id }} .pdp__pill {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 6.4rem;
    min-height: var(--touch-target);
    padding: 1rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.8rem;
    line-height: 1.2;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    text-align: center;
    cursor: pointer;
    background: var(--blue-bg);
    color: var(--ink);
    border-radius: 0.5rem;
    transition: background 0.2s var(--ease), color 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  #MainProduct-{{ section.id }} input:checked + .pdp__pill {
    background: var(--ink);
    color: var(--cream);
    box-shadow: 4px 4px 0 0 var(--ink-deep);
  }

  /* Colour swatches */
  #MainProduct-{{ section.id }} .pdp__swatch {
    display: block;
    width: 4.4rem;
    height: 4.4rem;
    border-radius: 50%;
    background: var(--swatch, var(--ink-soft));
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25);
    cursor: pointer;
    transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
  }

  #MainProduct-{{ section.id }} input:checked + .pdp__swatch {
    box-shadow: inset 0 0 0 1px rgba(0, 0, 0, 0.25), 0 0 0 3px var(--cream), 0 0 0 6px var(--ink);
  }

  /* The [data-swatch] hex map moved to theme.css when the collection page's
     colour filter began drawing the same dots. One list, two surfaces. */

  /* --- Size guide ---------------------------------------------------------
     A <details> under the Size fieldset. Prose sits on --white because the
     table carries --blue nowhere but the toggle, and 4.34:1 on cream would
     fail at this size. */

  #MainProduct-{{ section.id }} .sg {
    margin-top: 1.2rem;
  }

  #MainProduct-{{ section.id }} .sg__toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    min-height: 4.4rem;
    font-size: 1.7rem;
    letter-spacing: 0.05em;
    color: var(--ink);
    cursor: pointer;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4rem;
    list-style: none;
  }

  #MainProduct-{{ section.id }} .sg__toggle::-webkit-details-marker {
    display: none;
  }

  #MainProduct-{{ section.id }} .sg__toggle:hover {
    color: var(--ink-deep);
  }


  #MainProduct-{{ section.id }} .sg__toggle svg {
    width: 2rem;
    height: 2rem;
    flex: 0 0 auto;
  }

  #MainProduct-{{ section.id }} .sg__panel {
    margin-top: 1.2rem;
    padding: 2rem;
    border-radius: 1.6rem;
    background: var(--white);
  }

  #MainProduct-{{ section.id }} .sg__heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.8rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--ink);
  }

  /* Four columns of numbers do not fit a 390px phone; scroll the table rather
     than shrink the type past legibility. */
  #MainProduct-{{ section.id }} .sg__scroll {
    overflow-x: auto;
    scrollbar-width: thin;
  }

  #MainProduct-{{ section.id }} .sg__table {
    width: 100%;
    border-collapse: collapse;
    font-size: 1.5rem;
    white-space: nowrap;
  }

  #MainProduct-{{ section.id }} .sg__table th,
  #MainProduct-{{ section.id }} .sg__table td {
    padding: 0.9rem 1.2rem;
    text-align: left;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 15%, transparent);
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .sg__table thead th {
    font-family: var(--font-accent);
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    border-bottom: 2px solid var(--sky);
  }

  #MainProduct-{{ section.id }} .sg__table tbody th {
    font-weight: 700;
  }

  #MainProduct-{{ section.id }} .sg__table tbody tr:last-child th,
  #MainProduct-{{ section.id }} .sg__table tbody tr:last-child td {
    border-bottom: 0;
  }

  #MainProduct-{{ section.id }} .sg__note {
    margin: 1.2rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.5;
    color: var(--ink-soft);
  }

  #MainProduct-{{ section.id }} .sg__note :where(p) {
    margin: 0;
  }

  /* --- Reviews ------------------------------------------------------------ */

  #MainProduct-{{ section.id }} .pdp__reviews {
    margin-top: 6rem;
  }

  #MainProduct-{{ section.id }} .jjw-stars {
    margin-top: 0.8rem;
  }

  /* Sold-out combinations stay reachable but never read as available. */
  #MainProduct-{{ section.id }} .pdp__value[data-unavailable] .pdp__pill {
    opacity: 0.4;
    text-decoration: line-through;
  }

  #MainProduct-{{ section.id }} .pdp__value[data-unavailable] .pdp__swatch {
    opacity: 0.4;
  }

  #MainProduct-{{ section.id }} .pdp__values input:focus-visible + .pdp__pill,
  #MainProduct-{{ section.id }} .pdp__values input:focus-visible + .pdp__swatch {
    outline: 3px solid var(--cream);
    outline-offset: 0;
    box-shadow: 0 0 0 6px var(--ink);
  }

  /* ATC — full-width like the reference's stacked retailer buttons (576x68). */
  #MainProduct-{{ section.id }} .pdp__atc {
    display: block;
    width: 100%;
    margin-top: 2.4rem;
  }

  #MainProduct-{{ section.id }} .pdp__atc .btn-wrap {
    display: block;
    width: 100%;
  }

  #MainProduct-{{ section.id }} .pdp__atc .btn {
    min-height: 5.6rem;
    font-size: var(--button-text-size);
    letter-spacing: 0.05em;
  }

  #MainProduct-{{ section.id }} .pdp__atc .btn[disabled] {
    cursor: not-allowed;
    --btn-bg: var(--ink-soft);
    /* Dark fill, so the navy .btn--primary text has to go back to cream: 5.82:1. */
    --btn-fg: var(--cream);
  }

  #MainProduct-{{ section.id }} .btn-wrap:has(.btn[disabled]) .btn-shadow {
    transform: translate(4px, 4px);
  }

  #MainProduct-{{ section.id }} .pdp__trust {
    margin: 1.6rem 0 0;
    font-size: 1.4rem;
    color: var(--ink-soft);
  }

  /* --- Sticky buy bar (phones only) ---------------------------------------
     Desktop never shows it: the info column is already `position: sticky`, so
     the real button stays on screen there and a second one would be noise.

     z-index 9 puts it above page content and above the WhatsApp bubble's 8,
     but below the header overlay's 10 and well below the cart drawer's 70/71
     — opening the menu, search or the drawer must cover this, not fight it. */

  #MainProduct-{{ section.id }} .pdp__sticky {
    display: none;
  }

  #MainProduct-{{ section.id }} .pdp__sticky[hidden] {
    display: none;
  }

  /* --- Highlight bullets (between the title and the accordions) ----------- */

  #MainProduct-{{ section.id }} .pdp__highlights {
    display: grid;
    gap: 0.8rem;
    margin: 0 0 2.4rem;
    padding: 0;
    list-style: none;
  }

  #MainProduct-{{ section.id }} .pdp__highlights li {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
    font-size: var(--text-base);
    line-height: 1.45;
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__highlights svg {
    width: 1.8rem;
    height: 1.8rem;
    /* Outdoor Green on cream is 3.9:1 — fine for a 2.2px tick, which is a
       non-text graphic needing 3:1, and it never carries the meaning alone. */
    color: var(--green);
    margin-top: 0.2rem;
  }

  /* --- Trust badges + payment row (below the buy button) ------------------ */

  #MainProduct-{{ section.id }} .pdp__badges-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
    gap: 1.2rem;
    margin: 2rem 0 0;
    padding: 1.6rem;
    border-radius: 1.6rem;
    background: var(--white);
    list-style: none;
  }

  #MainProduct-{{ section.id }} .pdp__badge-item {
    display: flex;
    align-items: center;
    gap: 0.9rem;
    min-width: 0;
  }

  #MainProduct-{{ section.id }} .pdp__badge-icon {
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    background: var(--sky);
    /* Navy on Sky Blue is 7.5:1; the icon is a 1.8px stroke so it needs the
       contrast far more than a block of text would. */
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__badge-icon svg {
    width: 1.8rem;
    height: 1.8rem;
  }

  #MainProduct-{{ section.id }} .pdp__badge-text {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.5rem;
    line-height: 1.2;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-wrap: balance;
    color: var(--ink);
  }

  #MainProduct-{{ section.id }} .pdp__payments {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.8rem 1.2rem;
    margin: 1.6rem 0 0;
  }

  #MainProduct-{{ section.id }} .pdp__payments-label {
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.3rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--ink-soft);
  }

  #MainProduct-{{ section.id }} .pdp__payment-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #MainProduct-{{ section.id }} .pdp__payment-icon {
    display: block;
    width: 3.8rem;
    height: 2.4rem;
  }

  {%- comment -%}
    Stacked layout — the reference's own phone PDP: h1 first, then the gallery
    as an edge-to-edge swipe carousel with dots, no badge rail, cards 3-up.
    Reference shows this already at 800px, so it lives at the 989 stack point.
  {%- endcomment -%}
  @media screen and (max-width: 989px) {
    #MainProduct-{{ section.id }} .pdp__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 3rem;
    }

    #MainProduct-{{ section.id }} .pdp__info {
      position: static;
    }

    #MainProduct-{{ section.id }} .pdp__title {
      font-size: 3.2rem;
    }

    /* Title order swap: mobile node in, desktop node out. */
    #MainProduct-{{ section.id }} .pdp__title--mob {
      display: block;
      margin: 0 0 0.5rem;
    }

    #MainProduct-{{ section.id }} .pdp__info > .pdp__title {
      display: none;
    }

    /* Gallery becomes a scroll-snap carousel, one image per swipe. */
    #MainProduct-{{ section.id }} .pdp__gallery {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scrollbar-width: none;
      -ms-overflow-style: none;
    }

    #MainProduct-{{ section.id }} .pdp__gallery::-webkit-scrollbar {
      display: none;
    }

    #MainProduct-{{ section.id }} .pdp__featured-row,
    #MainProduct-{{ section.id }} .pdp__wide,
    #MainProduct-{{ section.id }} .pdp__square {
      flex: 0 0 100%;
      scroll-snap-align: center;
      margin: 0;
    }

    /* Slides share the packshot's square footprint; the 2:1 banner crops. */
    #MainProduct-{{ section.id }} .pdp__featured-row {
      display: block;
    }

    #MainProduct-{{ section.id }} .pdp__wide {
      aspect-ratio: 1 / 1;
    }

    /* Lifts the two squares out of their wrapper into the carousel row. */
    #MainProduct-{{ section.id }} .pdp__squares {
      display: contents;
    }

    /* Reference mobile shows no badge rail. */
    #MainProduct-{{ section.id }} .pdp__badges {
      display: none;
    }

    #MainProduct-{{ section.id }} .pdp__dots {
      display: flex;
      justify-content: center;
      gap: 1rem;
      margin-top: 1.6rem;
    }

    #MainProduct-{{ section.id }} .pdp__dots[hidden] {
      display: none;
    }

    #MainProduct-{{ section.id }} .pdp__dot {
      /* A 10px dot is the visual; the tap target is the padding. background-clip
         keeps the fill on the content box so the ring stays 10px while the
         button is 44px — a bare 10px button failed the touch-target floor. */
      width: 1rem;
      height: 1rem;
      padding: 1.7rem;
      box-sizing: content-box;
      background-clip: content-box;
      border-radius: 50%;
      background-color: var(--blue-bg);
      transition: background-color 0.2s var(--ease);
    }

    #MainProduct-{{ section.id }} .pdp__dot[aria-current='true'] {
      /* background-color, not the shorthand: the shorthand resets
         background-clip and the active dot would balloon to the full 44px. */
      background-color: var(--ink);
    }

    /* Reference phone cards run three across. */
    #MainProduct-{{ section.id }} .pdp__cards {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #MainProduct-{{ section.id }} .pdp__tab,
    #MainProduct-{{ section.id }} .pdp__pill,
    #MainProduct-{{ section.id }} .pdp__swatch {
      transition: none;
    }
  }

  /* --- Sticky buy bar, phones -------------------------------------------- */

  @media screen and (max-width: 749px) {
    #MainProduct-{{ section.id }} .pdp__sticky {
      display: block;
      position: fixed;
      inset-inline: 0;
      bottom: 0;
      z-index: 9;
      padding: 1rem 1.5rem calc(1rem + env(safe-area-inset-bottom, 0px));
      background: var(--cream);
      border-top: 2px solid var(--sky);
      /* The bar is the last thing between a shopper and the button, so it gets
         a real edge rather than floating: on a cream page a shadow alone is
         almost invisible and the bar reads as part of the content. */
      box-shadow: 0 -4px 16px rgba(16, 36, 74, 0.1);
    }

    /* Lift the WhatsApp bubble above the bar while it is showing. It has to be
       matched from `body`, not from this section — the bubble is rendered by
       footer-group and is not a descendant or sibling of anything in here, so
       the var has to be set somewhere they both inherit from. Scoping the
       :has() to this section's bar keeps it off every other template. */
    body:has(#MainProduct-{{ section.id }} .pdp__sticky:not([hidden])) {
      --jjw-sticky-atc-offset: 7.4rem;
    }

    #MainProduct-{{ section.id }} .pdp__sticky[hidden] {
      display: none;
    }

    #MainProduct-{{ section.id }} .pdp__sticky-inner {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 1.2rem;
      align-items: center;
    }

    #MainProduct-{{ section.id }} .pdp__sticky-meta {
      display: grid;
      min-width: 0;
    }

    #MainProduct-{{ section.id }} .pdp__sticky-title {
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
      font-family: var(--font-accent);
      font-weight: 700;
      font-size: 1.5rem;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--ink);
    }

    #MainProduct-{{ section.id }} .pdp__sticky-price {
      font-size: 1.8rem;
      font-weight: 700;
      color: var(--ink);
    }

    #MainProduct-{{ section.id }} .pdp__sticky-cta .btn {
      min-height: 5rem;
      min-width: 15rem;
      padding-inline: 2rem;
      font-size: var(--button-text-size);
    }

    #MainProduct-{{ section.id }} .pdp__sticky-cta .btn-shadow {
      transform: translate(4px, 4px);
    }
  }
{%- endstyle -%}

<section id="MainProduct-{{ section.id }}">
  <div class="page-width pdp__grid">
    {%- comment -%}
      Reference mobile order is title, then carousel. Two h1 nodes exist but a
      breakpoint always display:nones one of them, so assistive tech only ever
      sees a single h1.
    {%- endcomment -%}
    <h1 class="pdp__title pdp__title--mob">{{ product.title | default: section.settings.fallback_title }}</h1>

    {%- comment -%} ---- Media ---- {%- endcomment -%}
    <div class="pdp__media scroll-trigger animate--fade-in">
      {%- liquid
        assign badge_blocks = section.blocks | where: 'type', 'badge'
        assign tab_blocks = section.blocks | where: 'type', 'tab'
      -%}

      {%- comment -%}
        Badges are per-character: a badge with no character set shows on every
        product, one naming a character shows only there. Three is the cap the
        rail is sized for, so the shown ones are counted, not the blocks.

        ponytail: this rail is emitted once per colour gallery, so it repeats
        in the DOM (4 colours = 4 copies, 3 of them inside hidden containers
        and therefore out of the a11y tree). It is ~600 bytes and identical
        every time. Hoisting it out means splitting the per-colour toggle
        across three separate places in the media column; not worth it unless
        badges ever need to differ by colour.
      {%- endcomment -%}
      {%- capture badge_rail -%}
        {%- assign badges_shown = 0 -%}
        {%- capture badge_items -%}
          {%- for block in badge_blocks -%}
            {%- assign want = block.settings.character | downcase | strip -%}
            {%- if badges_shown < 3 and block.settings.text != blank -%}
              {%- if want == blank or want == character -%}
                {%- assign badges_shown = badges_shown | plus: 1 -%}
                <span class="pdp__badge" {{ block.shopify_attributes }}>{{ block.settings.text | escape }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}
        {%- endcapture -%}
        {%- if badges_shown > 0 -%}
          <div class="pdp__badges">{{ badge_items }}</div>
        {%- endif -%}
      {%- endcapture -%}

      {%- if product.media.size == 0 -%}
        <div class="pdp__gallery">
          <div class="pdp__featured-row">
            {{ badge_rail }}
            <div class="pdp__featured">
              <div class="pdp__fallback">
                <span>{{ product.title | default: section.settings.fallback_title }}</span>
              </div>
            </div>
          </div>
        </div>
      {%- elsif colour_option -%}
        {%- comment -%}
          One gallery per colour. A shot belongs to a colour when its alt's
          first word is that colour; untagged shots appear in all galleries.
        {%- endcomment -%}
        {%- for value in colour_option.values -%}
          {%- liquid
            assign vdown = value | downcase
            assign featured_id = 0
            assign wide_id = 0

            comment
              Pass 1 - featured: first owned-or-untagged media whose alt says
              "packshot"; failing that, the first owned-or-untagged non-banner.
            endcomment
          -%}
          {%- for media in product.media -%}
            {%- liquid
              assign adown = media.alt | downcase
              assign first_word = adown | split: ' ' | first
              assign untagged = true
              for v2 in colour_option.values
                assign v2d = v2 | downcase
                if first_word == v2d
                  assign untagged = false
                endif
              endfor
              assign member = false
              if first_word == vdown or untagged
                assign member = true
              endif
            -%}
            {%- if member and featured_id == 0 and adown contains 'packshot' -%}
              {%- assign featured_id = media.id -%}
            {%- endif -%}
          {%- endfor -%}
          {%- if featured_id == 0 -%}
            {%- for media in product.media -%}
              {%- liquid
                assign adown = media.alt | downcase
                assign first_word = adown | split: ' ' | first
                assign untagged = true
                for v2 in colour_option.values
                  assign v2d = v2 | downcase
                  if first_word == v2d
                    assign untagged = false
                  endif
                endfor
                assign member = false
                if first_word == vdown or untagged
                  assign member = true
                endif
              -%}
              {%- unless adown contains 'banner' -%}
                {%- if member and featured_id == 0 -%}
                  {%- assign featured_id = media.id -%}
                {%- endif -%}
              {%- endunless -%}
            {%- endfor -%}
          {%- endif -%}

          <div
            class="pdp__gallery"
            data-gallery="{{ value | escape }}"
            {% unless value == selected_colour %}hidden{% endunless %}
          >
            <div class="pdp__featured-row">
              {{ badge_rail }}
              <div class="pdp__featured">
                {%- for media in product.media -%}
                  {%- if media.id == featured_id and media.preview_image != blank -%}
                    {{
                      media.preview_image
                      | image_url: width: 1000
                      | image_tag:
                        loading: 'eager',
                        alt: media.alt,
                        widths: '400, 600, 800, 1000',
                        sizes: '(max-width: 989px) 96vw, 32vw'
                    }}
                  {%- endif -%}
                {%- endfor -%}
                {%- if featured_id == 0 -%}
                  <div class="pdp__fallback">
                    <span>{{ product.title | default: section.settings.fallback_title }}</span>
                  </div>
                {%- endif -%}
              </div>
            </div>

            {%- comment -%} Pass 2 - the wide slot: first member banner. {%- endcomment -%}
            {%- for media in product.media -%}
              {%- liquid
                assign adown = media.alt | downcase
                assign first_word = adown | split: ' ' | first
                assign untagged = true
                for v2 in colour_option.values
                  assign v2d = v2 | downcase
                  if first_word == v2d
                    assign untagged = false
                  endif
                endfor
                assign member = false
                if first_word == vdown or untagged
                  assign member = true
                endif
              -%}
              {%- if member and wide_id == 0 and adown contains 'banner' and media.id != featured_id and media.preview_image != blank -%}
                {%- assign wide_id = media.id -%}
                <div class="pdp__wide">
                  {{
                    media.preview_image
                    | image_url: width: 1400
                    | image_tag:
                      loading: 'lazy',
                      alt: media.alt,
                      widths: '600, 800, 1000, 1400',
                      sizes: '(max-width: 989px) 96vw, 47vw'
                  }}
                </div>
              {%- endif -%}
            {%- endfor -%}

            {%- comment -%} Pass 3 - everything else, two-up. {%- endcomment -%}
            {%- capture squares -%}
              {%- for media in product.media -%}
                {%- liquid
                  assign adown = media.alt | downcase
                  assign first_word = adown | split: ' ' | first
                  assign untagged = true
                  for v2 in colour_option.values
                    assign v2d = v2 | downcase
                    if first_word == v2d
                      assign untagged = false
                    endif
                  endfor
                  assign member = false
                  if first_word == vdown or untagged
                    assign member = true
                  endif
                -%}
                {%- if member and media.id != featured_id and media.id != wide_id and media.preview_image != blank -%}
                  <div class="pdp__square">
                    {{
                      media.preview_image
                      | image_url: width: 700
                      | image_tag:
                        loading: 'lazy',
                        alt: media.alt,
                        widths: '350, 500, 700',
                        sizes: '(max-width: 989px) 48vw, 23vw'
                    }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            {%- endcapture -%}
            {%- if squares contains 'pdp__square' -%}
              <div class="pdp__squares">{{ squares }}</div>
            {%- endif -%}
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- comment -%} No colour option: one gallery, first shot featured. {%- endcomment -%}
        <div class="pdp__gallery">
          <div class="pdp__featured-row">
            {{ badge_rail }}
            <div class="pdp__featured">
              {%- assign first_media = product.media | first -%}
              {%- if first_media.preview_image != blank -%}
                {{ first_media.preview_image | image_url: width: 1000 | image_tag: loading: 'eager', alt: first_media.alt }}
              {%- endif -%}
            </div>
          </div>
          {%- if product.media.size > 1 -%}
            <div class="pdp__squares">
              {%- for media in product.media offset: 1 -%}
                {%- if media.preview_image != blank -%}
                  <div class="pdp__square">
                    {{ media.preview_image | image_url: width: 700 | image_tag: loading: 'lazy', alt: media.alt }}
                  </div>
                {%- endif -%}
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---- Info ---- {%- endcomment -%}
    <div class="pdp__info">
      <h1 class="pdp__title">{{ product.title | default: section.settings.fallback_title }}</h1>
      {%- render 'review-stars', product: product -%}

      {%- capture character_tabs -%}
      {%- comment -%} Character tabs — reference's pack-format tabs. {%- endcomment -%}
      {%- if tab_blocks.size > 0 -%}
        {%- liquid
          assign active_tab = ''
          for block in tab_blocks
            assign tag_probe = 'character:' | append: block.settings.label
            assign tag_probe = tag_probe | downcase
            for tag in product.tags
              assign tdown = tag | downcase
              if tdown == tag_probe and active_tab == ''
                assign active_tab = block.id
              endif
            endfor
          endfor
          if active_tab == ''
            assign active_tab = tab_blocks.first.id
          endif
        -%}
        <div class="pdp__tabs" role="tablist" aria-label="{{ section.settings.tabs_label | escape }}">
          {%- for block in tab_blocks -%}
            <button
              type="button"
              class="pdp__tab"
              role="tab"
              id="Tab-{{ block.id }}"
              aria-controls="TabPanel-{{ block.id }}"
              aria-selected="{% if block.id == active_tab %}true{% else %}false{% endif %}"
              data-pdp-tab="{{ block.id }}"
              {{ block.shopify_attributes }}
            >
              {{- block.settings.label | escape -}}
            </button>
          {%- endfor -%}
        </div>

        {%- for block in tab_blocks -%}
          <div
            class="pdp__tab-panel"
            role="tabpanel"
            id="TabPanel-{{ block.id }}"
            aria-labelledby="Tab-{{ block.id }}"
            data-pdp-panel="{{ block.id }}"
            {% unless block.id == active_tab %}hidden{% endunless %}
          >
            <div class="pdp__cards">
              {%- liquid
                assign shown = 0
                assign tab_char = block.settings.label | downcase
                comment
                  card_face is set only inside the known-character branches, so a
                  merchant-typed label that matches nothing leaves it nil and the
                  tile falls through to the text label rather than pointing
                  asset_url at a file that was never uploaded.
                endcomment
                assign card_face = nil
                case tab_char
                  when 'jevika'
                    assign card_pair = 'pink'
                    assign card_face = 'jevika-face.png'
                  when 'joy'
                    assign card_pair = 'blue'
                    assign card_face = 'joy-face.png'
                  when 'brutus'
                    assign card_pair = 'gold'
                    assign card_face = 'brutus-face.png'
                  when 'minku'
                    assign card_pair = 'green'
                    assign card_face = 'minku-face.png'
                  when 'pinki'
                    assign card_pair = 'purple'
                    assign card_face = 'pinki-face.png'
                  else
                    assign card_pair = 'blue'
                endcase
              -%}
              {%- if block.settings.collection != blank -%}
                {%- comment -%}
                  8 = two full grid rows. limit: 3 hid the viewed product from
                  its own tab whenever it sat 4th or later in the collection.
                {%- endcomment -%}
                {%- for card_product in block.settings.collection.products limit: 8 -%}
                  {%- assign shown = shown | plus: 1 -%}
                  <a
                    href="{{ card_product.url }}"
                    class="pdp__card"
                    style="--card-bg: var(--{{ card_pair }}-bg)"
                    {% if card_product.id == product.id %}aria-current="page"{% endif %}
                  >
                    <span class="pdp__card-thumb">
                      {%- if card_product.featured_image != blank -%}
                        {{ card_product.featured_image | image_url: width: 400 | image_tag: loading: 'lazy', alt: card_product.title }}
                      {%- elsif card_face != blank -%}
                        {%- comment -%}
                          alt is empty on purpose: .pdp__card-label repeats the
                          product name directly below, so captioning the art
                          would make a screen reader announce it twice.
                        {%- endcomment -%}
                        <img
                          src="{{ card_face | asset_url }}"
                          alt=""
                          loading="lazy"
                          width="400"
                          height="400"
                          class="pdp__card-face">
                      {%- else -%}
                        <span>{{ card_product.title | escape }}</span>
                      {%- endif -%}
                    </span>
                    <span class="pdp__card-label">{{ card_product.title | escape }}</span>
                  </a>
                {%- endfor -%}
              {%- endif -%}
              {%- if shown == 0 -%}
                <span class="pdp__card" style="--card-bg: var(--{{ card_pair }}-bg)">
                  <span class="pdp__card-thumb"><span>{{ block.settings.label | escape }}</span></span>
                  <span class="pdp__card-label">{{ section.settings.coming_soon_label | escape }}</span>
                </span>
              {%- endif -%}
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
      {%- endcapture -%}

      {%- capture product_details -%}
      {%- comment -%}
        Bullets before the accordions: the accordion's Description row holds the
        full prose, and this is the version a shopper reads without opening
        anything. Supporting details follow the purchase controls on every screen.
      {%- endcomment -%}
      {%- render 'product-highlights',
        product: product,
        fallback: section.settings.highlight_fallback
      -%}

      {%- render 'product-accordions', product: product, description: product.description, materials: section.settings.materials -%}
      {%- endcapture -%}

      {%- comment -%} ---- Purchase ---- {%- endcomment -%}
      <div class="pdp__buy">
        <div class="pdp__price">
          <span data-pdp-price>{{ current_variant.price | default: product.price | money }}</span>
          <s class="pdp__compare" data-pdp-compare>
            {%- if current_variant.compare_at_price > current_variant.price -%}
              {{- current_variant.compare_at_price | money -}}
            {%- endif -%}
          </s>
        </div>

        {%- if product.variants.size > 0 -%}
          <script type="application/json" data-pdp-variants>
            [
              {%- for variant in product.variants -%}
                {
                  "id": {{ variant.id }},
                  "options": {{ variant.options | json }},
                  "available": {{ variant.available | json }},
                  "price": {{ variant.price | money | json }},
                  "compare_at": {% if variant.compare_at_price > variant.price %}{{ variant.compare_at_price | money | json }}{% else %}null{% endif %}
                }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {%- comment -%}
            Picker sits outside the form so its radios are never posted to
            /cart/add — the hidden id input is the only thing that matters.
          {%- endcomment -%}
          <div data-pdp-picker>
            {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign option_name = option.name | downcase -%}
              {%- if option_name == 'color' or option_name == 'colour' -%}
                {%- assign is_colour = true -%}
              {%- else -%}
                {%- assign is_colour = false -%}
              {%- endif -%}

              <fieldset class="pdp__group" data-option-index="{{ forloop.index0 }}">
                <legend class="visually-hidden">{{ option.name | escape }}</legend>
                <span class="pdp__group-name accent-caps" aria-hidden="true">
                  {{- option.name | escape }} <b data-selected-for="{{ forloop.index0 }}">{{ option.selected_value | escape }}</b>
                </span>
                <div class="pdp__values">
                  {%- for value in option.values -%}
                    {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                    <div class="pdp__value" data-value="{{ value | escape }}">
                      <input
                        type="radio"
                        id="{{ input_id }}"
                        name="{{ section.id }}-option-{{ option.position }}"
                        value="{{ value | escape }}"
                        data-option-input
                        {% if value == option.selected_value %}checked{% endif %}
                      >
                      {%- if is_colour -%}
                        <label
                          class="pdp__swatch"
                          for="{{ input_id }}"
                          data-swatch="{{ value | handle }}"
                          title="{{ value | escape }}"
                        >
                          <span class="visually-hidden">{{ value | escape }}</span>
                        </label>
                      {%- else -%}
                        <label class="pdp__pill" for="{{ input_id }}">{{ value | escape }}</label>
                      {%- endif -%}
                    </div>
                    {%- comment -%}closes .pdp__value{%- endcomment -%}
                  {%- endfor -%}
                </div>

                {%- comment -%}
                  The size guide hangs off the Size fieldset rather than sitting
                  loose in the buy block, because "will this fit" is a question
                  asked at the moment of choosing a size, not before or after.
                {%- endcomment -%}
                {%- unless is_colour -%}
                  {%- render 'size-guide',
                    rows: section.settings.size_rows,
                    heading: section.settings.size_heading,
                    note: section.settings.size_note,
                    summary: section.settings.size_summary
                  -%}
                {%- endunless -%}
              </fieldset>
            {%- endfor -%}
            {%- endunless -%}
          </div>
        {%- endif -%}

        <form
          id="{{ atc_form_id }}"
          action="{{ routes.cart_add_url }}"
          method="post"
          enctype="multipart/form-data"
          class="pdp__atc"
          data-pdp-form
        >
          <input type="hidden" name="id" value="{{ current_variant.id }}" data-pdp-variant-id>
          <input type="hidden" name="quantity" value="1">
          <span class="btn-wrap">
            <span class="btn-shadow" aria-hidden="true"></span>
            <button
              type="submit"
              name="add"
              class="btn btn--primary"
              data-pdp-submit
              {% unless current_variant.available %}disabled{% endunless %}
            >
              <span data-pdp-submit-text>
                {%- if current_variant == nil -%}
                  {{ section.settings.unavailable_label | escape }}
                {%- elsif current_variant.available -%}
                  {{ section.settings.add_label | escape }}
                {%- else -%}
                  {{ section.settings.sold_out_label | escape }}
                {%- endif -%}
              </span>
            </button>
          </span>
        </form>

        {%- comment -%}
          The character's other tees sit straight under Add to Cart, ahead of the
          reassurance below, so the next thing a shopper sees is more to buy.
        {%- endcomment -%}
        {%- if character_tabs != blank -%}
          <div class="pdp__related">{{ character_tabs }}</div>
        {%- endif -%}

        {%- comment -%}
          Trust badges, then the payment row, then the one-line reassurance —
          descending order of how much weight each carries at the moment of
          deciding. Badges are blocks so the set can change per store without
          touching Liquid; each is an inline SVG rather than an uploaded image,
          per the house rule that image-borne text becomes real text.
        {%- endcomment -%}
        {%- assign trust_blocks = section.blocks | where: 'type', 'trustbadge' -%}
        {%- if trust_blocks.size > 0 -%}
          <ul class="pdp__badges-row">
            {%- for block in trust_blocks -%}
              {%- if block.settings.label == blank -%}
                {%- continue -%}
              {%- endif -%}
              <li class="pdp__badge-item" {{ block.shopify_attributes }}>
                <span class="pdp__badge-icon" aria-hidden="true">
                  {%- case block.settings.icon -%}
                    {%- when 'shipping' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M2 7h11v9H2zM13 10h4l3 3v3h-7z"/><circle cx="6" cy="18" r="1.6"/><circle cx="17" cy="18" r="1.6"/>
                      </svg>
                    {%- when 'returns' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 12a9 9 0 1 0 3-6.7"/><path d="M3 4v5h5"/>
                      </svg>
                    {%- when 'secure' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 3l7 3v6c0 4.4-3 7.7-7 9-4-1.3-7-4.6-7-9V6z"/><path d="M9 12l2 2 4-4"/>
                      </svg>
                    {%- when 'cotton' -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 21c-4 0-7-3-7-7 0-5 7-11 7-11s7 6 7 11c0 4-3 7-7 7z"/><path d="M12 21v-7"/>
                      </svg>
                    {%- else -%}
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/>
                      </svg>
                  {%- endcase -%}
                </span>
                <span class="pdp__badge-text">{{ block.settings.label | escape }}</span>
              </li>
            {%- endfor -%}
          </ul>
        {%- endif -%}

        {%- comment -%}
          Payment icons come from `shop.enabled_payment_types`, so they are
          always exactly what this store actually accepts — never a stock strip
          of card logos it cannot take. It renders nothing when the store has
          no gateways configured, which is the state today.
        {%- endcomment -%}
        {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
          <div class="pdp__payments">
            {%- if section.settings.payment_label != blank -%}
              <span class="pdp__payments-label">{{ section.settings.payment_label | escape }}</span>
            {%- endif -%}
            <ul class="pdp__payment-list">
              {%- for type in shop.enabled_payment_types -%}
                <li>{{ type | payment_type_svg_tag: class: 'pdp__payment-icon' }}</li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}

        {%- if section.settings.trust_line != blank -%}
          <p class="pdp__trust">{{ section.settings.trust_line | escape }}</p>
        {%- endif -%}
      </div>
      <div class="pdp__details">{{ product_details }}</div>
    </div>

    {%- comment -%}
      Sticky buy bar, phones only. It is NOT a second <form> — two forms posting
      the same variant would double-add if a shopper hit both, and a duplicated
      hidden variant input is one more thing to keep in sync with the picker.
      The button submits the real form by id, so the existing variant-change
      JavaScript keeps owning the state and there is exactly one source of it.

      Hidden until the real Add to Cart scrolls out of view, so it never covers
      the button it is standing in for.
    {%- endcomment -%}
    {%- if section.settings.show_sticky_atc -%}
      <div class="pdp__sticky" data-pdp-sticky hidden>
        <div class="pdp__sticky-inner">
          <span class="pdp__sticky-meta">
            <span class="pdp__sticky-title">{{ product.title | escape }}</span>
            <span class="pdp__sticky-price" data-pdp-sticky-price>
              {{- current_variant.price | default: product.price | money -}}
            </span>
          </span>
          <span class="btn-wrap pdp__sticky-cta">
            <span class="btn-shadow" aria-hidden="true"></span>
            <button
              class="btn btn--primary"
              type="submit"
              form="{{ atc_form_id }}"
              data-pdp-sticky-button
              {% unless current_variant.available %}disabled{% endunless %}
            >
              {%- if current_variant.available -%}
                {{ section.settings.add_label | escape }}
              {%- else -%}
                {{ section.settings.sold_out_label | escape }}
              {%- endif -%}
            </button>
          </span>
        </div>
      </div>
    {%- endif -%}

    {%- comment -%}
      Judge.me's own review widget markup, straight out of its metafield. It is
      absent on every product but wander-tee today, and the theme prints
      nothing when it is — never an empty "Reviews" heading over a blank box.

      It needs Judge.me's script, which arrives via the app embed. That embed
      is not enabled in this theme; see snippets/review-stars.liquid.
    {%- endcomment -%}
    {%- comment -%}
      Test the CONTENT, not the presence. With zero reviews Judge.me stores the
      literal string `<div></div>` in this metafield — verified against the
      store — which is not blank, so a `!= blank` guard passed and wander-tee
      shipped 60px of empty margin under its buy block. strip_html reduces the
      placeholder to nothing while a real widget survives it.
    {%- endcomment -%}
    {%- assign jm_widget = product.metafields.judgeme.widget | strip_html | strip -%}
    {%- if jm_widget != blank -%}
      <div class="pdp__reviews">{{ product.metafields.judgeme.widget }}</div>
    {%- endif -%}
  </div>
</section>

<script>
  (function () {
    var root = document.getElementById('MainProduct-{{ section.id }}');
    if (!root || root.dataset.pdpInit) return;
    root.dataset.pdpInit = '1';

    // --- Category tabs.
    var tabs = root.querySelectorAll('[data-pdp-tab]');
    function selectTab(tab) {
      tabs.forEach(function (t) {
        var active = t === tab;
        t.setAttribute('aria-selected', active ? 'true' : 'false');
        t.tabIndex = active ? 0 : -1;
      });
      root.querySelectorAll('[data-pdp-panel]').forEach(function (p) {
        p.hidden = p.dataset.pdpPanel !== tab.dataset.pdpTab;
      });
    }
    tabs.forEach(function (tab) {
      tab.tabIndex = tab.getAttribute('aria-selected') === 'true' ? 0 : -1;
      tab.addEventListener('click', function () {
        selectTab(tab);
      });
      tab.addEventListener('keydown', function (event) {
        var index = Array.prototype.indexOf.call(tabs, tab);
        if (event.key === 'ArrowRight') index = (index + 1) % tabs.length;
        else if (event.key === 'ArrowLeft') index = (index + tabs.length - 1) % tabs.length;
        else if (event.key === 'Home') index = 0;
        else if (event.key === 'End') index = tabs.length - 1;
        else return;
        event.preventDefault();
        selectTab(tabs[index]);
        tabs[index].focus();
      });
    });

    // --- Gallery: one panel per colour, toggled by the swatch picker.
    var galleries = root.querySelectorAll('[data-gallery]');

    // Dots for the stacked-layout carousel. Built for every gallery; CSS
    // keeps them display:none on desktop.
    galleries.forEach(function (g) {
      var slides = g.querySelectorAll('.pdp__featured-row, .pdp__wide, .pdp__square');
      if (slides.length < 2) return;

      var nav = document.createElement('div');
      nav.className = 'pdp__dots';
      nav.setAttribute('role', 'group');
      nav.setAttribute('aria-label', {{ section.settings.thumb_label | default: 'Show image' | json }});
      slides.forEach(function (slide, i) {
        var dot = document.createElement('button');
        dot.type = 'button';
        dot.className = 'pdp__dot';
        dot.setAttribute('aria-label', {{ section.settings.thumb_label | default: 'Show image' | json }} + ' ' + (i + 1));
        if (i === 0) dot.setAttribute('aria-current', 'true');
        dot.addEventListener('click', function () {
          g.scrollTo({ left: slide.offsetLeft - g.offsetLeft, behavior: window.matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth' });
        });
        nav.appendChild(dot);
      });
      g.after(nav);
      g.jjwDots = nav;
      nav.hidden = g.hidden;

      g.addEventListener('scroll', function () {
        // Slides are full-width, so the nearest index is a plain division.
        var i = Math.round(g.scrollLeft / g.clientWidth);
        nav.querySelectorAll('.pdp__dot').forEach(function (d, j) {
          if (j === i) d.setAttribute('aria-current', 'true');
          else d.removeAttribute('aria-current');
        });
      }, { passive: true });
    });

    function showGallery(colour) {
      if (!galleries.length) return;
      var hit = false;
      galleries.forEach(function (g) {
        var match = g.dataset.gallery === colour;
        g.hidden = !match;
        if (g.jjwDots) g.jjwDots.hidden = !match;
        if (match) hit = true;
      });
      if (!hit) galleries.forEach(function (g, i) {
        g.hidden = i !== 0;
        if (g.jjwDots) g.jjwDots.hidden = i !== 0;
      });
    }

    // --- Variant picker.
    var source = root.querySelector('[data-pdp-variants]');
    var picker = root.querySelector('[data-pdp-picker]');
    if (!source || !picker) return;

    var variants;
    try {
      variants = JSON.parse(source.textContent);
    } catch (e) {
      return;
    }

    var idInput = root.querySelector('[data-pdp-variant-id]');
    var priceEl = root.querySelector('[data-pdp-price]');
    var compareEl = root.querySelector('[data-pdp-compare]');
    var submit = root.querySelector('[data-pdp-submit]');
    var submitText = root.querySelector('[data-pdp-submit-text]');
    var stickyButton = root.querySelector('[data-pdp-sticky-button]');
    var stickyPrice = root.querySelector('[data-pdp-sticky-price]');
    var labels = {
      add: {{ section.settings.add_label | default: 'Add to Cart' | json }},
      soldOut: {{ section.settings.sold_out_label | default: 'Sold Out' | json }},
      unavailable: {{ section.settings.unavailable_label | default: 'Unavailable' | json }}
    };

    function selection() {
      return Array.prototype.map.call(picker.querySelectorAll('[data-option-index]'), function (group) {
        var checked = group.querySelector('input:checked');
        return checked ? checked.value : null;
      });
    }

    function matches(chosen) {
      for (var i = 0; i < variants.length; i++) {
        var v = variants[i];
        var hit = true;
        for (var j = 0; j < chosen.length; j++) {
          if (chosen[j] !== null && v.options[j] !== chosen[j]) { hit = false; break; }
        }
        if (hit) return v;
      }
      return null;
    }

    // A value is unavailable when no available variant exists with that value
    // held against the current choice for every other option.
    function markAvailability(chosen) {
      picker.querySelectorAll('[data-option-index]').forEach(function (group) {
        var index = parseInt(group.dataset.optionIndex, 10);
        group.querySelectorAll('.pdp__value').forEach(function (wrap) {
          var probe = chosen.slice();
          probe[index] = wrap.dataset.value;
          var found = variants.some(function (v) {
            if (!v.available) return false;
            return probe.every(function (val, j) {
              return val === null || v.options[j] === val;
            });
          });
          if (found) wrap.removeAttribute('data-unavailable');
          else wrap.setAttribute('data-unavailable', '');
        });
      });
    }

    // The colour group is the one rendered as swatches.
    var colourGroup = null;
    picker.querySelectorAll('[data-option-index]').forEach(function (g) {
      if (g.querySelector('.pdp__swatch')) colourGroup = g;
    });

    function update() {
      var chosen = selection();
      var variant = matches(chosen);

      picker.querySelectorAll('[data-selected-for]').forEach(function (el) {
        el.textContent = chosen[parseInt(el.dataset.selectedFor, 10)] || '';
      });

      markAvailability(chosen);

      if (colourGroup) {
        var picked = colourGroup.querySelector('input:checked');
        showGallery(picked ? picked.value : '');
      }

      if (variant && idInput) idInput.value = variant.id;
      if (variant && priceEl) priceEl.innerHTML = variant.price;
      if (compareEl) compareEl.innerHTML = variant && variant.compare_at ? variant.compare_at : '';

      if (submit) {
        var buyable = !!(variant && variant.available);
        submit.disabled = !buyable;
        if (submitText) {
          submitText.textContent = !variant ? labels.unavailable : variant.available ? labels.add : labels.soldOut;
        }
      }

      /* The sticky bar mirrors the real button rather than deriving its own
         state — one source of truth, so the two can never disagree about
         whether the chosen size is in stock. */
      if (stickyButton) {
        var stickyBuyable = !!(variant && variant.available);
        stickyButton.disabled = !stickyBuyable;
        stickyButton.textContent = !variant
          ? labels.unavailable
          : variant.available ? labels.add : labels.soldOut;
      }
      if (variant && stickyPrice) stickyPrice.innerHTML = variant.price;
    }

    picker.addEventListener('change', function (event) {
      if (event.target.matches('[data-option-input]')) update();
    });

    update();
  })();

  (function () {
    /* Reveal the sticky buy bar only once the real Add to Cart has scrolled
       away, so it never sits on top of the button it stands in for.

       Its own IntersectionObserver rather than the theme's scroll-reveal: this
       has to toggle BOTH ways as the shopper scrolls up and down, where
       .scroll-trigger reveals once and unobserves. Separate IIFE too, because
       the variant script above returns early on products with no picker and
       the bar must still work on those. */
    var root = document.getElementById('MainProduct-{{ section.id }}');
    if (!root || root.dataset.stickyInit) return;
    root.dataset.stickyInit = '1';

    var bar = root.querySelector('[data-pdp-sticky]');
    var anchor = root.querySelector('[data-pdp-submit]');
    if (!bar || !anchor) return;

    if (!('IntersectionObserver' in window)) {
      /* No observer: leave the bar hidden rather than pinning a duplicate
         button over the page for the whole visit. */
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          /* Past it going down, or scrolled back above it — the button is out
             of view either way, but only the downward case should summon the
             bar. Above the fold the shopper has not reached the buy block yet. */
          var scrolledPast = !entry.isIntersecting && entry.boundingClientRect.top < 0;
          bar.hidden = !scrolledPast;
        });
      },
      { rootMargin: '0px 0px -80px 0px', threshold: 0 }
    );

    observer.observe(anchor);
  })();
</script>

