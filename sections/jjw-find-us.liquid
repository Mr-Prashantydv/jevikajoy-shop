{%- comment -%}
  JJW find-us — mirrors Partake's `find-us` band: a rounded 40px panel with a
  centred heading, a trust-mark marquee, and a centred CTA. Reuses the
  `.marquee` mechanics from jjw-marquee.liquid (docs/clone/DESIGN-SYSTEM.md §5)
  instead of reinventing the animation — only the content differs (images, not
  text). Conceptually replaces jjw-press-logos.liquid (retailer logos → trust /
  certification marks, docs/clone/ASSET-MANIFEST.md slot 5); lives at its own
  path per the task spec, jjw-press-logos.liquid is left untouched.
  Reference: docs/clone/DESIGN-SYSTEM.md §9 row "find-us" (H707, field #0F7DAF
  via scheme-4).
{%- endcomment -%}

{%- style -%}
  #JJWFindUs-{{ section.id }} .find-us-panel {
    border-radius: 40px;
    padding: 64px 24px;
    text-align: center;
  }

  #JJWFindUs-{{ section.id }} .find-us-eyebrow {
    font-family: var(--jjw-font-cond);
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    font-size: var(--jjw-fs-24);
    margin: 0 0 12px;
  }

  #JJWFindUs-{{ section.id }} .find-us-heading {
    margin: 0 auto 40px;
    max-width: 46rem;
  }

  #JJWFindUs-{{ section.id }} .find-us-marquee {
    margin-bottom: 48px;
  }

  #JJWFindUs-{{ section.id }} .marquee__content {
    gap: 4rem;
    padding-right: 4rem;
  }

  #JJWFindUs-{{ section.id }} .marquee__image {
    height: 180px;
    width: auto;
    display: block;
  }

  #JJWFindUs-{{ section.id }} .find-us-mark-placeholder {
    height: 180px;
    width: 180px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 2px dashed rgba(var(--color-foreground), 0.4);
    border-radius: 16px;
    font-family: var(--jjw-font-cond);
    text-transform: uppercase;
    font-size: 14px;
    letter-spacing: 0.05em;
  }

  #JJWFindUs-{{ section.id }} .find-us-cta {
    display: flex;
    justify-content: center;
  }

  @media screen and (max-width: 749px) {
    #JJWFindUs-{{ section.id }} .find-us-panel {
      padding: 48px 20px;
    }

    #JJWFindUs-{{ section.id }} .marquee__image,
    #JJWFindUs-{{ section.id }} .find-us-mark-placeholder {
      height: 110px;
      width: 110px;
    }
  }
{%- endstyle -%}

<section id="JJWFindUs-{{ section.id }}">
  <div class="page-width">
    <div class="find-us-panel color-{{ section.settings.color_scheme }} gradient">
      {%- if section.settings.eyebrow != blank -%}
        <p class="find-us-eyebrow">{{ section.settings.eyebrow | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h2 class="find-us-heading hxxl">{{ section.settings.heading }}</h2>
      {%- endif -%}

      {%- if section.blocks.size > 0 -%}
        <div class="find-us-marquee marquee marquee--pause-on-hover">
          <div class="marquee__wrapper">
            {%- comment -%} 4 identical copies — required for a seamless -50% loop {%- endcomment -%}
            {%- for i in (1..4) -%}
              <div class="marquee__content" {% unless forloop.first %}aria-hidden="true"{% endunless %}>
                {%- for block in section.blocks -%}
                  <span class="marquee__mark" {{ block.shopify_attributes }}>
                    {%- if block.settings.image != blank -%}
                      {{
                        block.settings.image
                        | image_url: height: 360
                        | image_tag:
                          loading: 'lazy',
                          class: 'marquee__image',
                          alt: block.settings.alt | default: block.settings.image.alt | default: 'Trust mark' | escape
                      }}
                    {%- else -%}
                      <span class="find-us-mark-placeholder">{{ 'Mark ' | append: forloop.index }}</span>
                    {%- endif -%}
                  </span>
                {%- endfor -%}
              </div>
            {%- endfor -%}
          </div>
        </div>
      {%- endif -%}

      {%- if section.settings.cta_text != blank -%}
        <div class="find-us-cta">
          <div class="button--wrapper">
            <div class="button--bg"></div>
            <a href="{{ section.settings.cta_link | default: '#' }}" class="button button--primary">
              {{- section.settings.cta_text | escape -}}
            </a>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW find us",
  "tag": "section",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Trusted By Parents Everywhere" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading", "default": "Find Us Wherever Little Ones Play" },
    { "type": "text", "id": "cta_text", "label": "Button label", "default": "Shop All Tees" },
    { "type": "url", "id": "cta_link", "label": "Button link" },
    { "type": "color_scheme", "id": "color_scheme", "label": "Color scheme", "default": "scheme-4" }
  ],
  "blocks": [
    {
      "type": "mark",
      "name": "Trust mark",
      "limit": 12,
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "alt", "label": "Alt text" }
      ]
    }
  ],
  "presets": [
    {
      "name": "JJW find us",
      "blocks": [
        { "type": "mark" },
        { "type": "mark" },
        { "type": "mark" },
        { "type": "mark" },
        { "type": "mark" }
      ]
    }
  ]
}
{% endschema %}
