{%- liquid
  assign character_tag = ''
  for tag in product.tags
    if tag contains 'character:'
      assign character_tag = tag | remove: 'character:'
    endif
  endfor

  assign char_color = ''
  assign char_face = ''
  case character_tag
    when 'Jevika'
      assign char_color = '#E5377E'
      assign char_face = 'jevika-face.png'
    when 'Joy'
      assign char_color = '#F68B1F'
      assign char_face = 'joy-face.png'
    when 'Pinki'
      assign char_color = '#0F7DAF'
      assign char_face = 'pinki-face.png'
    when 'Minku'
      assign char_color = '#2FA85E'
      assign char_face = 'minku-face.png'
    when 'Brutus'
      assign char_color = '#6E55D6'
      assign char_face = 'brutus-face.png'
  endcase
-%}

{%- style -%}
  .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }

  #JJWProductStory-{{ section.id }} {
    background: var(--jjw-cream);
    border-radius: var(--jjw-radius-card);
  }

  #JJWProductStory-{{ section.id }} .jjw-story-inner {
    padding: clamp(24px, 3vw, 40px);
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 24px;
    justify-content: space-between;
  }

  #JJWProductStory-{{ section.id }} .jjw-story-character {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  #JJWProductStory-{{ section.id }} .jjw-story-character img {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    object-fit: cover;
    background: #FFFFFF;
    box-shadow: 0 0 0 3px #FFFFFF, 0 0 0 5px var(--face-color, var(--jjw-ink));
  }

  #JJWProductStory-{{ section.id }} .jjw-story-character-label {
    font-family: var(--jjw-font-mono);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--jjw-ink-soft);
    display: block;
    margin-bottom: 2px;
  }

  #JJWProductStory-{{ section.id }} .jjw-story-character-name {
    font-family: var(--jjw-font-display);
    font-size: 1.3rem;
    color: var(--face-color, var(--jjw-ink));
  }

  #JJWProductStory-{{ section.id }} .jjw-story-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
{%- endstyle -%}

<section id="JJWProductStory-{{ section.id }}" class="section-{{ section.id }}-padding">
  <div class="page-width">
    <div class="jjw-story-inner">
      {%- if character_tag != blank -%}
        <div class="jjw-story-character" style="--face-color: {{ char_color }};">
          {%- if char_face != blank -%}
            <img src="{{ char_face | asset_url }}" alt="{{ character_tag }}" width="52" height="52" loading="lazy">
          {%- endif -%}
          <span>
            <span class="jjw-story-character-label">{{ section.settings.character_label | default: 'Featuring' }}</span>
            <span class="jjw-story-character-name">{{ character_tag }}</span>
          </span>
        </div>
      {%- endif -%}

      <div class="jjw-story-chips">
        {%- for block in section.blocks -%}
          {%- if block.type == 'chip' -%}
            <span class="jjw-chip" {{ block.shopify_attributes }}>{{ block.settings.text }}</span>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW Product Story",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "text",
      "id": "character_label",
      "label": "Character Label",
      "default": "Featuring"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Top padding",
      "default": 32
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Bottom padding",
      "default": 32
    }
  ],
  "blocks": [
    {
      "type": "chip",
      "name": "Trust Chip",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Chip Text",
          "default": "100% Organic Cotton"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "JJW Product Story",
      "blocks": [
        { "type": "chip", "settings": { "text": "100% Organic Cotton" } },
        { "type": "chip", "settings": { "text": "BIS Certified Safe" } },
        { "type": "chip", "settings": { "text": "220 GSM Combed Cotton" } },
        { "type": "chip", "settings": { "text": "Water-Based Inks" } }
      ]
    }
  ]
}
{% endschema %}
