{%- comment -%}
  Falling scroll — ported from the React FallingCookies component
  (test opencode/src/components/site/falling-cookies.tsx).

  The React version drives the drop with GSAP ScrollTrigger + a pinned section.
  GSAP is not available here, so the pin is a plain position:sticky and the
  progress is one scroll listener that writes a --p custom property; all the
  interpolation happens in CSS calc(). No JS = every item renders in its landed
  position, which is also the reduced-motion state.
{%- endcomment -%}

{%- style -%}
  #FallingScroll-{{ section.id }} {
    --p: 1;
    position: relative;
    height: {{ section.settings.scroll_length }}vh;
    margin-bottom: 1.5rem;
    background: var(--cream);
  }

  #FallingScroll-{{ section.id }} .falling-scroll__sticky {
    position: sticky;
    top: 0;
    z-index: 10;
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100vh;
    overflow: hidden;
    {%- comment -%}
      The ground always renders: a merchant upload wins, otherwise the artwork
      that ships with the theme. There is no branch here that leaves the stage
      bare, so the cast always has something to land on.

      100% auto, not cover: cover scales to fill the taller axis and crops the
      sides off, which cut the mushrooms and the outer grass clumps away on a
      wide viewport. This uses the artwork's full width and lets its height
      fall where it may, anchored to the bottom of the stage.
    {%- endcomment -%}
    {%- if section.settings.ground_image != blank %}
    background-image: url({{ section.settings.ground_image | image_url: width: 2400 }});
    {%- else %}
    background-image: url({{ 'jjw-ground.png' | asset_url }});
    {%- endif %}
    background-size: 100% auto;
    background-position: bottom center;
    background-repeat: no-repeat;
  }

  #FallingScroll-{{ section.id }} .falling-scroll__stage {
    position: relative;
    width: 100%;
    height: 100%;
  }

  {%- comment -%}
    Offset in rem, not a percentage of the stage.

    On the homepage the bar is a sticky height: 0 overlay that floats above
    whatever scrolls under it, and this section pins a stage with copy at its
    top. At 3% the heading ran straight into it: at 1311px the Find In Store
    button (x 838-1059) landed on top of the heading's first line (x 328-983),
    printing the button across the word "Every".

    The bar is a fixed pixel height — about 112px here, 79px on a phone — so a
    percentage of viewport height is the wrong unit: it drifts with window
    height while the thing it has to clear does not. 13rem clears the desktop
    bar with ~18px to spare, 10rem the phone one with ~21px.
  {%- endcomment -%}
  #FallingScroll-{{ section.id }} .falling-scroll__copy {
    position: absolute;
    top: 13rem;
    left: 50%;
    z-index: 40;
    width: 50%;
    max-width: 80%;
    transform: translateX(-50%);
    text-align: center;
  }

  #FallingScroll-{{ section.id }} .falling-scroll__title,
  #FallingScroll-{{ section.id }} .falling-scroll__sub {
    color: var(--ink);
  }

  #FallingScroll-{{ section.id }} .falling-scroll__sub {
    margin: 1rem 0 0;
    font-family: var(--font-accent);
    font-size: max(2vw, 3.4rem);
    line-height: 6.12rem;
    letter-spacing: 0.1rem;
    text-transform: uppercase;
  }

  #FallingScroll-{{ section.id }} .falling-scroll__pile {
    position: absolute;
    top: {{ section.settings.pile_y }}%;
    left: 50%;
    z-index: 2;
    width: {{ section.settings.pile_width }}vw;
    height: auto;
    transform: translate(-50%, -50%);
    opacity: clamp(0, calc(var(--p) * 6), 1);
  }

  /* Floating accents: drift in and bob, standing in for real art later. */
  #FallingScroll-{{ section.id }} .falling-scroll__accent {
    position: absolute;
    left: calc(50% + (var(--x) - 50%) * var(--p, 0));
    top: calc(50% + (var(--y) - 50%) * var(--p, 0));
    width: var(--w);
    aspect-ratio: 1 / 1;
    background: var(--accent-color);
    transform: translate(-50%, -50%) scale(calc(0.4 + 0.6 * var(--p, 0)));
    opacity: var(--p, 0);
    animation: fs-float-{{ section.id }} 4.5s var(--ease) infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.9s);
    pointer-events: none;
  }

  /* Lettered tag variant, matching the hero and about-section labels. */
  #FallingScroll-{{ section.id }} .falling-scroll__tag {
    position: absolute;
    left: calc(50% + (var(--x) - 50%) * var(--p, 0));
    top: calc(50% + (var(--y) - 50%) * var(--p, 0));
    display: block;
    max-width: 20rem;
    padding: 0.9rem 1.6rem 0.8rem;
    border-radius: 0.5rem;
    background: var(--accent-color);
    color: var(--tag-fg, var(--cream));
    box-shadow: 4px 4px 0 0 var(--tag-shadow, rgba(0, 0, 0, 0.2));
    font-family: var(--font-accent);
    font-weight: 700;
    font-size: 1.9rem;
    line-height: 1.1;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    text-align: center;
    text-wrap: balance;
    transform: translate(-50%, -50%) rotate(var(--rot, -6deg))
               scale(calc(0.5 + 0.5 * var(--p, 0)));
    opacity: var(--p, 0);
    animation: fs-float-{{ section.id }} 4.5s var(--ease) infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.9s);
    pointer-events: none;
  }

  @media screen and (max-width: 749px) {
    #FallingScroll-{{ section.id }} .falling-scroll__tag {
      font-size: 1.1rem;
      max-width: 11rem;
      padding: 0.5rem 0.9rem 0.45rem;
    }
  }

  #FallingScroll-{{ section.id }} .falling-scroll__accent--circle { border-radius: 50%; }
  #FallingScroll-{{ section.id }} .falling-scroll__accent--star {
    clip-path: polygon(50% 0%, 61% 35%, 98% 35%, 68% 57%, 79% 91%, 50% 70%, 21% 91%, 32% 57%, 2% 35%, 39% 35%);
  }
  #FallingScroll-{{ section.id }} .falling-scroll__accent--blob {
    border-radius: 60% 40% 55% 45% / 45% 55% 45% 55%;
  }

  @keyframes fs-float-{{ section.id }} {
    from { translate: 0 0; }
    to   { translate: 0 -1.4rem; }
  }

  /* The cast falls from above. Each character holds its own x and travels down
     to its landing point in the group formation, so the arrangement assembles
     as they arrive rather than expanding out of a pile. */
  #FallingScroll-{{ section.id }} .falling-scroll__item {
    --start-y: {{ section.settings.start_y | default: 10 }}%;
    position: absolute;
    left: var(--x);
    width: var(--w);
    height: auto;
    aspect-ratio: 2 / 3;
    object-fit: contain;
  }

  #FallingScroll-{{ section.id }} .falling-scroll__item--fall {
    top: calc(var(--y) * var(--p, 0) + var(--start-y, 10%) * (1 - var(--p, 0)));
    transform: translate(-50%, -50%) scale(calc(0.88 + 0.12 * var(--p, 0)));
    animation: fs-bob-{{ section.id }} 3.4s var(--ease) infinite alternate;
    animation-delay: calc(var(--i, 0) * -0.7s);
    will-change: top, transform;
  }

  /* Badges sit still, settle 2.4rem upward and drift with a light parallax. */
  #FallingScroll-{{ section.id }} .falling-scroll__item--badge {
    top: var(--y);
    transform: translate(-50%, -50%) translateY(calc(2.4rem - 2.4rem * var(--p)))
      translateY(calc(-10% * var(--p)));
  }

  /* Idle bob uses the independent `translate` property so it composes with the
     scroll-driven `transform` instead of fighting it. */
  @keyframes fs-bob-{{ section.id }} {
    from {
      translate: 0 -0.6rem;
    }
    to {
      translate: 0 0.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    {%- comment -%}
      The bar is shorter here (5rem controls), so the copy needs less clearance
      than the 13rem the base rule uses. See the note there.
    {%- endcomment -%}
    #FallingScroll-{{ section.id }} .falling-scroll__copy {
      top: 10rem;
      width: 86%;
      max-width: 86%;
    }

    #FallingScroll-{{ section.id }} .falling-scroll__sub {
      font-size: 2.2rem;
      line-height: 1.2;
    }

    {%- comment -%}
      Scale the ground by height at phone width, not by width.

      The artwork is a 2080x627 strip — 3.3:1. At 100% width that resolves to
      118px on a 390px screen, about 14% of the stage, and the two tallest
      characters landed at 73% with nothing under them. Pinning the band to a
      share of the stage keeps it reading as a floor, and the sides crop
      instead — which is what the reference does with its tiled floor, since a
      floor has to stay a floor whatever the screen.
    {%- endcomment -%}
    #FallingScroll-{{ section.id }} .falling-scroll__sticky {
      background-size: auto 34%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #FallingScroll-{{ section.id }} {
      height: 100vh;
    }

    #FallingScroll-{{ section.id }} .falling-scroll__sticky {
      position: static;
    }

    #FallingScroll-{{ section.id }} .falling-scroll__item--fall {
      animation: none;
    }
  }
  /* Narrow viewports: the cast reads tiny at desktop vw sizes, so scale it up to
     fill the stage. Applied below 990px so narrow desktop windows get it too,
     not just phones. */
  @media screen and (max-width: 989px) {
    #FallingScroll-{{ section.id }} .falling-scroll__item {
      width: calc(var(--w) * {{ section.settings.mobile_scale | default: 270 | divided_by: 100.0 }});
      /* Cast and badges spread independently: the badges are already near the
         screen edge, so pushing the characters apart must not move them too. */
      left: calc(50% + (var(--x) - 50%) * {{ section.settings.mobile_spread | default: 170 | divided_by: 100.0 }});
    }

    #FallingScroll-{{ section.id }} .falling-scroll__item--fall {
      top: calc(
        (50% + (var(--y) - 50%) * {{ section.settings.mobile_spread_y | default: 125 | divided_by: 100.0 }}) * var(--p, 0)
        + var(--start-y, 10%) * (1 - var(--p, 0))
      );
    }

    #FallingScroll-{{ section.id }} .falling-scroll__tag {
      left: calc(50% + (var(--x) - 50%) * var(--p, 0) * {{ section.settings.mobile_spread_tags | default: 130 | divided_by: 100.0 }});
    }
  }

{%- endstyle -%}

<div id="FallingScroll-{{ section.id }}" class="falling-scroll">
  <div class="falling-scroll__sticky">
    <div class="falling-scroll__stage">
      <div class="falling-scroll__copy">
        {%- if section.settings.heading != blank -%}
          <h2 class="hxxl falling-scroll__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subheading != blank -%}
          <p class="falling-scroll__sub">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </div>

      {%- if section.settings.pile_image != blank -%}
        <img
          class="falling-scroll__pile"
          src="{{ section.settings.pile_image | image_url: width: 2000 }}"
          alt="{{ section.settings.pile_image.alt | escape }}"
          width="{{ section.settings.pile_image.width }}"
          height="{{ section.settings.pile_image.height }}"
          loading="lazy"
        >
      {%- endif -%}

      {%- comment -%}
        Ground image is now the CSS background of .falling-scroll__sticky.
      {%- endcomment -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'accent' and block.settings.text != blank -%}
          <span
            class="falling-scroll__tag"
            aria-hidden="true"
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --accent-color: {{ block.settings.color }}; --tag-fg: {{ block.settings.text_color }}; --tag-shadow: {{ block.settings.color | color_darken: 20 }}; --rot: {{ block.settings.rotate }}deg; --i: {{ forloop.index0 }}; z-index: {{ block.settings.depth | default: 2 }};"
            {{ block.shopify_attributes }}
          >{{ block.settings.text | escape }}</span>
        {%- elsif block.type == 'accent' -%}
          <span
            class="falling-scroll__accent falling-scroll__accent--{{ block.settings.shape }}"
            aria-hidden="true"
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --w: {{ block.settings.size }}rem; --accent-color: {{ block.settings.color }}; --i: {{ forloop.index0 }}; z-index: {{ block.settings.depth | default: 2 }};"
            {{ block.shopify_attributes }}
          ></span>
        {%- endif -%}
      {%- endfor -%}

      {%- for block in section.blocks -%}
        {%- if block.type == 'accent' -%}{%- continue -%}{%- endif -%}
        {%- comment -%}
          image_picker only accepts Shopify Files, so a character fallback lets the
          section work with the faces already bundled in assets/.
        {%- endcomment -%}
        {%- assign fallback_src = '' -%}
        {%- if block.settings.image == blank and block.settings.character != 'none' -%}
          {%- comment -%}
            asset_img_url resizes theme assets on Shopify's CDN, so the ~1.7MB
            source art is not shipped at full weight to every visitor.
          {%- endcomment -%}
          {%- assign fallback_file = 'jjw-pose-' | append: block.settings.character | append: '.png' -%}
          {%- assign fallback_src = fallback_file | asset_img_url: '900x' -%}
        {%- endif -%}
        {%- if block.settings.image == blank and fallback_src != blank -%}
          {%- assign delay = forloop.index0 | times: 6 | at_most: 30 | divided_by: 100.0 -%}
          <img
            class="falling-scroll__item falling-scroll__item--{{ block.settings.behavior }}"
            src="{{ fallback_src }}"
            alt=""
            width="1024"
            height="1536"
            loading="lazy"
            {% if block.settings.behavior == 'fall' %}data-fall="{{ delay }}"{% endif %}
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --w: {{ block.settings.size }}vw; --i: {{ forloop.index0 }}; z-index: {{ block.settings.depth | default: 10 }};"
            {{ block.shopify_attributes }}
          >
        {%- elsif block.settings.image != blank -%}
          {%- assign delay = forloop.index0 | times: 6 | at_most: 30 | divided_by: 100.0 -%}
          <img
            class="falling-scroll__item falling-scroll__item--{{ block.settings.behavior }}"
            src="{{ block.settings.image | image_url: width: 1400 }}"
            alt="{{ block.settings.image.alt | escape }}"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
            loading="lazy"
            {% if block.settings.behavior == 'fall' %}data-fall="{{ delay }}"{% endif %}
            style="--x: {{ block.settings.x }}%; --y: {{ block.settings.y }}%; --w: {{ block.settings.size }}vw; --i: {{ forloop.index0 }}; z-index: {{ block.settings.depth | default: 10 }};"
            {{ block.shopify_attributes }}
          >
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>
</div>

<script>
  (function () {
    var root = document.getElementById('FallingScroll-{{ section.id }}');
    if (!root || root.dataset.fsInit) return;
    root.dataset.fsInit = '1';

    if (window.matchMedia('(prefers-reduced-motion: reduce)').matches) return;

    var stage = root.querySelector('.falling-scroll__sticky');
    var items = root.querySelectorAll('[data-fall]');
    var ticking = false;

    // power3.inOut, the ease the React timeline used for the drop.
    function ease(t) {
      return t < 0.5 ? 4 * t * t * t : 1 - Math.pow(-2 * t + 2, 3) / 2;
    }

    function clamp(n) {
      return n < 0 ? 0 : n > 1 ? 1 : n;
    }

    function paint() {
      ticking = false;
      // Section replaced by the theme editor: drop the listeners with it.
      if (!root.isConnected) {
        window.removeEventListener('scroll', onScroll);
        window.removeEventListener('resize', onScroll);
        return;
      }
      var rect = root.getBoundingClientRect();
      var travel = rect.height - stage.offsetHeight;
      var p = travel > 0 ? clamp(-rect.top / travel) : rect.top < 0 ? 1 : 0;
      root.style.setProperty('--p', p.toFixed(4));
      for (var i = 0; i < items.length; i++) {
        var d = parseFloat(items[i].getAttribute('data-fall')) || 0;
        items[i].style.setProperty('--p', ease(clamp((p - d) / 0.7)).toFixed(4));
      }
    }

    function onScroll() {
      if (ticking) return;
      ticking = true;
      requestAnimationFrame(paint);
    }

    // Scroll events are unreliable here: some embedded/preview contexts and
    // smooth-scroll libraries never dispatch them. An rAF loop gated by an
    // IntersectionObserver is immune to that, and idles when off-screen.
    var running = false;

    function loop() {
      if (!root.isConnected) { running = false; return; }
      paint();
      if (running) requestAnimationFrame(loop);
    }

    function start() {
      if (running) return;
      running = true;
      requestAnimationFrame(loop);
    }

    function stop() { running = false; }

    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (entries) {
        entries[0].isIntersecting ? start() : stop();
      }, { rootMargin: '100px 0px' }).observe(root);
    } else {
      start();
    }

    window.addEventListener('scroll', onScroll, { passive: true });
    window.addEventListener('resize', onScroll);
    paint();
  })();
</script>

{% schema %}
{
  "name": "Falling scroll",
  "max_blocks": 20,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Room for Every Kind of Kid"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "FIVE FRIENDS, ONE WARDROBE"
    },
    {
      "type": "image_picker",
      "id": "background_image",
      "label": "Backdrop image",
      "info": "Sits along the bottom of the stage."
    },
    {
      "type": "image_picker",
      "id": "ground_image",
      "label": "Ground image",
      "info": "The surface the cast lands on. Falls back to the built-in clearing."
    },
    {
      "type": "range",
      "id": "ground_height",
      "label": "Ground height",
      "info": "Share of the stage height. Larger pushes the grass line down.",
      "min": 60,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 120
    },
    {
      "type": "range",
      "id": "ground_offset",
      "label": "Ground vertical position",
      "info": "Distance from the bottom of the stage. Raise it to bring the grass line up to the cast's feet.",
      "min": -20,
      "max": 60,
      "step": 1,
      "unit": "%",
      "default": 21
    },
    {
      "type": "image_picker",
      "id": "pile_image",
      "label": "Foreground pile image",
      "info": "Fades in as the items land. Leave empty to hide."
    },
    {
      "type": "range",
      "id": "pile_width",
      "label": "Pile width",
      "min": 20,
      "max": 100,
      "step": 5,
      "unit": "vw",
      "default": 90
    },
    {
      "type": "range",
      "id": "pile_y",
      "label": "Pile vertical position",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "%",
      "default": 83
    },
    {
      "type": "range",
      "id": "scroll_length",
      "label": "Scroll length",
      "info": "How much scrolling the pinned stage takes up.",
      "min": 100,
      "max": 250,
      "step": 10,
      "unit": "vh",
      "default": 150
    },
    {
      "type": "range",
      "id": "start_y",
      "label": "Start height",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "%",
      "default": 10,
      "info": "How far down the stage the cast begins before falling."
    },
    {
      "type": "range",
      "id": "mobile_scale",
      "label": "Cast size on narrow screens",
      "min": 100,
      "max": 400,
      "step": 10,
      "unit": "%",
      "default": 270,
      "info": "Applied below 990px wide."
    },
    {
      "type": "range",
      "id": "mobile_spread",
      "label": "Cast spread on narrow screens",
      "min": 100,
      "max": 250,
      "step": 5,
      "unit": "%",
      "default": 170,
      "info": "Applied below 990px wide."
    },
    {
      "type": "range",
      "id": "mobile_spread_y",
      "label": "Cast vertical spread (narrow)",
      "min": 100,
      "max": 180,
      "step": 5,
      "unit": "%",
      "default": 125
    },
    {
      "type": "range",
      "id": "mobile_spread_tags",
      "label": "Badge spread (narrow)",
      "min": 100,
      "max": 200,
      "step": 5,
      "unit": "%",
      "default": 130
    }
  ],
  "blocks": [
    {
      "type": "item",
      "name": "Falling item",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Nothing renders until an image is chosen."
        },
        {
          "type": "select",
          "id": "character",
          "label": "Character (used if no image picked)",
          "options": [
            {
              "value": "none",
              "label": "None"
            },
            {
              "value": "jevika",
              "label": "Jevika"
            },
            {
              "value": "joy",
              "label": "Joy"
            },
            {
              "value": "brutus",
              "label": "Brutus"
            },
            {
              "value": "minku",
              "label": "Minku"
            },
            {
              "value": "pinki",
              "label": "Pinki"
            }
          ],
          "default": "none"
        },
        {
          "type": "select",
          "id": "behavior",
          "label": "Motion",
          "options": [
            {
              "value": "fall",
              "label": "Falls in on scroll"
            },
            {
              "value": "badge",
              "label": "Stays put (badge)"
            }
          ],
          "default": "fall"
        },
        {
          "type": "range",
          "id": "size",
          "label": "Width",
          "min": 4,
          "max": 40,
          "step": 1,
          "unit": "vw",
          "default": 24
        },
        {
          "type": "range",
          "id": "x",
          "label": "Horizontal position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 50
        },
        {
          "type": "range",
          "id": "y",
          "label": "Vertical position",
          "min": 0,
          "max": 100,
          "step": 1,
          "unit": "%",
          "default": 55
        },
        {
          "type": "range",
          "id": "depth",
          "label": "Layer (higher sits in front)",
          "min": 1,
          "max": 30,
          "step": 1,
          "default": 10
        }
      ]
    },
    {
      "type": "accent",
      "name": "Floating accent",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Label text",
          "info": "Leave blank to show a plain shape instead."
        },
        {
          "type": "color",
          "id": "text_color",
          "label": "Text colour",
          "default": "#FFF6EB"
        },
        {
          "type": "range",
          "id": "rotate",
          "label": "Tilt",
          "min": -20,
          "max": 20,
          "step": 1,
          "unit": "deg",
          "default": -6
        },
        {
          "type": "select",
          "id": "shape",
          "label": "Shape",
          "options": [
            {
              "value": "circle",
              "label": "Circle"
            },
            {
              "value": "star",
              "label": "Star"
