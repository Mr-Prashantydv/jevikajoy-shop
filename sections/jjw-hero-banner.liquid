{%- comment -%}
  JJW hero banner — mirrors Partake's `image_banner` section.
  Emits the same class names their CSS targets (.banner__media, .banner__box,
  .banner__heading.hxxl, .banner__buttons, .button--wrapper) so the rules in
  assets/jjw-partake.css apply without duplication.
  Reference values: docs/clone/DESIGN-SYSTEM.md §9 row 2.
{%- endcomment -%}

{%- liquid
  assign img = section.settings.image
  assign align = section.settings.content_align
-%}

{%- style -%}
  #JJWHero-{{ section.id }} .homepage-hero--wrapper {
    position: relative;
    display: flex;
    background-color: var(--jjw-cream);
  }

  #JJWHero-{{ section.id }} .banner__media {
    position: absolute;
    inset: 0;
    overflow: hidden;
  }

  #JJWHero-{{ section.id }} .banner__media img {
    width: 100%;
    height: 100%;
    object-fit: {{ section.settings.image_fit }};
    object-position: {{ section.settings.focal_point }};
    display: block;
  }

  {%- if section.settings.height == 'viewport' -%}
    #JJWHero-{{ section.id }} .homepage-hero--wrapper { height: 100vh; }
    @media screen and (max-width: 749px) {
      #JJWHero-{{ section.id }} .homepage-hero--wrapper { height: 96vh; }
    }
  {%- else -%}
    #JJWHero-{{ section.id }} .homepage-hero--wrapper { aspect-ratio: 16 / 9; }
    @media screen and (max-width: 749px) {
      #JJWHero-{{ section.id }} .homepage-hero--wrapper {
        aspect-ratio: auto;
        min-height: 78vh;
      }
    }
  {%- endif -%}

  {%- if section.settings.show_scrim -%}
    #JJWHero-{{ section.id }} .banner__media::after {
      content: '';
      position: absolute;
      inset: 0;
      pointer-events: none;
      background: linear-gradient(
        {% if align == 'right' %}270deg{% elsif align == 'center' %}0deg{% else %}90deg{% endif %},
        rgba(255, 246, 235, {{ section.settings.scrim_strength | divided_by: 100.0 }}) 0%,
        rgba(255, 246, 235, {{ section.settings.scrim_strength | divided_by: 200.0 }}) 45%,
        rgba(255, 246, 235, 0) 72%
      );
    }
  {%- endif -%}

  #JJWHero-{{ section.id }} .banner__content {
    position: relative;
    z-index: 2;
    display: flex;
    align-items: center;
    width: 100%;
    padding: 10px;
    justify-content: {% if align == 'center' %}center{% elsif align == 'right' %}flex-end{% else %}flex-start{% endif %};
  }

  #JJWHero-{{ section.id }} .banner__box {
    max-width: 670px;
    padding-block: 40px;
    text-align: {% if align == 'center' %}center{% elsif align == 'right' %}right{% else %}left{% endif %};
  }

  #JJWHero-{{ section.id }} .banner__heading {
    color: {{ section.settings.heading_color }};
    {% if section.settings.show_text_shadow %}
      text-shadow: 4px 4px 0 {{ section.settings.text_shadow_color }};
    {% endif %}
  }

  #JJWHero-{{ section.id }} .banner__text {
    font-family: var(--jjw-font-sans);
    font-size: calc(1vw + 1rem);
    line-height: 1.3;
    max-width: 60rem;
    margin-top: 1.5rem;
    color: {{ section.settings.heading_color }};
    text-wrap: pretty;
  }

  @media screen and (max-width: 749px) {
    #JJWHero-{{ section.id }} .banner__box { max-width: 100%; }
    #JJWHero-{{ section.id }} .banner__text { font-size: 1.75rem; line-height: 1.2; }
  }
{%- endstyle -%}

<section id="JJWHero-{{ section.id }}" class="banner-section">
  <div class="homepage-hero--wrapper banner banner--content-align-{{ align }} banner--adapt">
    <div class="banner__media media scroll-trigger animate--fade-in">
      {%- if img != blank -%}
        <img
          src="{{ img | image_url: width: 2400 }}"
          srcset="{{ img | image_url: width: 750 }} 750w,
                  {{ img | image_url: width: 1100 }} 1100w,
                  {{ img | image_url: width: 1500 }} 1500w,
                  {{ img | image_url: width: 2400 }} 2400w"
          sizes="100vw"
          alt="{{ img.alt | escape }}"
          width="{{ img.width }}"
          height="{{ img.height }}"
          fetchpriority="high"
        >
      {%- else -%}
        <img
          src="{{ 'jjw-hero.png' | asset_url }}"
          alt="{{ section.settings.heading | strip_html | escape }}"
          width="1672"
          height="941"
          fetchpriority="high"
        >
      {%- endif -%}
    </div>

    <div class="banner__content page-width scroll-trigger animate--slide-in">
      <div class="banner__box content-container">
        {%- if section.settings.heading != blank -%}
          <h2 class="banner__heading inline-richtext hxxl">{{ section.settings.heading }}</h2>
        {%- endif -%}

        {%- if section.settings.text != blank -%}
          <div class="banner__text rte body">{{ section.settings.text }}</div>
        {%- endif -%}

        {%- if section.settings.button_label != blank -%}
          <div class="banner__buttons">
            <div class="button--wrapper">
              <div class="button--bg"></div>
              <a
                href="{{ section.settings.button_link | default: '#' }}"
                class="button button--{{ section.settings.button_style }}"
              >{{ section.settings.button_label | escape }}</a>
            </div>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "JJW hero banner",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Hero image",
      "info": "Falls back to assets/jjw-hero.png. Ideal ratio 16:9." },
    { "type": "select", "id": "height", "label": "Height",
      "options": [
        { "value": "natural", "label": "Natural (16:9) — protects the artwork" },
        { "value": "viewport", "label": "Full viewport — matches the reference, may crop" }
      ],
      "default": "natural" },
    { "type": "select", "id": "image_fit", "label": "Image fit",
      "options": [
        { "value": "cover", "label": "Cover" },
        { "value": "contain", "label": "Contain" }
      ],
      "default": "cover" },
    { "type": "text", "id": "focal_point", "label": "Focal point",
      "default": "center center",
      "info": "CSS object-position, e.g. 'center center' or '70% center'." },

    { "type": "header", "content": "Content" },
    { "type": "inline_richtext", "id": "heading", "label": "Heading",
      "default": "Tees Every Kid Can Call Their Own" },
    { "type": "richtext", "id": "text", "label": "Body" },
    { "type": "select", "id": "content_align", "label": "Content position",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "left" },
    { "type": "color", "id": "heading_color", "label": "Heading colour", "default": "#1A2F5E" },
    { "type": "checkbox", "id": "show_text_shadow", "label": "Hard text shadow", "default": true },
    { "type": "color", "id": "text_shadow_color", "label": "Text shadow colour", "default": "#D3F3DE" },

    { "type": "header", "content": "Legibility" },
    { "type": "checkbox", "id": "show_scrim", "label": "Soften image behind text", "default": true },
    { "type": "range", "id": "scrim_strength", "label": "Scrim strength",
      "min": 0, "max": 100, "step": 5, "unit": "%", "default": 70 },

    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Label", "default": "Shop the Squad" },
    { "type": "url", "id": "button_link", "label": "Link" },
    { "type": "select", "id": "button_style", "label": "Style",
      "options": [
        { "value": "primary", "label": "Primary (pink)" },
        { "value": "secondary", "label": "Secondary (navy)" }
      ],
      "default": "primary" }
  ],
  "presets": [{ "name": "JJW hero banner" }]
}
{% endschema %}
