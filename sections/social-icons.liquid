      </svg>
    </a>
  {%- endif -%}

  {%- if tiktok_url != blank -%}
    <a
      class="social-icons__link"
      href="{{ tiktok_url }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="TikTok"
    >
      <svg viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
        <path d="M12.53.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.02-.5-.03-1-.01-1.49.18-1.9 1.12-3.72 2.58-4.96 1.66-1.44 3.98-2.13 6.15-1.72.02 1.48-.04 2.96-.04 4.44-.99-.32-2.15-.23-3.02.37-.63.41-1.11 1.04-1.36 1.75-.21.51-.15 1.07-.14 1.61.24 1.64 1.82 3.02 3.5 2.87 1.12-.01 2.19-.66 2.77-1.61.19-.33.4-.67.41-1.06.1-1.79.06-3.57.07-5.36.01-4.03-.01-8.05.02-12.07Z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if youtube_url != blank -%}
    <a
      class="social-icons__link"
      href="{{ youtube_url }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="YouTube"
    >
      <svg viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
        <path d="M23.5 6.19a3.02 3.02 0 0 0-2.12-2.14C19.5 3.55 12 3.55 12 3.55s-7.5 0-9.38.5A3.02 3.02 0 0 0 .5 6.19C0 8.07 0 12 0 12s0 3.93.5 5.81a3.02 3.02 0 0 0 2.12 2.14c1.88.5 9.38.5 9.38.5s7.5 0 9.38-.5a3.02 3.02 0 0 0 2.12-2.14C24 15.93 24 12 24 12s0-3.93-.5-5.81ZM9.55 15.57V8.43L15.82 12l-6.27 3.57Z"/>
      </svg>
    </a>
  {%- endif -%}

  {%- if facebook_url != blank -%}
    <a
      class="social-icons__link"
      href="{{ facebook_url }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Facebook"
    >
      <svg viewBox="0 0 24 24" role="presentation" focusable="false" aria-hidden="true">
        <path d="M13.5 21v-8h2.7l.4-3.1h-3.1V7.9c0-.9.25-1.5 1.55-1.5h1.65V3.63c-.29-.04-1.28-.13-2.44-.13-2.42 0-4.08 1.48-4.08 4.2V9.9H7.4V13h2.78v8h3.32Z"/>
      </svg>
    </a>
  {%- endif -%}
{%- endcapture -%}

{%- if social_links != blank -%}
  <section id="SocialIcons-{{ section.id }}" class="social-icons">
    <div class="social-icons__inner">
      <div class="page-width social-icons__list scroll-trigger animate--slide-in">
        {{ social_links }}
      </div>
    </div>
  </section>
{%- endif -%}

{% schema %}
{
  "name": "Social icons",
  "settings": [
    {
      "type": "paragraph",
      "content": "Links come from Theme settings → Social media. Networks left blank are hidden."
    }
  ],
  "presets": [
    {
      "name": "Social icons"
    }
  ]
}
{% endschema %}
