{%- comment -%}
  Social icons — ported from the React SocialIcons export
  (src/components/site/social-marquee.tsx). Centred row of circular social
  links on the cream canvas. URLs come from the theme settings so the merchant
  maintains them in one place; a network with no URL is simply not rendered.

  The SocialMarquee export from the same React file is a separate section.
{%- endcomment -%}

{%- style -%}
  #SocialIcons-{{ section.id }} {
    background: var(--cream);
  }

  #SocialIcons-{{ section.id }} .social-icons__inner {
    padding-block: 3.6rem;
  }

  #SocialIcons-{{ section.id }} .social-icons__list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1rem;
  }

  #SocialIcons-{{ section.id }} .social-icons__link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 8rem;
    height: 8rem;
    border-radius: 50%;
    background: var(--ink);
    color: var(--cream);
    transition: transform 0.2s var(--ease), background-color 0.2s var(--ease);
  }

  #SocialIcons-{{ section.id }} .social-icons__link:hover {
    transform: scale(1.1);
    background: var(--pink);
  }

  #SocialIcons-{{ section.id }} .social-icons__link svg {
    display: block;
    width: 4rem;
    height: 4rem;
    fill: currentColor;
  }

  @media screen and (max-width: 749px) {
    #SocialIcons-{{ section.id }} .social-icons__inner {
      padding-block: 2.7rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #SocialIcons-{{ section.id }} .social-icons__link {
      transition: none;
    }

    #SocialIcons-{{ section.id }} .social-icons__link:hover {
      transform: none;
    }
  }
{%- endstyle -%}

{%- comment -%} In the editor, fall back to a dead link so the row stays visible. {%- endcomment -%}
{%- assign fallback = '' -%}
{%- if request.design_mode -%}
  {%- assign fallback = '#' -%}
{%- endif -%}

{%- assign instagram_url = settings.social_instagram_link | default: fallback -%}
{%- assign tiktok_url = settings.social_tiktok_link | default: fallback -%}
{%- assign youtube_url = settings.social_youtube_link | default: fallback -%}
{%- assign facebook_url = settings.social_facebook_link | default: fallback -%}

{%- capture social_links -%}
  {%- if instagram_url != blank -%}
    <a
      class="social-icons__link"
      href="{{ instagram_url }}"
      target="_blank"
      rel="noopener noreferrer"
      aria-label="Instagram"
