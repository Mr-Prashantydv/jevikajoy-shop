{%- liquid
  assign character = nil
  for block in section.blocks
    if block.settings.handle == collection.handle
      assign character = block
      break
    endif
  endfor
  assign main_id = section.id | replace: '__character_intro', '__main'
-%}
{%- if character != nil -%}
{%- style -%}
  #CharacterIntro-{{ section.id }} { background: var(--cream); padding: 2.4rem 0 0; color: var(--ink); }
  #CharacterIntro-{{ section.id }} .ci__scene { display:grid; grid-template-columns: 1.2fr 1fr; align-items:center; max-width:120rem; margin:auto; min-height:32rem; gap:4rem; position:relative; }
  #CharacterIntro-{{ section.id }} .ci__copy { padding:2.4rem 0 3.2rem; position:relative; z-index:1; }
  #CharacterIntro-{{ section.id }} .ci__eyebrow { display:flex; align-items:center; gap:1rem; font-size:1.3rem; font-weight:700; letter-spacing:0.12em; text-transform:uppercase; margin:0 0 1.2rem; }
  #CharacterIntro-{{ section.id }} .ci__eyebrow::before { content:''; width:3.2rem; height:0.4rem; background:var(--gold); border-radius:1rem; }
  #CharacterIntro-{{ section.id }} h1 { font-family:var(--font-heading); font-weight:800; color:var(--blue); font-size:clamp(4rem,4vw,5.6rem); line-height:1; letter-spacing:-0.02em; margin:0; max-width:16ch; }
  #CharacterIntro-{{ section.id }} .ci__description { font-size:1.7rem; line-height:1.6; max-width:52ch; margin:1.6rem 0; }
  #CharacterIntro-{{ section.id }} .ci__description p { margin:0; }
  #CharacterIntro-{{ section.id }} .ci__shop { display:inline-flex; align-items:center; justify-content:space-between; gap:3.2rem; min-height:4.8rem; padding:1rem 2rem; background:var(--gold); color:var(--ink); border:1px solid var(--ink); border-radius:1rem; box-shadow:3px 3px 0 var(--ink); font-weight:700; font-size:1.5rem; }
  #CharacterIntro-{{ section.id }} .ci__shop:focus-visible { outline:3px solid var(--blue); outline-offset:5px; }
  #CharacterIntro-{{ section.id }} .ci__art { height:32rem; position:relative; display:grid; place-items:center; align-self:end; isolation:isolate; }
  #CharacterIntro-{{ section.id }} .ci__art::before { content:''; position:absolute; width:29rem; height:26rem; bottom:0; background:var(--blue); border-radius:14rem 14rem 2rem 2rem; z-index:-2; }
  #CharacterIntro-{{ section.id }} .ci__art::after { content:''; position:absolute; width:27rem; height:25rem; bottom:1rem; border:2px dashed var(--gold); border-radius:14rem 14rem 2rem 2rem; z-index:-1; }
  #CharacterIntro-{{ section.id }} .ci__portrait { width:100%; height:32rem; min-height:0; object-fit:contain; position:absolute; inset:0; z-index:1; }
  #CharacterIntro-{{ section.id }} .ci__stamp { position:absolute; bottom:3rem; right:0; z-index:2; max-width:15rem; padding:1rem 1.4rem; background:var(--white); color:var(--ink); border:2px solid var(--ink); box-shadow:4px 4px 0 var(--gold); border-radius:0.8rem; transform:rotate(6deg); font-family:var(--font-accent); font-weight:700; font-size:1.9rem; line-height:1.15; }
  #CharacterIntro-{{ section.id }} .ci__motif { position:absolute; top:2rem; left:2rem; width:7rem; height:7rem; color:var(--gold); transform:rotate(-12deg); z-index:2; }
  #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__art { grid-column:1; grid-row:1; }
  #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__copy { grid-column:2; }
  #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__scene { grid-template-columns:0.8fr 1.2fr; }
  #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__art::before { border-radius:2rem; transform:skew(-8deg); }
  #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__art::after { border-radius:2rem; transform:skew(-8deg); }
  #CharacterIntro-{{ section.id }}[data-character='brutus'] .ci__art::before { background:var(--gold); border-radius:50% 50% 3rem 3rem; }
  #CharacterIntro-{{ section.id }}[data-character='brutus'] .ci__art::after { border-color:var(--blue); }
  #CharacterIntro-{{ section.id }}[data-character='brutus'] .ci__portrait { padding:1rem 0; }
  #CharacterIntro-{{ section.id }}[data-character='minku'] .ci__art::before { border-radius:4rem 12rem 4rem 12rem; transform:rotate(-6deg); }
  #CharacterIntro-{{ section.id }}[data-character='minku'] .ci__art::after { border-radius:4rem 12rem 4rem 12rem; transform:rotate(7deg); }
  #CharacterIntro-{{ section.id }}[data-character='minku'] .ci__stamp { transform:rotate(-6deg); right:1rem; }
  #CharacterIntro-{{ section.id }}[data-character='pinki'] .ci__art::before { border-radius:50%; width:28rem; height:28rem; }
  #CharacterIntro-{{ section.id }}[data-character='pinki'] .ci__art::after { border-radius:50%; width:30rem; height:30rem; bottom:-1rem; }
  /* Only the collection section in this alternate template is affected. */
  #MainCollection-{{ main_id }} .mc__intro { display:none; }
  #MainCollection-{{ main_id }} { scroll-margin-top:2rem; }
  @media(min-width:990px) {
    #MainCollection-{{ main_id }}[id] .mc__grid--single { grid-template-columns:minmax(0,90rem); }
    #MainCollection-{{ main_id }}[id] .mc__grid--single .mc__card a { display:grid; grid-template-columns:1fr 1fr; }
    #MainCollection-{{ main_id }}[id] .mc__grid--single .mc__info { padding:3.2rem; justify-content:center; border-top:0; border-left:4px solid var(--card-bg); }
    #MainCollection-{{ main_id }}[id] .mc__grid--single .mc__title { font-size:3.2rem; }
    #MainCollection-{{ main_id }}[id] .mc__grid--single .mc__choose { margin-top:2.4rem; }
    #MainCollection-{{ main_id }}[id] .mc__grid--single .mc__colours { margin-top:2rem; }
  }
  @media(max-width:749px) {
    #CharacterIntro-{{ section.id }} { padding-top:1.6rem; overflow:hidden; }
    #CharacterIntro-{{ section.id }} .ci__scene,
    #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__scene { grid-template-columns:minmax(0,1fr) 12rem; gap:0.8rem; min-height:26rem; }
    #CharacterIntro-{{ section.id }} .ci__copy { padding:0.8rem 0 2rem; }
    #CharacterIntro-{{ section.id }} h1 { font-size:3.6rem; }
    #CharacterIntro-{{ section.id }} .ci__eyebrow { font-size:1.05rem; letter-spacing:0.06em; gap:0.6rem; margin-bottom:1rem; }
    #CharacterIntro-{{ section.id }} .ci__eyebrow::before { width:1.6rem; }
    #CharacterIntro-{{ section.id }} .ci__description { font-size:1.4rem; line-height:1.5; margin:1.2rem 0; }
    #CharacterIntro-{{ section.id }} .ci__shop { font-size:1.3rem; gap:1.2rem; padding:0.8rem 1.2rem; min-height:4.4rem; }
    #CharacterIntro-{{ section.id }} .ci__art,
    #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__art { height:24rem; align-self:center; grid-column:2; grid-row:1; }
    #CharacterIntro-{{ section.id }}[data-character='joy'] .ci__copy { grid-column:1; }
    #CharacterIntro-{{ section.id }} .ci__art::before { width:13rem; height:18rem; bottom:2rem; }
    #CharacterIntro-{{ section.id }} .ci__art::after { width:11rem; height:16rem; bottom:3rem; }
    #CharacterIntro-{{ section.id }}[data-character='pinki'] .ci__art::before { width:14rem; height:14rem; bottom:4rem; }
    #CharacterIntro-{{ section.id }}[data-character='pinki'] .ci__art::after { width:15rem; height:15rem; bottom:3.5rem; }
    #CharacterIntro-{{ section.id }} .ci__portrait { width:100%; max-width:100%; height:23rem; inset:0; }
    #CharacterIntro-{{ section.id }} .ci__stamp { font-size:1.2rem; max-width:10rem; padding:0.6rem; bottom:0.6rem; right:0; }
    #CharacterIntro-{{ section.id }} .ci__motif { width:3.5rem; height:3.5rem; top:0; left:0; }
  }
{%- endstyle -%}
<section id="CharacterIntro-{{ section.id }}" data-character="{{ collection.handle }}">
  <div class="page-width">
    <div class="ci__scene" {{ character.shopify_attributes }}>
      <div class="ci__copy">
        <p class="ci__eyebrow">{{ character.settings.eyebrow | escape }}</p>
        <h1>{{ character.settings.heading | escape }}</h1>
        <div class="ci__description">{{ character.settings.description }}</div>
        <a class="ci__shop" href="#MainCollection-{{ main_id }}">{{ character.settings.cta | escape }} <span aria-hidden="true">&#8595;</span></a>
      </div>
      <div class="ci__art" aria-hidden="true">
        <svg class="ci__motif" viewBox="0 0 80 80" fill="none" stroke="currentColor" stroke-width="4" stroke-linecap="round" stroke-linejoin="round">
          {%- case collection.handle -%}
            {%- when 'joy' -%}<path d="M47 5 15 45h24l-6 30 32-43H42z"/>
            {%- when 'brutus' -%}<path d="M40 69S4 47 9 25c4-17 25-17 31-2 6-15 27-15 31 2 5 22-31 44-31 44Z"/>
            {%- when 'minku' -%}<path d="M10 67c0-40 60 5 60-35S10 4 19 26s46 3 39-11" stroke-dasharray="5 7"/>
            {%- when 'pinki' -%}<circle cx="40" cy="40" r="30"/><path d="m52 24-8 20-20 12 8-20Z M40 4v8m0 56v8M4 40h8m56 0h8"/>
            {%- else -%}<path d="m40 6 9 23 25 3-19 17 6 25-21-13-21 13 6-25L6 32l25-3Z"/>
          {%- endcase -%}
        </svg>
        {%- assign pose = 'jjw-pose-' | append: collection.handle | append: '.png' -%}
        <img class="ci__portrait" src="{{ pose | asset_url }}" width="400" height="500" alt="" fetchpriority="high">
        <span class="ci__stamp">{{ character.settings.motto | escape }}</span>
      </div>
    </div>
  </div>
</section>
<script>
(function () {
  function init() {
  // Retain the local alternate template while browsing, filtering and sorting.
  var root = document.getElementById('MainCollection-{{ main_id }}');
  if (!root) return;
  root.querySelectorAll('a[href]').forEach(function (link) {
    var url = new URL(link.href, location.href);
    if (url.origin === location.origin && url.pathname.indexOf('/collections/') === 0) {
      url.searchParams.set('view', 'character'); link.href = url.pathname + url.search + url.hash;
    }
  });
  root.querySelectorAll('form').forEach(function (form) {
    var input = document.createElement('input'); input.type = 'hidden'; input.name = 'view'; input.value = 'character'; form.appendChild(input);
  });
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', init, { once: true });
  else init();
})();
</script>
{%- endif -%}
{% schema %}
{
  "name": "Character introduction",
  "tag": "section",
  "max_blocks": 5,
  "settings": [],
  "blocks": [{
    "type": "character", "name": "Character", "settings": [
      {"type":"text","id":"handle","label":"Collection handle"},
      {"type":"text","id":"eyebrow","label":"Eyebrow"},
      {"type":"text","id":"heading","label":"Heading"},
      {"type":"richtext","id":"description","label":"Introduction"},
      {"type":"text","id":"motto","label":"Character sticker"},
      {"type":"text","id":"cta","label":"Shopping link"}
    ]
  }],
  "presets": [{"name":"Character introduction"}]
}
{% endschema %}
