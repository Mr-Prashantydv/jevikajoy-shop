{%- liquid
  assign raw_text = section.settings.marquee_text | default: 'BIS & EN71 CERTIFIED ★ 100% ORGANIC COTTON ★ NON-TOXIC INKS ★ HYPOALLERGENIC ★ AGES 4–9 ★ STORY-FIRST VALUES ★ SCREEN-FREE PLAY'
  if raw_text contains '★'
    assign marquee_items = raw_text | split: '★'
  elsif raw_text contains '|'
    assign marquee_items = raw_text | split: '|'
  else
    assign marquee_items = raw_text | split: ','
  endif
-%}

{%- style -%}
  #JJWMarqueeTicker-{{ section.id }} {
    background-color: {{ section.settings.bg_color | default: '#1A2F5E' }};
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
    width: 100%;
    overflow: hidden;
  }

  #JJWMarqueeTicker-{{ section.id }} .jjw-marquee {
    background-color: transparent;
    color: inherit;
  }

  #JJWMarqueeTicker-{{ section.id }} .jjw-marquee__item {
    color: {{ section.settings.text_color | default: '#FFFFFF' }};
  }

  #JJWMarqueeTicker-{{ section.id }} .jjw-marquee__dot {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    color: var(--jjw-gold, #F6A313);
    background: transparent;
    width: auto;
    height: auto;
    font-size: 0.75rem;
    opacity: 0.9;
    border-radius: 0;
  }
{%- endstyle -%}

<div id="JJWMarqueeTicker-{{ section.id }}" class="jjw-marquee-outer" role="region" aria-label="Brand Highlights Ticker">
  <div class="jjw-marquee">
    <div class="jjw-marquee__track">
      {%- for i in (1..2) -%}
        <div class="jjw-marquee__content-group" style="display: inline-flex; align-items: center;">
          {%- for item in marquee_items -%}
            {%- assign trimmed_item = item | strip -%}
            {%- if trimmed_item != blank -%}
              <span class="jjw-marquee__item">
                {{ trimmed_item }}
                <span class="jjw-marquee__dot" aria-hidden="true">&#9733;</span>
              </span>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "JJW Marquee Ticker",
  "tag": "section",
  "class": "section",
  "settings": [
    {
      "type": "textarea",
      "id": "marquee_text",
      "label": "Marquee Text",
      "default": "BIS & EN71 CERTIFIED ★ 100% ORGANIC COTTON ★ NON-TOXIC INKS ★ HYPOALLERGENIC ★ AGES 4–9 ★ STORY-FIRST VALUES ★ SCREEN-FREE PLAY"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#1A2F5E"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "presets": [
    {
      "name": "JJW Marquee Ticker"
    }
  ]
}
{% endschema %}
