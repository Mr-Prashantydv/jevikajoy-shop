{%- style -%}
  #RichText-{{ section.id }} {
    height: 18.3rem;
    background: var(--cream);
    overflow: visible;
  }

  #RichText-{{ section.id }} .rich-text__inner {
    padding-top: 4rem;
  }

  #RichText-{{ section.id }} .rich-text__content {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  /* --ink, not --pink: Heart Pink on cream is 2.92:1, under the 3:1 large-text floor. */
  #RichText-{{ section.id }} .rich-text__heading {
    margin-top: 2rem;
    color: var(--ink);
  }

  #RichText-{{ section.id }} .rich-text__link-wrap {
    margin-top: 2rem;
  }

  #RichText-{{ section.id }} .rich-text__link {
    display: block;
    /* Scales down on a phone so a social handle stays on one line. */
    font-size: min(2.7rem, 6.4vw);
    line-height: 1.2;
    color: var(--pink);
    transition: color 0.2s var(--ease);
  }

  #RichText-{{ section.id }} a.rich-text__link:hover {
    color: var(--blue);
  }

  @media screen and (max-width: 749px) {
    #RichText-{{ section.id }} .rich-text__inner {
      padding-top: 3rem;
    }
  }
{%- endstyle -%}

<section id="RichText-{{ section.id }}">
  <div class="rich-text__inner">
    <div class="page-width rich-text__content">
      {%- if section.settings.heading != blank -%}
        <h2
          class="hxxl rich-text__heading scroll-trigger animate--slide-in"
          style="--animation-order: 1;"
        >
          {{ section.settings.heading | escape }}
        </h2>
      {%- endif -%}

      {%- if section.settings.link_label != blank -%}
        <div class="rich-text__link-wrap scroll-trigger animate--slide-in" style="--animation-order: 2;">
          {%- if section.settings.link_url != blank -%}
            <a
              class="accent-caps rich-text__link"
              href="{{ section.settings.link_url }}"
              {% if section.settings.open_in_new_tab %}
                target="_blank"
                rel="noopener noreferrer"
              {% endif %}
            >
              {{ section.settings.link_label | escape }}
            </a>
          {%- else -%}
            <span class="accent-caps rich-text__link">{{ section.settings.link_label | escape }}</span>
          {%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Rich text",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Made for Play, Built to Last"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link text",
      "default": "Follow Us @JevikaAndJoy"
    },
    {
      "type": "url",
      "id": "link_url",
      "label": "Link"
    },
    {
      "type": "checkbox",
      "id": "open_in_new_tab",
      "label": "Open link in a new tab",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Rich text"
    }
  ]
}
{% endschema %}
