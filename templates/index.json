    "focus_carousel": {
      "type": "focus-carousel",
      "blocks": {
        "r1": {
          "type": "review",
          "settings": {
            "quote": "The cotton is genuinely soft and the print has not cracked after a dozen washes. She asks for it every week.",
            "author": "— Priya M.",
            "rating": 5,
            "color_bg": "ink",
            "color_shadow": "blue",
            "color_text": "cream"
          }
        },
        "r2": {
          "type": "review",
          "settings": {
            "quote": "Sizing runs true and the colours stayed bright. I ordered two more for my nephews the same month.",
            "author": "— Rahul K.",
            "rating": 5,
            "color_bg": "pink",
            "color_shadow": "ink",
            "color_text": "cream"
          }
        },
        "r3": {
          "type": "review",
          "settings": {
            "quote": "Finally tees my son can wear all day without fussing. The characters are his, not some cartoon he half recognises.",
            "author": "— Ananya R.",
            "rating": 5,
            "color_bg": "blue",
            "color_shadow": "ink",
            "color_text": "cream"
          }
        },
        "r4": {
          "type": "review",
          "settings": {
            "quote": "Bought one for each twin. Months on they still look new, and the paw print is the first thing their friends notice.",
            "author": "— Sneha D.",
            "rating": 5,
            "color_bg": "green",
            "color_shadow": "ink",
            "color_text": "cream"
          }
        },
        "r5": {
          "type": "review",
          "settings": {
            "quote": "Ordered on a whim before a birthday and it arrived early. The fabric feels far better than the price suggests.",
            "author": "— Meera T.",
            "rating": 5,
            "color_bg": "gold",
            "color_shadow": "ink",
            "color_text": "cream"
          }
        }
