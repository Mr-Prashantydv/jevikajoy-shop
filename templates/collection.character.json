            "cta": "Shop Joy"
          }
        },
        "brutus": {
          "type": "character",
          "settings": {
            "handle": "brutus",
            "heading": "Good days. Great company.",
            "description": "<p>Meet Brutus, the boxer dog always by Joy’s side. For park mornings, long walks and adventures shared with a best friend.</p>",
            "motto": "Better together",
            "cta": "Shop Brutus"
          }
        },
