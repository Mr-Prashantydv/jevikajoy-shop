      "blocks": {
        "jevika": {
          "type": "character",
          "settings": {
            "handle": "jevika",
            "eyebrow": "Meet Jevika",
            "heading": "A little wonder. A big adventure.",
            "description": "<p>Red bows, bright questions and a day full of possibilities. Follow Jevika from the school gate to the next little discovery.</p>",
            "motto": "Wonder comes along",
            "cta": "Shop Jevika"
          }
        },
        "joy": {
          "type": "character",
          "settings": {
            "handle": "joy",
            "eyebrow": "Meet Joy",
            "heading": "Big ideas. Everyday adventures.",
            "description": "<p>Always halfway through the next idea. Join Joy for building, street games and the adventures that happen between school and dinner.</p>",
            "motto": "Ready. Set. Create.",
            "cta": "Shop Joy"
          }
        },
        "brutus": {
          "type": "character",
          "settings": {
            "handle": "brutus",
            "eyebrow": "Meet Brutus",
            "heading": "Better with a best friend.",
            "description": "<p>Brutus is the boxer dog by Joy’s side. For park mornings, long walks and the friend who makes every adventure better.</p>",
            "motto": "Adventure buddies",
            "cta": "Shop Brutus"
          }
        },
        "minku": {
          "type": "character",
          "settings": {
            "handle": "minku",
            "eyebrow": "Meet Minku",
            "heading": "A little monkey business.",
            "description": "<p>Meet Minku, the monkey with a playful streak. For monkey bars, big giggles and days that take a wonderfully unexpected turn.</p>",
            "motto": "Wild at heart",
            "cta": "Shop Minku"
          }
        },
        "pinki": {
          "type": "character",
          "settings": {
            "handle": "pinki",
            "eyebrow": "Meet Pinki",
            "heading": "Small questions. Big discoveries.",
            "description": "<p>Round glasses. A curious squirrel. Pinki asks why, then asks again. Come along for pocketfuls of pebbles and one more discovery.</p>",
            "motto": "Stay curious",
            "cta": "Shop Pinki"
          }
        }
