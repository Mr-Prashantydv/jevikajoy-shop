<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="theme-color" content="{{ settings.color_canvas }}">
    <link rel="canonical" href="{{ canonical_url }}">

    {%- if settings.favicon != blank -%}
      <link rel="icon" type="image/png" href="{{ settings.favicon | image_url: width: 32, height: 32 }}">
    {%- else -%}
      <link rel="icon" type="image/png" href="{{ 'favicon-32.png' | asset_url }}">
    {%- endif -%}
    <link rel="apple-touch-icon" href="{{ 'apple-touch-icon.png' | asset_url }}">

    <title>
      {{ page_title }}
      {%- if current_tags %} &ndash; {{ 'general.meta.tags' | t: tags: current_tags | join: ', ' }}{% endif -%}
      {%- if current_page != 1 %} &ndash; {{ 'general.meta.page' | t: page: current_page }}{% endif -%}
      {%- comment -%}
        shop.name is stored HTML-escaped (`Jevika &amp; Joy&#39;s World`) but page_title
        arrives raw, so a direct `contains` never matches and the name gets appended twice
        on the homepage. escape_once normalises page_title into the same encoding and is
        idempotent, so it is safe whichever side Shopify hands back escaped.
      {%- endcomment -%}
      {%- assign page_title_esc = page_title | escape_once -%}
      {%- unless page_title_esc contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
    </title>

    {%- if page_description -%}
      <meta name="description" content="{{ page_description | escape }}">
    {%- endif -%}

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

    {{ content_for_header }}

    {{ 'theme.css' | asset_url | stylesheet_tag }}

    {%- comment -%}
      Merchant-editable tokens. Everything downstream reads these, so a colour
      change in the theme editor propagates without touching any section.
    {%- endcomment -%}
    <style>
      :root {
        --cream: {{ settings.color_canvas }};
        --ink: {{ settings.color_ink }};
        --body-ink: {{ settings.color_body | default: '#333333' }};
        --gold: {{ settings.color_action | default: '#F6A313' }};
        --heading: {{ settings.color_heading }};
        --ink-soft: {{ settings.color_ink | color_modify: 'alpha', 0.75 }};
        --pink: {{ settings.color_accent }};
        --blue: {{ settings.color_secondary }};
        --yellow: {{ settings.color_highlight }};
      }
    </style>

    <script src="{{ 'theme.js' | asset_url }}" defer></script>
  </head>

  <body class="template--{{ template.name | handle }}">
    <a class="visually-hidden skip-link" href="#MainContent">{{ 'accessibility.skip_to_text' | t }}</a>

    {%- comment -%}
      The blob clip path. Defined once here so every section can reference it
      via clip-path: url(#jjw-blob) without redeclaring the geometry.
    {%- endcomment -%}
    <svg width="0" height="0" style="position:absolute" aria-hidden="true" focusable="false">
      <defs>
        <clipPath id="jjw-blob" clipPathUnits="objectBoundingBox">
          <path
            d="M276.099 61.423L10.521 64.37C4.734 64.434 0 60.582 0 55.807V8.56508C0 3.78408 4.74299 -0.0710076 10.537 0.000992371L276.115 3.27602C281.787 3.34602 286.341 7.15898 286.341 11.84V52.859C286.341 57.544 281.778 61.359 276.099 61.423Z"
            transform="scale(0.0034843206,0.015384615)"
          />
        </clipPath>
      </defs>
    </svg>

    {% sections 'header-group' %}

    <main id="MainContent" role="main" tabindex="-1">
      {{ content_for_layout }}
    </main>

    {% sections 'footer-group' %}

    {%- comment -%}
      Rendered here rather than inside a section group so it exists on every
      template and stays addressable as `cart-drawer` by the Section Rendering
      API — which is how /cart/add.js and /cart/change.js hand back freshly
      rendered line items instead of the drawer rebuilding them in JavaScript.
    {%- endcomment -%}
    {% section 'cart-drawer' %}
  </body>
</html>
